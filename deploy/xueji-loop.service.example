[Unit]
Description=Xueji Loop Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/xueji-loop
EnvironmentFile=/etc/xueji-loop.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -B /opt/xueji-loop/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
