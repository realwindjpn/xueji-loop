<!doctype html>
<html lang="zh-CN">
<head>
<!-- xueji-fx-engine v7 · 灯下书卷 预览模式 + 装饰 + 动效 -->
<script>
/* ============================================================
   学记 · 灯下书卷  v7 — fx-engine.js
   - PREVIEW_MODE：拦截 fetch 返回 503 + 占位数据
   - 装饰层：自动注入 .fx-bg（灯晕 + 灯尘 + 远光渐变）
   - v7 新增：真实台灯组件（拉绳交互 + 熄灯态 + localStorage 持久化）
   - v7 新增：桌面端光标追光 + 主按钮磁吸
   - v7 新增：标题字符渐显（.title-letters）
   - 动效：reveal / count-up / ripple / tilt / preview-badge
   - 首屏低密度：buildQuickCarousel 注入横向滑动卡片
   - 全部带 prefers-reduced-motion 降级
   ============================================================ */

(function () {
  "use strict";
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const isMobile = /Mobi|Android|iPhone|iPad/i.test(navigator.userAgent);
  const isWeChat = /MicroMessenger/i.test(navigator.userAgent || "");

  /* ===========================================================
     0. 工具：占位数据
     =========================================================== */
  const previewFlag = new URLSearchParams(location.search).get("preview");
  const previewOn = previewFlag !== "0" && localStorage.getItem("xueji_preview_mode") !== "0";
  if (previewOn) localStorage.setItem("xueji_preview_mode", "1");

  const placeholder = {
    ok: (data) => ({ ok: true, status: 200, json: async () => data, text: async () => JSON.stringify(data) }),
    fail: (msg, code = 503) => ({
      ok: false, status: code,
      json: async () => ({ error: msg, detail: msg }),
      text: async () => JSON.stringify({ error: msg })
    })
  };

  function pickApiMock(url, method) {
    if (!previewOn) return null;
    const m = String(url || "");
    const path = m.replace(/^https?:\/\/[^/]+/, "").replace(/^\/xueji/, "");
    // 仅匹配后端 API 入口：/api/* 和 /xueji/api/* 以及显式的 /xueji/health
    const isApi = /\/api\//.test(path) || /\/xueji\/health$/.test(m) || /\/xueji\/api\//.test(m);
    if (!isApi) return null;

    // 健康检查（兼容 /api/health 和 /xueji/health）
    if (/health|ping|status/.test(path)) return placeholder.ok({ status: "ok", mode: "preview" });

    // 学生端
    if (/\/api\/student-access\/[^/]+\/today$/.test(path) && method === "GET") {
      return placeholder.ok(studentTodayMock());
    }
    if (/\/api\/student-access\/[^/]+\/voice-practice\/tts$/.test(path)) {
      return placeholder.ok({ audio_url: "", message: "预览模式：用浏览器朗读" });
    }
    if (/\/api\/student-access\/[^/]+\/voice-practice\/submissions$/.test(path)) {
      const score = 70 + Math.floor(Math.random() * 25);
      return placeholder.ok({ score, feedback: "预览模式评分：完成度不错，多读两遍更稳。" });
    }
    if (/\/api\/students\/login$/.test(path) && method === "POST") {
      return placeholder.ok({ token: "preview-student-token", account: { phone: "13800000000" } });
    }
    if (/\/api\/students\/logout$/.test(path)) {
      return placeholder.ok({ ok: true });
    }

    // 家长端
    if (/\/api\/parents\/login$/.test(path) && method === "POST") {
      return placeholder.ok({ token: "preview-parent-token", parent: { phone: "13800000000", nickname: "预览家长" } });
    }
    if (/\/api\/parents\/register$/.test(path) && method === "POST") {
      return placeholder.ok({ token: "preview-parent-token", parent: { phone: "13800000000", nickname: "预览家长" } });
    }
    if (/\/api\/parents\/me$/.test(path)) {
      return placeholder.ok({ parent: { phone: "13800000000", nickname: "预览家长" }, students: parentStudentsMock() });
    }
    if (/\/api\/parents\/intake$/.test(path) && method === "POST") {
      return placeholder.ok({ student: { id: 1, display_name: "预览同学", student_code: "PREVIEW-001" } });
    }
    if (/\/api\/parents\/logout$/.test(path)) {
      return placeholder.ok({ ok: true });
    }
    if (/plan$/.test(path) && method === "GET") {
      return placeholder.ok(planMock());
    }
    if (/plan$/.test(path) && method === "POST") {
      return placeholder.ok({ status: "queued", job_id: "preview-job-" + Date.now() });
    }
    if (/cards$/.test(path) && method === "GET") {
      return placeholder.ok({ docx_url: "https://example.com/preview.docx", updated_at: "2026-07-28" });
    }
    if (/cards$/.test(path) && method === "POST") {
      return placeholder.ok({ status: "queued", job_id: "preview-cards-" + Date.now() });
    }
    if (/voice-practice$/.test(path) && method === "GET") {
      return placeholder.ok({ items: voiceItemsMock() });
    }
    if (/feedbacks$/.test(path) && method === "POST") {
      return placeholder.ok({ status: "saved", feedback_id: "preview-fb-" + Date.now() });
    }
    if (/feedback-ai$/.test(path) && method === "POST") {
      return placeholder.ok({ status: "queued", job_id: "preview-ai-" + Date.now() });
    }
    if (/referrals$/.test(path)) {
      return placeholder.ok({ code: "PREVIEW-CODE", total_rewards: 0, items: [] });
    }

    // 后台 / tool-api
    if (/parents\/list$/.test(path)) {
      return placeholder.ok({ items: adminParentsMock() });
    }
    if (/students\/list$/.test(path)) {
      return placeholder.ok({ items: adminStudentsMock() });
    }
    if (/actions\/list$/.test(path)) {
      return placeholder.ok({ items: [] });
    }
    if (/ai-jobs\/list$/.test(path)) {
      return placeholder.ok({ items: [] });
    }
    if (/voice-samples$/.test(path)) {
      return placeholder.ok({ items: [] });
    }
    if (/knowledge-points$/.test(path)) {
      return placeholder.ok({ items: [] });
    }
    if (/knowledge-resources$/.test(path)) {
      return placeholder.ok({ items: [] });
    }
    if (/exam-patterns$/.test(path)) {
      return placeholder.ok({ items: [] });
    }
    if (/model-configs$/.test(path)) {
      return placeholder.ok({ items: [] });
    }
    if (/entitlements$/.test(path)) {
      return placeholder.ok({ items: [] });
    }
    if (/scope-index$/.test(path)) {
      return placeholder.ok({ items: [] });
    }
    if (/coverage$/.test(path)) {
      return placeholder.ok({ items: [] });
    }
    if (/collection-tasks$/.test(path)) {
      return placeholder.ok({ items: [] });
    }
    if (/collection-task-records$/.test(path)) {
      return placeholder.ok({ items: [] });
    }
    if (/student-detail$/.test(path) && method === "GET") {
      return placeholder.ok({ student: adminStudentsMock()[0], feedbacks: [], plans: [] });
    }
    return placeholder.fail("预览模式：该接口无占位数据", 503);
  }

  function studentTodayMock() {
    return {
      student: { display_name: "预览同学", grade_region: "初一 · 北京", goal: "期末基础抢分" },
      date: "2026-07-28",
      guide: { steps: ["英语跟读", "记忆故事", "知识卡", "往日回顾", "今日打卡"] },
      voice: {
        items: [
          { target_text: "Good morning, my friend.", target_meaning: "早上好，我的朋友。", scenario: "日常问候" },
          { target_text: "I finished my homework on time.", target_meaning: "我按时完成了作业。", scenario: "日常表达" },
          { target_text: "The weather is wonderful today.", target_meaning: "今天天气真好。", scenario: "天气描述" }
        ]
      },
      assessment: { quota: { limit: 5, remaining: 5 } },
      knowledge: {
        memory_story: "今天有一条新的记忆故事：一只小猫在灯下读完了整本书。重复一遍，关键词会留在脑海里。",
        cards: [
          { tag: "语文·古诗", q: "「床前明月光」的下一句？", a: "疑是地上霜。" },
          { tag: "数学·单位", q: "1 小时等于多少分钟？", a: "60 分钟。" },
          { tag: "英语·词汇", q: "\"book\" 的复数？", a: "books" }
        ],
        review_cards: [
          { tag: "复习 D1", q: "昨天记过的古诗第二句？", a: "疑是地上霜。" }
        ],
        history_days: [],
        current_day_index: 0,
        adjustment_note: "按 D1/D3/D7 间隔复习，优先处理★卡。"
      },
      account: { phone: "13800000000" }
    };
  }

  function parentStudentsMock() {
    return [
      { id: 1, display_name: "预览同学", student_code: "PREVIEW-001", grade_region: "初一 · 北京", goal: "期末基础抢分", current_level: "中等", execution_mode: "标准", student_account_phone: "13800000001" }
    ];
  }

  function planMock() {
    return {
      plan: {
        student_name: "预览同学",
        summary: "本周按 5 科路径排：语文 1 + 数学 1 + 英语 2 + 历史 1 + 道法 1，每天 6 格小步。",
        subjects: [
          { name: "语文", sessions: 1, focus: "古诗 + 字词" },
          { name: "数学", sessions: 1, focus: "方程基础" },
          { name: "英语", sessions: 2, focus: "跟读 + 词汇" },
          { name: "历史", sessions: 1, focus: "近代史脉络" },
          { name: "道法", sessions: 1, focus: "时政 + 答题方法" }
        ],
        weekly_pace: "5 天 / 周，每天 15-25 分钟"
      },
      versions: [
        { version_code: "V1", published_at: "2026-07-21", status: "published" }
      ]
    };
  }

  function voiceItemsMock() {
    return [
      { id: 1, target_text: "Open your book, please.", target_meaning: "请打开你的书。", scenario: "课堂指令" },
      { id: 2, target_text: "I have a question.", target_meaning: "我有一个问题。", scenario: "主动发言" }
    ];
  }

  function adminParentsMock() {
    return [
      { id: 1, phone: "13800000000", nickname: "预览家长", students_count: 1, package: "试用 7 天" }
    ];
  }

  function adminStudentsMock() {
    return [
      { id: 1, display_name: "预览同学", student_code: "PREVIEW-001", grade_region: "初一 · 北京", goal: "期末基础抢分", parent_phone: "13800000000", status: "在读" }
    ];
  }

  /* ===========================================================
     1. 拦截 fetch
     =========================================================== */
  if (previewOn && !window.__xuejiFetchPatched) {
    window.__xuejiFetchPatched = true;
    const origFetch = window.fetch.bind(window);
    window.fetch = async function (input, init) {
      let url = typeof input === "string" ? input : (input && input.url) || "";
      const method = (init && init.method) || (input && input.method) || "GET";
      const mock = pickApiMock(url, method);
      if (mock) {
        // 模拟 80-180ms 网络延迟
        await new Promise(r => setTimeout(r, 80 + Math.random() * 100));
        return mock;
      }
      return origFetch(input, init);
    };
  }

  /* ===========================================================
     2. 注入装饰层
     =========================================================== */
  function injectFxBg() {
    if (document.querySelector(".fx-bg")) return;
    const bg = document.createElement("div");
    bg.className = "fx-bg";
    bg.setAttribute("aria-hidden", "true");
    // 12 颗灯尘
    for (let i = 0; i < 12; i++) {
      const ember = document.createElement("span");
      ember.className = "ember";
      bg.appendChild(ember);
    }
    // 装饰层永远垫底
    const body = document.body;
    if (body.firstChild) body.insertBefore(bg, body.firstChild);
    else body.appendChild(bg);
  }

  /* ===========================================================
   * 2.5 真实台灯组件（v7 关键）
   * - 在右上角注入 <aside class="xueji-lamp"> 包含内联 SVG
   * - 点击拉绳 → 切换 body.lamp-off + 拉绳摆动 + localStorage 持久化
   * - 渐变通过 SVG <defs> 内联，避免外部资源
   * =========================================================== */
  function lampSvgMarkup() {
    return `
<svg viewBox="0 0 100 110" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="lampShadeGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%"   stop-color="#ead9b4" />
      <stop offset="55%"  stop-color="#cfa86b" />
      <stop offset="100%" stop-color="#8a6a3a" />
    </linearGradient>
    <linearGradient id="lampBaseGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%"   stop-color="#5a4426" />
      <stop offset="100%" stop-color="#2a1f10" />
    </linearGradient>
    <linearGradient id="lampConeGrad" x1="0.5" y1="0" x2="0.5" y2="1">
      <stop offset="0%"   stop-color="rgba(234,217,180,0.55)" />
      <stop offset="60%"  stop-color="rgba(207,168,107,0.18)" />
      <stop offset="100%" stop-color="rgba(207,168,107,0)" />
    </linearGradient>
    <radialGradient id="lampBulbGrad" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0%"   stop-color="#fff7df" />
      <stop offset="60%"  stop-color="#ead9b4" />
      <stop offset="100%" stop-color="#cfa86b" />
    </radialGradient>
  </defs>

  <!-- 底座 -->
  <ellipse class="lamp-base" cx="50" cy="104" rx="20" ry="4" />
  <rect class="lamp-base" x="44" y="92" width="12" height="12" rx="2" />

  <!-- 灯杆：底座 → 关节 → 灯罩 -->
  <line class="lamp-arm" x1="50" y1="92" x2="50" y2="74" />
  <circle class="lamp-joint" cx="50" cy="74" r="3" />
  <line class="lamp-arm" x1="50" y1="74" x2="60" y2="36" />
  <circle class="lamp-joint" cx="60" cy="36" r="3" />

  <!-- 灯罩：梯形 + 描边 -->
  <path class="lamp-shade" d="M44 36 L76 36 L70 16 L50 16 Z" />
  <rect class="lamp-rim" x="46" y="36" width="28" height="2" rx="1" />
  <rect class="lamp-rim" x="46" y="14" width="28" height="2" rx="1" />

  <!-- 灯泡：圆形 + 中心高光 -->
  <circle class="lamp-bulb" cx="60" cy="26" r="5" />
  <circle cx="60" cy="26" r="5" fill="url(#lampBulbGrad)" opacity="0.7" />

  <!-- 光锥：梯形，向下投出 -->
  <polygon class="lamp-cone" points="44,38 76,38 100,108 20,108" />

  <!-- 拉绳：从灯罩底部垂下 -->
  <line class="lamp-cord" x1="60" y1="36" x2="60" y2="70" />
  <circle class="lamp-cord-bead" cx="60" cy="72" r="2" />
</svg>
    `.trim();
  }

  function injectLamp() {
    if (document.querySelector(".xueji-lamp")) return;
    const aside = document.createElement("aside");
    aside.className = "xueji-lamp";
    aside.setAttribute("role", "button");
    aside.setAttribute("aria-label", "台灯开关 · 拉绳切换");
    aside.setAttribute("tabindex", "0");
    aside.innerHTML = lampSvgMarkup();
    document.body.appendChild(aside);
  }

  function setupLamp() {
    // 还原上次状态
    try {
      if (localStorage.getItem("xueji_lamp_off") === "1") {
        document.body.classList.add("lamp-off");
      }
    } catch (e) { /* localStorage 不可用时静默 */ }

    const lamp = document.querySelector(".xueji-lamp");
    if (!lamp) return;

    const toggle = (e) => {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }
      // 拉绳摆动动画（先 remove 强制重启）
      lamp.classList.remove("lamp-pulling");
      void lamp.offsetWidth;
      lamp.classList.add("lamp-pulling");

      const nextOff = !document.body.classList.contains("lamp-off");
      document.body.classList.toggle("lamp-off", nextOff);
      try { localStorage.setItem("xueji_lamp_off", nextOff ? "1" : "0"); } catch (e) {}

      if (window.xuejiToast) {
        window.xuejiToast(nextOff ? "夜深了，灯熄一盏" : "灯亮了，灯下书卷开始", {
          type: nextOff ? "info" : "good",
          pos: "tr",
          dur: 1800
        });
      }
    };

    lamp.addEventListener("click", toggle);
    lamp.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") toggle(e);
    });
  }

  /* ===========================================================
   * 2.6 桌面端光标追光（仅桌面 + 细指针）
   * =========================================================== */
  function setupCursorGlow() {
    if (reducedMotion || isMobile || isWeChat) return;
    if (!window.matchMedia || !window.matchMedia("(pointer: fine)").matches) return;
    if (document.querySelector(".xueji-cursor")) return;

    const dot = document.createElement("div");
    dot.className = "xueji-cursor";
    dot.setAttribute("aria-hidden", "true");
    document.body.appendChild(dot);

    let x = -400, y = -400, tx = -400, ty = -400, raf = 0, armed = false;
    const onMove = (e) => {
      tx = e.clientX; ty = e.clientY;
      if (!armed) { x = tx; y = ty; dot.classList.add("is-on"); armed = true; }
    };
    const tick = () => {
      x += (tx - x) * 0.18;
      y += (ty - y) * 0.18;
      dot.style.transform = `translate(${x - 180}px, ${y - 180}px)`;
      raf = requestAnimationFrame(tick);
    };

    window.addEventListener("pointermove", onMove, { passive: true });
    document.addEventListener("mouseleave", () => { dot.classList.remove("is-on"); armed = false; });
    document.addEventListener("mouseenter", () => { dot.classList.add("is-on"); armed = true; });
    raf = requestAnimationFrame(tick);
  }

  /* ===========================================================
   * 2.7 主按钮磁吸（仅桌面 + 细指针）
   * =========================================================== */
  function setupMagneticButtons() {
    if (reducedMotion || isMobile || isWeChat) return;
    if (!window.matchMedia || !window.matchMedia("(pointer: fine)").matches) return;
    document.querySelectorAll("button.primary, a.primary, .btn-primary").forEach(btn => {
      btn.classList.add("is-magnetic");
      let raf = 0;
      const reset = () => { btn.style.transform = ""; };
      btn.addEventListener("pointermove", (e) => {
        if (raf) cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          const rect = btn.getBoundingClientRect();
          const dx = ((e.clientX - rect.left) / rect.width - 0.5) * 6;
          const dy = ((e.clientY - rect.top) / rect.height - 0.5) * 4;
          btn.style.transform = `translate(${dx.toFixed(1)}px, ${dy.toFixed(1)}px)`;
        });
      });
      btn.addEventListener("pointerleave", () => { if (raf) cancelAnimationFrame(raf); reset(); });
    });
  }

  /* ===========================================================
   * 2.8 标题字符渐显（为 [data-title-letters] 的元素自动分字）
   * =========================================================== */
  function setupTitleLetters() {
    if (reducedMotion) return;
    document.querySelectorAll("[data-title-letters]").forEach(el => {
      if (el.dataset.lettered === "1") return;
      el.dataset.lettered = "1";
      const text = el.textContent || "";
      el.textContent = "";
      el.classList.add("title-letters");
      [...text].forEach((ch, i) => {
        const span = document.createElement("span");
        span.textContent = ch === " " ? "\u00A0" : ch;
        span.style.animationDelay = (i * 60) + "ms";
        el.appendChild(span);
      });
    });
  }

  /* ===========================================================
     3. Preview badge
     =========================================================== */
  function injectPreviewBadge() {
    if (!previewOn) return;
    if (document.querySelector(".preview-badge")) return;
    const badge = document.createElement("span");
    badge.className = "preview-badge";
    badge.textContent = "预览模式 · 无后端";
    badge.title = "当前为无后端预览模式，所有 /api/* 请求被模拟返回";
    document.body.appendChild(badge);
  }

  /* ===========================================================
     4. 动效引擎
     =========================================================== */
  function setupReveal() {
    if (reducedMotion) {
      document.querySelectorAll(".fx-reveal").forEach(el => el.classList.add("in"));
      return;
    }
    const targets = document.querySelectorAll("section, .today-overview, .student-card, .guide-card, .ops-card, .today-cell, .trust-item, .step, .knowledge-card, .voice-card, .card, .auth-panel, .hero");
    targets.forEach((el, idx) => {
      el.classList.add("fx-reveal");
      el.style.transitionDelay = Math.min(idx * 30, 200) + "ms";
    });
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add("in");
          io.unobserve(e.target);
        }
      });
    }, { rootMargin: "-40px", threshold: 0.05 });
    targets.forEach(el => io.observe(el));
  }

  function setupCountUp() {
    if (reducedMotion) return;
    const animate = (el) => {
      const text = (el.textContent || "").trim();
      const match = text.match(/^(-?[\d,]+(?:\.\d+)?)(.*)$/);
      if (!match) return;
      const target = parseFloat(match[1].replace(/,/g, ""));
      const suffix = match[2] || "";
      if (!isFinite(target) || target === 0) return;
      const dur = 900;
      const start = performance.now();
      const from = 0;
      const tick = (now) => {
        const t = Math.min(1, (now - start) / dur);
        const eased = 1 - Math.pow(1 - t, 3);
        const val = from + (target - from) * eased;
        el.textContent = (Number.isInteger(target) ? Math.round(val).toLocaleString() : val.toFixed(1)) + suffix;
        if (t < 1) requestAnimationFrame(tick);
        else el.textContent = (Number.isInteger(target) ? target.toLocaleString() : target.toFixed(1)) + suffix;
      };
      requestAnimationFrame(tick);
    };
    const candidates = document.querySelectorAll("#studentCount, #actionCount, .today-cell strong, .meter span[data-num]");
    candidates.forEach((el, idx) => {
      setTimeout(() => animate(el), 300 + idx * 80);
    });
  }

  function setupRipple() {
    if (reducedMotion) return;
    document.addEventListener("pointerdown", (e) => {
      const btn = e.target.closest("button:not(.no-ripple)");
      if (!btn || btn.disabled) return;
      const rect = btn.getBoundingClientRect();
      const r = Math.max(rect.width, rect.height);
      const ink = document.createElement("span");
      ink.className = "ripple";
      ink.style.width = ink.style.height = r + "px";
      ink.style.left = (e.clientX - rect.left - r / 2) + "px";
      ink.style.top = (e.clientY - rect.top - r / 2) + "px";
      btn.appendChild(ink);
      setTimeout(() => ink.remove(), 700);
    }, { passive: true });
  }

  function setupTilt() {
    if (reducedMotion || isMobile) return;
    const targets = document.querySelectorAll(".student-card, .ops-card, .guide-card, .today-cell, .trust-item, .knowledge-card");
    targets.forEach(el => {
      let raf = 0;
      el.addEventListener("pointermove", (e) => {
        if (raf) cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          const rect = el.getBoundingClientRect();
          const x = ((e.clientX - rect.left) / rect.width - 0.5) * 4;
          const y = -((e.clientY - rect.top) / rect.height - 0.5) * 4;
          el.style.transform = `perspective(800px) rotateX(${y}deg) rotateY(${x}deg) translateY(-2px)`;
        });
      });
      el.addEventListener("pointerleave", () => {
        el.style.transform = "";
      });
    });
  }

  function setupMeterSheen() {
    if (reducedMotion) return;
    document.querySelectorAll(".meter span").forEach(span => {
      const pct = parseFloat(span.dataset.value || span.textContent || "0");
      if (pct) {
        setTimeout(() => { span.style.width = pct + "%"; }, 200);
      }
    });
  }

  function setupCarousel() {
    document.querySelectorAll(".row-carousel").forEach(c => {
      c.setAttribute("tabindex", "0");
      c.setAttribute("role", "region");
      c.setAttribute("aria-label", "横向滑动浏览");
    });
  }

  /* ===========================================================
   * 4.5 首屏低信息密度：横向滑动卡片轮播
   * 把每个页面 hero 区之后的核心「下一步行动」浓缩成 3-5 张横向滑卡
   * 首屏只露 1.x 张，其余靠滑动揭示 → 降低第一眼信息密度
   * =========================================================== */
  const CAROUSEL_PLANS = {
    parent: {
      eyebrow: "今日 · 一目了然",
      title: "从这一步开始",
      hint: "← 横向滑动 · 5 项待办",
      tiles: [
        { icon: "📒", name: "填写问卷", desc: "约 3 分钟", badge: "1" },
        { icon: "🌱", name: "查看计划", desc: "今日节奏", badge: "2" },
        { icon: "💬", name: "听孩子跟读", desc: "上传录音", badge: "3" },
        { icon: "🪶", name: "本周反馈", desc: "AI 已就绪" },
        { icon: "🎁", name: "邀请好友", desc: "解锁奖励" }
      ]
    },
    student: {
      eyebrow: "今天 · 灯下开始",
      title: "先做一件事",
      hint: "← 横向滑动 · 3 件小事",
      tiles: [
        { icon: "🎙", name: "今日跟读", desc: "开口即成长", badge: "1" },
        { icon: "🃏", name: "知识卡", desc: "回顾 + 1", badge: "2" },
        { icon: "📜", name: "昨日回顾", desc: "看看进步" }
      ]
    },
    admin: {
      eyebrow: "调度台",
      title: "今天要看的三件事",
      hint: "← 横向滑动",
      tiles: [
        { icon: "👥", name: "学生列表", desc: "今日活跃", badge: "12" },
        { icon: "🛠", name: "调整队列", desc: "待处理", badge: "3" },
        { icon: "✨", name: "AI 任务", desc: "运行中", badge: "5" }
      ]
    },
    default: {
      eyebrow: "快捷",
      title: "从这里开始",
      hint: "← 横向滑动",
      tiles: [
        { icon: "✨", name: "开始", desc: "进入下一步" },
        { icon: "📒", name: "记录", desc: "今日点滴" },
        { icon: "💬", name: "对话", desc: "跟 AI 聊聊" }
      ]
    }
  };

  function detectPage() {
    const path = (location.pathname || "").toLowerCase();
    if (path.includes("parent")) return "parent";
    if (path.includes("student")) return "student";
    if (path.includes("loop_tool") || path.includes("tool")) return "admin";
    return "default";
  }

  function pickCarouselHost(page) {
    const sels = {
      parent: [".service-brief", ".tab-content", "main", "body"],
      student: [".today-overview", "main", "body"],
      admin: [".workarea", "main", "body"],
      default: ["main", "body"]
    }[page] || ["main", "body"];
    for (const s of sels) {
      const el = document.querySelector(s);
      if (el) return el;
    }
    return document.body;
  }

  function buildQuickCarousel() {
    const page = detectPage();
    const plan = CAROUSEL_PLANS[page] || CAROUSEL_PLANS.default;
    const host = pickCarouselHost(page);
    if (!host) return;
    if (host.querySelector(".row-carousel.xueji-quick")) return; // 防重复

    const row = document.createElement("section");
    row.className = "row-carousel xueji-quick fx-reveal";
    row.setAttribute("aria-label", "快捷操作 · 横向滑动浏览");
    row.innerHTML = `
      <div class="quick-head">
        <span class="quick-eyebrow">${plan.eyebrow}</span>
        <h3 class="quick-title">${plan.title}</h3>
        <span class="quick-hint">${plan.hint}</span>
      </div>
      <div class="quick-track">
        ${plan.tiles
          .map(
            (t, i) => `
          <article class="quick-tile" data-idx="${i}">
            <span class="quick-ico" aria-hidden="true">${t.icon}</span>
            <div class="quick-body">
              <div class="quick-name">${t.name}</div>
              <div class="quick-desc">${t.desc}</div>
            </div>
            ${t.badge ? `<span class="quick-badge">${t.badge}</span>` : ""}
          </article>`
          )
          .join("")}
      </div>
    `;
    host.appendChild(row);
  }

  /* ===========================================================
     5. Toast 简易 API
     =========================================================== */
  window.xuejiToast = function (msg, opts = {}) {
    const { type = "info", pos = "tr", dur = 2400 } = opts;
    let host = document.querySelector(".toast-host." + pos);
    if (!host) {
      host = document.createElement("div");
      host.className = "toast-host " + pos;
      document.body.appendChild(host);
    }
    const t = document.createElement("div");
    t.className = "toast " + type;
    t.textContent = msg;
    host.appendChild(t);
    setTimeout(() => {
      t.classList.add("out");
      setTimeout(() => t.remove(), 320);
    }, dur);
  };

  /* ===========================================================
     6. 初始化
     =========================================================== */
  function init() {
    injectFxBg();
    injectLamp();
    setupLamp();
    setupCursorGlow();
    setupMagneticButtons();
    setupTitleLetters();
    injectPreviewBadge();
    setupReveal();
    setupCountUp();
    setupRipple();
    setupTilt();
    setupMeterSheen();
    setupCarousel();
    buildQuickCarousel();
    if (previewOn) {
      setTimeout(() => {
        window.xuejiToast("预览模式：所有 /api/* 由本引擎模拟返回", { type: "warn", pos: "tr" });
      }, 600);
    }
    if (isWeChat) {
      console.info("[xueji] 微信内置浏览器已识别：safe-area-inset-* 已应用");
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();

</script>

<meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>学记教育闭环后台</title>
  <style>
/* ============================================================
   学记 · 灯下书卷  v7
   改动要点（相对 v6）：
   - 降饱和度（金色 → 米金；墨色更中性，加冷暖层次）
   - 文房五色入色板（黛蓝 / 竹绿 / 朱砂 / 墨青 / 藕粉），打破单黄调
   - 真实台灯组件：SVG 灯 + 拉绳开关（可关闭灯，进入"熄灯阅读"模式）
   - 加光标追光 / 磁吸按钮 / 字符渐显 / 鼠标光斑
   - 修字体溢出：全局 min-width:0 + overflow-wrap anywhere
   - 修家长端布局：左信息栏/右登录栏 align-items:start，登录卡不再拉长
   - 宣纸纹理：feTurbulence 噪声贴底（极弱 0.04 不透明度）
   ============================================================ */

:root {
  /* 色板 · 墨（中性深，留极弱暖） */
  --ink-0:        #0c0a08;
  --ink-1:        #141210;
  --ink-2:        #1c1a17;
  --ink-3:        #262320;
  --ink-4:        #322e29;
  --ink-glass:    rgba(28, 26, 23, 0.72);
  --ink-glass-2:  rgba(20, 18, 16, 0.55);

  /* 色板 · 灯金（降饱和） */
  --gold-1:       #ead9b4;
  --gold-2:       #cfa86b;
  --gold-3:       #b08d52;
  --gold-4:       #84683e;
  --gold-glow:    rgba(207, 168, 107, 0.30);
  --gold-glow-s:  rgba(207, 168, 107, 0.16);
  --gold-glow-xs: rgba(207, 168, 107, 0.08);

  /* 色板 · 宣纸（文字） */
  --paper-1:      #ece5d4;
  --paper-2:      #b8ad97;
  --paper-3:      #807866;
  --paper-4:      #4a4538;

  /* 文房五色（打破单调：3 张特点卡 / 5 步学习流 / 3 今日数据格各上不同色） */
  --c-indigo:     #7a93ad;   /* 黛蓝 — 信息 / 链接 / 英语阅读 */
  --c-bamboo:     #8aa88f;   /* 竹绿 — 完成 / 成功 / 知识卡 */
  --c-cinnabar:   #c97b63;   /* 朱砂 — 重要 / 警告 / 学习提醒 */
  --c-ink:        #5f7a72;   /* 墨青 — 次要 accent / 进度 */
  --c-rose:       #b08a8f;   /* 藕粉 — 装饰 / 弱对比 */

  /* 语义 */
  --good:         var(--c-bamboo);
  --warn:         var(--gold-2);
  --err:          var(--c-cinnabar);
  --info:         var(--c-indigo);

  /* 线 · 仍走金色但更克制 */
  --line:         rgba(207, 168, 107, 0.18);
  --line-soft:    rgba(207, 168, 107, 0.08);
  --line-strong:  rgba(207, 168, 107, 0.30);

  /* 宣纸纹理（feTurbulence 噪声 · 极弱） */
  --paper-grain:  url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' seed='4'/><feColorMatrix values='0 0 0 0 0.92 0 0 0 0 0.84 0 0 0 0 0.66 0 0 0 0.045 0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");

  /* 间距 · 4 倍数 */
  --s-1:  4px;
  --s-2:  8px;
  --s-3:  12px;
  --s-4:  16px;
  --s-5:  20px;
  --s-6:  24px;
  --s-7:  32px;
  --s-8:  48px;
  --s-9:  64px;

  /* 圆角 */
  --r-xs: 4px;
  --r-sm: 6px;
  --r-md: 10px;
  --r-lg: 16px;
  --r-xl: 24px;
  --r-pill: 999px;

  /* 阴影 */
  --shadow-1: 0 1px 3px rgba(0,0,0,.45);
  --shadow-2: 0 4px 14px rgba(0,0,0,.5);
  --shadow-3: 0 8px 32px rgba(0,0,0,.55);
  --shadow-amber: 0 4px 24px var(--gold-glow-s);
  --shadow-lamp: 0 0 80px var(--gold-glow-xs);
  --shadow-card: 0 1px 0 rgba(255,255,255,.04) inset, 0 1px 3px rgba(0,0,0,.45);

  /* 动效曲线 */
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --dur-fast: 160ms;
  --dur-base: 240ms;
  --dur-slow: 400ms;

  /* 字体 */
  --font-serif: "Noto Serif SC", "Source Han Serif SC", "Songti SC", "STSong", "霞鹜文楷", "Klee One", serif;
  --font-sans:  "Noto Sans SC", "PingFang SC", "Microsoft YaHei", "Segoe UI", system-ui, sans-serif;
  --font-mono:  "JetBrains Mono", "Fira Code", "SF Mono", monospace;

  /* 布局 */
  --header-h: 56px;
  --container: 880px;
  --fab-size: 56px;
}

/* 全局盒模型 */
*, *::before, *::after { box-sizing: border-box; }
html, body {
  width: 100%;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

/* 防字体溢出（flex/grid 子项 + 任何文本节点） */
.flex-min, main *, section *, header *, .workarea *, .ops-brief *, .today-overview *, .hero *, .student-trust * { min-width: 0; }
p, li, dd, .body, .hint, .notice, .status, .result, .muted, .tag, .pill, .care-note, .trust-card span, .guide-card span, .ops-card span, .student-card p, .kv div, .auth-note, .route-note {
  overflow-wrap: anywhere;
  word-break: break-word;
}

/* 关键：body 退为纯色，装饰全在 .fx-bg 内 */
body {
  margin: 0;
  font-family: var(--font-sans);
  color: var(--paper-1);
  background: var(--ink-1);
  line-height: 1.6;
  min-height: 100vh;
  /* 宣纸纹理贴底（极弱，不抢色） */
  background-image: var(--paper-grain);
  background-size: 180px 180px;
  background-repeat: repeat;
  background-attachment: fixed;
}

/* 内容层永远高于装饰层 */
main, header, nav, footer, .workarea, section, .ops-brief, .xueji-lamp, .xueji-cursor { position: relative; z-index: 1; }

/* ====== 装饰层（单一 source of truth）====== */
.fx-bg {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
  background:
    /* 灯下主光晕（顶部中央） */
    radial-gradient(ellipse 80% 50% at 50% -10%, rgba(207, 168, 107, 0.22), transparent 65%),
    /* 远光（右下角，黛蓝） */
    radial-gradient(ellipse 60% 45% at 95% 95%, rgba(122, 147, 173, 0.16), transparent 70%),
    /* 远光（左下角，竹绿） */
    radial-gradient(ellipse 60% 45% at 5% 95%, rgba(138, 168, 143, 0.14), transparent 70%),
    /* 远光（右上角，朱砂） */
    radial-gradient(ellipse 50% 40% at 100% 0%, rgba(201, 123, 99, 0.10), transparent 65%),
    /* 远光（左上角，藕粉） */
    radial-gradient(ellipse 50% 40% at 0% 0%, rgba(176, 138, 143, 0.10), transparent 65%),
    var(--ink-1);
}

/* 灯下光晕 · 缓慢呼吸（不使用 filter:blur） */
.fx-bg::before {
  content: "";
  position: absolute;
  top: -20%;
  left: 50%;
  width: 1400px;
  height: 1000px;
  transform: translateX(-50%);
  background: radial-gradient(circle, rgba(234, 217, 180, 0.10) 0%, rgba(207, 168, 107, 0.05) 30%, transparent 65%);
  filter: blur(60px);
  animation: lamp-breath 12s var(--ease-out) infinite;
  will-change: opacity, transform;
}
@keyframes lamp-breath {
  0%, 100% { opacity: .65; transform: translateX(-50%) scale(1); }
  50%      { opacity: 1;   transform: translateX(-50%) scale(1.08); }
}

/* 细密灯纹（极弱） */
.fx-bg::after {
  content: "";
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(207, 168, 107, 0.02) 1px, transparent 1px),
    linear-gradient(90deg, rgba(207, 168, 107, 0.02) 1px, transparent 1px);
  background-size: 64px 64px;
  background-position: -1px -1px;
  mask-image: radial-gradient(ellipse 70% 50% at 50% 30%, black 30%, transparent 80%);
  -webkit-mask-image: radial-gradient(ellipse 70% 50% at 50% 30%, black 30%, transparent 80%);
}

/* 灯尘 · 12 颗错落浮升 */
.fx-bg .ember {
  position: absolute;
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: var(--gold-1);
  box-shadow: 0 0 6px var(--gold-glow-s);
  opacity: 0;
  animation: ember-rise 14s linear infinite;
  will-change: transform, opacity;
}
.fx-bg .ember:nth-child(1)  { left:  6%; animation-delay:  0s; animation-duration: 18s; }
.fx-bg .ember:nth-child(2)  { left: 14%; animation-delay:  3s; animation-duration: 16s; }
.fx-bg .ember:nth-child(3)  { left: 22%; animation-delay:  6s; animation-duration: 22s; }
.fx-bg .ember:nth-child(4)  { left: 32%; animation-delay:  1s; animation-duration: 19s; }
.fx-bg .ember:nth-child(5)  { left: 42%; animation-delay:  8s; animation-duration: 21s; }
.fx-bg .ember:nth-child(6)  { left: 51%; animation-delay:  4s; animation-duration: 17s; }
.fx-bg .ember:nth-child(7)  { left: 60%; animation-delay:  2s; animation-duration: 20s; }
.fx-bg .ember:nth-child(8)  { left: 68%; animation-delay:  9s; animation-duration: 18s; }
.fx-bg .ember:nth-child(9)  { left: 76%; animation-delay:  5s; animation-duration: 23s; }
.fx-bg .ember:nth-child(10) { left: 84%; animation-delay:  7s; animation-duration: 16s; }
.fx-bg .ember:nth-child(11) { left: 90%; animation-delay: 10s; animation-duration: 19s; }
.fx-bg .ember:nth-child(12) { left: 96%; animation-delay: 12s; animation-duration: 22s; }
@keyframes ember-rise {
  0%   { transform: translateY(0)        scale(0.4); opacity: 0; }
  10%  { opacity: .9; }
  60%  { opacity: .6; }
  100% { transform: translateY(-110vh)   scale(1.1); opacity: 0; }
}

/* ====== 通用排版 ====== */
h1, h2, h3, h4 {
  font-family: var(--font-serif);
  color: var(--paper-1);
  margin: 0 0 var(--s-3);
  letter-spacing: .01em;
  line-height: 1.2;
  font-weight: 600;
}
h1 { font-size: clamp(28px, 4.6vw, 38px); }
h2 { font-size: clamp(20px, 2.8vw, 24px); }
h3 { font-size: clamp(16px, 2.2vw, 18px); }
h4 { font-size: 15px; color: var(--gold-2); font-weight: 600; }
p  { margin: 0 0 var(--s-3); }
a  { color: var(--gold-2); text-decoration: none; transition: color var(--dur-fast); }
a:hover { color: var(--gold-1); }

/* 链接式按钮 */
.link-button {
  background: none; border: none; padding: 0; color: var(--gold-2);
  cursor: pointer; font: inherit; text-decoration: underline;
  text-underline-offset: 3px; transition: color var(--dur-fast);
}
.link-button:hover { color: var(--gold-1); }

/* ====== 通用排版 · 标题左侧金色立柱 ====== */
.head h2, .section-head h2, .head h3, .section-head h3 {
  position: relative;
  padding-left: 14px;
}
.head h2::before, .section-head h2::before,
.head h3::before, .section-head h3::before {
  content: "";
  position: absolute;
  left: 0; top: 50%;
  transform: translateY(-50%);
  width: 4px;
  height: 1.05em;
  background: linear-gradient(180deg, var(--gold-1), var(--gold-3));
  border-radius: 2px;
  box-shadow: 0 0 12px var(--gold-glow-s);
}

/* ====== Header / Topbar ====== */
header {
  padding: 0;
  margin: 0;
  position: sticky;
  top: 0;
  z-index: 50;
  background: linear-gradient(180deg, var(--ink-1) 60%, transparent);
  backdrop-filter: blur(8px) saturate(110%);
  -webkit-backdrop-filter: blur(8px) saturate(110%);
}
header .top, header .topbar {
  max-width: var(--container);
  margin: 0 auto;
  padding: 14px var(--s-4);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--s-3);
  min-height: var(--header-h);
  border-bottom: 1px solid var(--line-soft);
}
header h1 {
  font-size: clamp(18px, 2.4vw, 22px);
  margin: 0;
  display: flex;
  align-items: center;
  gap: var(--s-2);
}
header h1::before {
  content: "";
  width: 22px; height: 22px;
  background: radial-gradient(circle, var(--gold-1) 0%, var(--gold-3) 50%, transparent 80%);
  border-radius: 50%;
  box-shadow: 0 0 16px var(--gold-glow-s);
  flex: 0 0 22px;
}

/* ====== Main ====== */
main {
  width: 100%;
  max-width: var(--container);
  margin: 0 auto var(--s-8);
  padding: 0 var(--s-4);
  position: relative;
  z-index: 1;
}

/* ====== Service Brief · Hero（家长端首屏）====== */
.service-brief {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: var(--s-6);
  padding: var(--s-6) 0 var(--s-5);
  border-bottom: 1px solid var(--line-soft);
  margin-bottom: var(--s-5);
  animation: rise .8s var(--ease-out) both;
}
.brief-copy h2 {
  font-size: clamp(22px, 3.4vw, 30px);
  background: linear-gradient(180deg, var(--paper-1) 0%, var(--gold-1) 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  margin-bottom: var(--s-2);
}
.brief-copy p { color: var(--paper-2); font-size: 14px; line-height: 1.7; }
.brief-rail {
  display: grid;
  gap: var(--s-2);
  font-size: 13px;
  color: var(--paper-2);
}
.brief-rail > div {
  padding: 8px 12px;
  border: 1px solid var(--line-soft);
  border-radius: var(--r-md);
  background: var(--ink-glass);
  display: flex; align-items: center; gap: var(--s-2);
  transition: border-color var(--dur-base), background var(--dur-base), transform var(--dur-base);
}
.brief-rail > div:hover { border-color: var(--gold-glow-s); transform: translateX(2px); }
.brief-rail span {
  width: 22px; height: 22px; flex: 0 0 22px;
  display: inline-flex; align-items: center; justify-content: center;
  border-radius: 50%;
  background: var(--gold-glow-xs);
  color: var(--gold-2);
  font-family: var(--font-serif);
  font-weight: 700;
  font-size: 12px;
  border: 1px solid var(--line);
}

/* ====== Tabs（家长端 / 后台 共用）====== */
.tabs, nav {
  display: flex;
  gap: var(--s-1);
  padding: 0 0 var(--s-3);
  margin-bottom: var(--s-4);
  border-bottom: 1px solid var(--line-soft);
  overflow-x: auto;
  scrollbar-width: thin;
  scrollbar-color: var(--line) transparent;
}
.tabs::-webkit-scrollbar, nav::-webkit-scrollbar { height: 4px; }
.tabs::-webkit-scrollbar-thumb, nav::-webkit-scrollbar-thumb { background: var(--line); border-radius: 2px; }
.tabs button, nav button {
  flex: 0 0 auto;
  background: none; border: none; padding: 10px 14px;
  font: inherit; font-size: 14px;
  color: var(--paper-2);
  cursor: pointer;
  border-bottom: 2px solid transparent;
  transition: color var(--dur-fast), border-color var(--dur-fast), transform var(--dur-fast);
  white-space: nowrap;
}
.tabs button:hover, nav button:hover { color: var(--paper-1); }
.tabs button.active, nav button.active {
  color: var(--gold-1);
  border-bottom-color: var(--gold-2);
  font-weight: 600;
}

/* ====== Flow Guide（家长端步骤条）====== */
.flow {
  display: flex;
  flex-wrap: wrap;
  gap: var(--s-2);
  padding: var(--s-3) 0;
  margin-bottom: var(--s-3);
  font-size: 13px;
  color: var(--paper-2);
}
.flow-step {
  padding: 6px 12px;
  border: 1px solid var(--line);
  border-radius: var(--r-pill);
  background: var(--ink-glass-2);
  transition: all var(--dur-base) var(--ease-out);
}
.flow-step:hover { border-color: var(--gold-3); color: var(--paper-1); }

/* ====== Section（公共卡片容器）====== */
section {
  display: none;
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  background: var(--ink-glass);
  backdrop-filter: blur(10px) saturate(120%);
  -webkit-backdrop-filter: blur(10px) saturate(120%);
  box-shadow: var(--shadow-2);
  padding: var(--s-6);
  margin-bottom: var(--s-4);
  position: relative;
  overflow: hidden;
  animation: rise .6s var(--ease-out) both;
}
section.active { display: block; }
section::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--gold-glow-s), transparent);
}
section .head { margin-bottom: var(--s-4); }
section .head h2 { margin-bottom: 4px; }
section .head .hint { color: var(--paper-2); font-size: 13px; }

@keyframes rise {
  from { opacity: 0; transform: translateY(12px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ====== Section Guide（操作说明三卡）====== */
.section-guide, .ops-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--s-3);
  margin-bottom: var(--s-4);
}
.guide-card, .ops-card {
  border: 1px solid var(--line-soft);
  border-radius: var(--r-md);
  background: var(--ink-glass-2);
  padding: var(--s-3) var(--s-4);
  transition: border-color var(--dur-base), transform var(--dur-base);
}
.guide-card:hover, .ops-card:hover { border-color: var(--gold-glow-s); transform: translateY(-2px); }
.guide-card strong, .ops-card strong {
  display: block;
  color: var(--gold-2);
  font-family: var(--font-serif);
  font-size: 14px;
  margin-bottom: 4px;
}
.guide-card span, .ops-card span {
  color: var(--paper-2);
  font-size: 12.5px;
  line-height: 1.55;
}

/* ====== Auth（登录注册面板）====== */
.auth-shell {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: var(--s-5);
  margin-bottom: var(--s-4);
}
.auth-intro {
  padding: var(--s-4) 0;
}
.auth-intro h2 {
  font-size: clamp(20px, 3vw, 26px);
  background: linear-gradient(180deg, var(--paper-1), var(--gold-1));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.auth-intro p { color: var(--paper-2); font-size: 14px; line-height: 1.7; }

.trust-strip {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--s-2);
  margin: var(--s-3) 0 var(--s-4);
}
.trust-card {
  padding: var(--s-3);
  border: 1px solid var(--line-soft);
  border-radius: var(--r-md);
  background: var(--ink-glass-2);
  text-align: center;
}
.trust-card strong {
  display: block;
  font-family: var(--font-serif);
  font-size: 18px;
  color: var(--gold-1);
  margin-bottom: 4px;
}
.trust-card span { color: var(--paper-2); font-size: 12px; line-height: 1.45; }

.auth-points { display: grid; gap: var(--s-2); margin-bottom: var(--s-3); }
.auth-points > div {
  display: flex; align-items: center; gap: var(--s-2);
  font-size: 13.5px; color: var(--paper-2);
}
.auth-points > div span {
  flex: 0 0 22px; width: 22px; height: 22px;
  border-radius: 50%;
  background: var(--gold-glow-xs);
  border: 1px solid var(--line);
  color: var(--gold-2);
  display: inline-flex; align-items: center; justify-content: center;
  font-family: var(--font-serif); font-size: 12px; font-weight: 700;
}
.auth-points strong { color: var(--paper-1); margin-left: 4px; }

.auth-note {
  padding: var(--s-3);
  border-left: 3px solid var(--gold-2);
  background: rgba(232, 185, 92, 0.06);
  color: var(--paper-2);
  font-size: 12.5px;
  line-height: 1.6;
  border-radius: 0 var(--r-sm) var(--r-sm) 0;
}

.auth-panel {
  padding: var(--s-5);
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  background: var(--ink-3);
  box-shadow: var(--shadow-amber);
  position: relative;
}
.auth-view { display: none; }
body.auth-login .login-view { display: block; }
body.auth-register .register-view { display: block; }

.auth-view h3 {
  font-family: var(--font-serif);
  font-size: 18px;
  margin-bottom: var(--s-3);
  color: var(--gold-1);
}
.auth-view label {
  display: block;
  font-size: 12.5px;
  color: var(--paper-2);
  margin: var(--s-2) 0 4px;
}
.auth-view input { width: 100%; }
.student-bind-fields {
  margin: var(--s-3) 0;
  padding: var(--s-3);
  border: 1px dashed var(--line);
  border-radius: var(--r-md);
  background: rgba(232, 185, 92, 0.04);
}
.student-bind-fields strong {
  display: block;
  color: var(--gold-2);
  font-size: 13px;
  margin-bottom: 4px;
  font-family: var(--font-serif);
}
.auth-switch {
  margin: var(--s-3) 0 0;
  font-size: 13px;
  color: var(--paper-2);
  text-align: center;
}

/* ====== 表单 ====== */
.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--s-3) var(--s-4);
  margin-bottom: var(--s-4);
}
.grid > .span2 { grid-column: span 2; }

label {
  display: block;
  font-size: 12.5px;
  color: var(--paper-2);
  margin-bottom: 4px;
  font-weight: 500;
}
input, select, textarea {
  width: 100%;
  min-height: 42px;
  padding: 9px 12px;
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  background: var(--ink-2);
  color: var(--paper-1);
  font: inherit;
  font-size: 14px;
  transition: border-color var(--dur-fast), box-shadow var(--dur-fast), background var(--dur-fast);
}
input::placeholder, textarea::placeholder { color: var(--paper-4); }
input:hover, select:hover, textarea:hover { border-color: var(--line-strong); }
input:focus, select:focus, textarea:focus {
  outline: none;
  border-color: var(--gold-2);
  box-shadow: 0 0 0 3px var(--gold-glow-xs);
  background: var(--ink-3);
}
textarea { min-height: 88px; padding: 10px 12px; resize: vertical; line-height: 1.55; }
select {
  appearance: none;
  -webkit-appearance: none;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6'><path d='M1 1l4 4 4-4' stroke='%23e8b95c' stroke-width='1.4' fill='none' stroke-linecap='round'/></svg>");
  background-repeat: no-repeat;
  background-position: right 12px center;
  padding-right: 32px;
}
input[type="file"] {
  padding: 6px;
  font-size: 12.5px;
  color: var(--paper-2);
  background: var(--ink-glass-2);
}

/* ====== Buttons ====== */
button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-height: 42px;
  padding: 9px 18px;
  border: 1px solid var(--gold-3);
  border-radius: var(--r-md);
  background: transparent;
  color: var(--paper-1);
  font: inherit;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  position: relative;
  overflow: hidden;
  transition: transform var(--dur-fast), background var(--dur-fast), border-color var(--dur-fast), box-shadow var(--dur-fast), color var(--dur-fast);
}
button:focus-visible { outline: 2px solid var(--gold-1); outline-offset: 2px; }

/* Primary · 金色主按钮（带 sheen 流光 + 灯下光晕） */
button.primary {
  background: linear-gradient(180deg, var(--gold-2) 0%, var(--gold-3) 100%);
  border-color: var(--gold-2);
  color: var(--ink-1);
  font-weight: 600;
  box-shadow: 0 4px 16px var(--gold-glow-s), inset 0 1px 0 rgba(255, 255, 255, 0.18);
}
button.primary::before {
  content: "";
  position: absolute;
  top: 0; left: -75%;
  width: 50%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35), transparent);
  transform: skewX(-20deg);
  transition: left 0.7s var(--ease-out);
  pointer-events: none;
}
button.primary:hover {
  background: linear-gradient(180deg, var(--gold-1) 0%, var(--gold-2) 100%);
  box-shadow: 0 6px 24px var(--gold-glow), inset 0 1px 0 rgba(255, 255, 255, 0.25);
  transform: translateY(-1px);
}
button.primary:hover::before { left: 130%; }
button.primary:active { transform: translateY(0); box-shadow: 0 2px 8px var(--gold-glow-s); }

/* Secondary · 描边按钮 */
button.secondary {
  background: var(--ink-glass-2);
  border-color: var(--line);
  color: var(--paper-1);
}
button.secondary:hover { border-color: var(--gold-3); background: var(--ink-4); color: var(--gold-1); }
button.secondary:active { transform: translateY(1px); }

button.danger {
  background: transparent;
  border-color: var(--err);
  color: var(--err);
}
button.danger:hover { background: rgba(212, 131, 106, 0.1); }

button:disabled {
  opacity: .45;
  cursor: not-allowed;
  transform: none !important;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--s-2);
  margin: var(--s-3) 0;
}

/* ====== Hint / Notice / Pill / Status ====== */
.hint, .status, .notice, .body, .result {
  color: var(--paper-2);
  font-size: 13.5px;
  line-height: 1.55;
}
.notice {
  padding: var(--s-2) var(--s-3);
  border-left: 3px solid var(--gold-3);
  background: rgba(232, 185, 92, 0.05);
  border-radius: 0 var(--r-sm) var(--r-sm) 0;
  margin-bottom: var(--s-3);
}
.notice.warn { border-left-color: var(--warn); background: rgba(232, 185, 92, 0.08); }
.notice.err  { border-left-color: var(--err);  background: rgba(212, 131, 106, 0.08); }

.pill {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 4px 12px;
  border: 1px solid var(--line);
  border-radius: var(--r-pill);
  background: var(--ink-glass-2);
  color: var(--paper-2);
  font-size: 12.5px;
  white-space: nowrap;
}
.pill strong { color: var(--gold-1); font-weight: 600; }

.tag {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 4px 10px;
  border: 1px solid var(--line);
  border-radius: var(--r-pill);
  background: var(--ink-glass-2);
  color: var(--gold-2);
  font-size: 12px;
  font-weight: 600;
}

.warn  { color: var(--warn); }
.err   { color: var(--err); }
.good  { color: var(--good); }
.ok    { color: var(--good); }
.muted { color: var(--paper-3); }

/* ====== Result 区域 ====== */
.result {
  margin-top: var(--s-3);
  padding: var(--s-3) var(--s-4);
  border: 1px solid var(--line-soft);
  border-radius: var(--r-md);
  background: var(--ink-glass-2);
  display: none;
  font-size: 13.5px;
}
.result.show { display: block; animation: rise .5s var(--ease-out) both; }
.result p { margin: 0 0 6px; }
.result p:last-child { margin-bottom: 0; }
.result h4 { color: var(--gold-2); margin: var(--s-2) 0 4px; }
.result ol, .result ul { padding-left: 22px; color: var(--paper-2); }
.result code {
  font-family: var(--font-mono);
  font-size: 12.5px;
  background: var(--ink-0);
  padding: 1px 6px;
  border-radius: var(--r-xs);
  color: var(--gold-1);
}

/* ====== 鉴权状态 · 仅我的账号可见 ====== */
body.logged-out main > section:not(#account) { display: none; }
body.logged-out .tabs { display: none; }
body.logged-out .service-brief { display: none; }
body.logged-in .auth-shell { display: none; }
body.logged-out .actions:has(#logoutBtn) { display: none; }
body.logged-in #logoutBtn { display: inline-flex; }

/* ====== Account Box ====== */
.account-box {
  padding: var(--s-3) var(--s-4);
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  background: var(--ink-glass-2);
  margin-bottom: var(--s-3);
  font-size: 13.5px;
  color: var(--paper-2);
}
.account-box::before { content: "● "; color: var(--gold-2); }

/* ====== Student Card 列表 ====== */
.student-list {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: var(--s-3);
  margin-top: var(--s-3);
}
.student-card {
  padding: var(--s-4);
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  background: var(--ink-glass-2);
  transition: border-color var(--dur-base), transform var(--dur-base), box-shadow var(--dur-base);
}
.student-card:hover {
  border-color: var(--gold-3);
  transform: translateY(-2px);
  box-shadow: var(--shadow-amber);
}
.student-card strong {
  display: block;
  color: var(--gold-1);
  font-family: var(--font-serif);
  font-size: 16px;
  margin-bottom: 4px;
}
.student-card p { color: var(--paper-2); font-size: 12.5px; margin: 0 0 2px; }

/* ====== Referral Panel ====== */
.referral-panel {
  margin-top: var(--s-4);
  padding: var(--s-4);
  border: 1px solid var(--line-soft);
  border-radius: var(--r-lg);
  background: var(--ink-glass-2);
}
.referral-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: var(--s-2) 0;
  border-bottom: 1px dashed var(--line-soft);
  font-size: 13px;
}
.referral-item:last-child { border-bottom: 0; }
.invite-link-row {
  display: flex; gap: var(--s-2);
  margin-top: var(--s-2);
  align-items: center;
}
.invite-link-row input { font-family: var(--font-mono); font-size: 12px; }

/* ====== Ops Brief（后台）====== */
.ops-brief {
  padding: var(--s-5) 0 var(--s-4);
  margin-bottom: var(--s-4);
  border-bottom: 1px solid var(--line-soft);
}
.ops-brief h2 {
  font-size: clamp(22px, 3.4vw, 28px);
  background: linear-gradient(180deg, var(--paper-1), var(--gold-1));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  margin-bottom: 4px;
}
.ops-brief p { color: var(--paper-2); font-size: 14px; margin-bottom: var(--s-3); }

/* ====== Workarea（后台内容区）====== */
.workarea { display: block; }

/* ====== Status Bar in Topbar ====== */
header .topbar .status, header .top .status {
  display: flex; gap: var(--s-2); align-items: center;
  flex-wrap: wrap;
  font-size: 12.5px;
}

/* ====== 后台 · 各类表 / 列表 ====== */
table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
  margin: var(--s-3) 0;
}
th, td {
  text-align: left;
  padding: 8px 10px;
  border-bottom: 1px solid var(--line-soft);
}
th {
  color: var(--gold-2);
  font-family: var(--font-serif);
  font-weight: 600;
  background: var(--ink-glass-2);
  font-size: 12.5px;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}
tbody tr { transition: background var(--dur-fast); }
tbody tr:hover { background: var(--ink-glass-2); }
tbody tr.current { background: rgba(232, 185, 92, 0.08); }
tbody tr.done { opacity: .55; }

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: var(--s-3);
}
.card, .meta-chip {
  padding: var(--s-3);
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  background: var(--ink-glass-2);
  transition: border-color var(--dur-base), transform var(--dur-base);
}
.card { display: flex; flex-direction: column; gap: 4px; }
.card:hover, .meta-chip:hover { border-color: var(--gold-3); transform: translateY(-1px); }
.card strong { color: var(--gold-1); font-family: var(--font-serif); font-size: 14px; }
.card span, .card-meta { color: var(--paper-2); font-size: 12px; }
.card .actions { margin: auto 0 0; padding-top: var(--s-2); }

.helper {
  font-size: 12.5px;
  color: var(--paper-3);
  margin-bottom: var(--s-2);
}
.inline-tools { display: flex; gap: var(--s-2); align-items: center; margin-bottom: var(--s-3); flex-wrap: wrap; }
.section-helper, .body.split { font-size: 13px; }
.section-head {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: var(--s-4); flex-wrap: wrap; gap: var(--s-2);
}
.split { display: grid; grid-template-columns: 1fr; gap: var(--s-4); }
.split > form { padding: 0; }

/* ====== Voice Board · 跟读练习 ====== */
.voice-board {
  display: grid;
  gap: var(--s-3);
  margin-top: var(--s-3);
}
.voice-item, .voice-card, .voice-target {
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  background: var(--ink-glass-2);
  padding: var(--s-3) var(--s-4);
  transition: border-color var(--dur-base);
}
.voice-item:hover, .voice-card:hover { border-color: var(--gold-glow-s); }
.voice-target { font-family: var(--font-serif); font-size: 16px; color: var(--paper-1); }
.voice-result {
  font-size: 12.5px;
  color: var(--paper-2);
  margin-top: var(--s-2);
  padding: var(--s-2);
  background: var(--ink-0);
  border-radius: var(--r-sm);
}

/* ====== 进度条 ====== */
.meter {
  height: 6px;
  background: var(--ink-0);
  border: 1px solid var(--line-soft);
  border-radius: var(--r-pill);
  overflow: hidden;
  margin-top: var(--s-2);
  position: relative;
}
.meter span {
  display: block;
  height: 100%;
  width: 0;
  background: linear-gradient(90deg, var(--gold-3), var(--gold-1));
  border-radius: var(--r-pill);
  position: relative;
  transition: width .8s var(--ease-out);
}
.meter span::after {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.4), transparent);
  background-size: 200% 100%;
  animation: meter-sheen 2.4s linear infinite;
}
@keyframes meter-sheen { from { background-position: 200% 0; } to { background-position: -200% 0; } }

/* ====== KV · 键值对（家长端档案）====== */
.kv {
  display: grid;
  grid-template-columns: max-content 1fr;
  column-gap: var(--s-3);
  row-gap: 6px;
  margin: var(--s-3) 0;
  font-size: 13.5px;
}
.kv > div:nth-child(odd) { color: var(--paper-3); }
.kv > div:nth-child(even) { color: var(--paper-1); }

/* ====== Toast · 4 角位 ======= */
.toast-host {
  position: fixed;
  z-index: 200;
  display: flex; flex-direction: column; gap: var(--s-2);
  pointer-events: none;
}
.toast-host.tl { top: 80px; left: 20px; }
.toast-host.tr { top: 80px; right: 20px; }
.toast-host.bl { bottom: 20px; left: 20px; }
.toast-host.br { bottom: 20px; right: 20px; }
.toast {
  pointer-events: auto;
  padding: var(--s-3) var(--s-4);
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  background: var(--ink-3);
  color: var(--paper-1);
  box-shadow: var(--shadow-3);
  min-width: 220px;
  max-width: 360px;
  font-size: 13.5px;
  border-left: 3px solid var(--gold-2);
  animation: toast-in .4s var(--ease-spring) both;
}
.toast.out { animation: toast-out .3s var(--ease-out) both; }
.toast.good { border-left-color: var(--good); }
.toast.warn { border-left-color: var(--warn); }
.toast.err  { border-left-color: var(--err); }
@keyframes toast-in  { from { transform: translateY(-12px); opacity: 0; } to { transform: none; opacity: 1; } }
@keyframes toast-out { to { transform: translateY(-8px); opacity: 0; } }

/* ====== Drawer · 抽屉 ======= */
.drawer-mask {
  position: fixed; inset: 0;
  background: rgba(0,0,0,.55);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  z-index: 150;
  opacity: 0; pointer-events: none;
  transition: opacity .3s var(--ease-out);
}
.drawer-mask.open { opacity: 1; pointer-events: auto; }
.drawer {
  position: fixed; top: 0; right: 0; bottom: 0;
  width: min(420px, 92vw);
  background: var(--ink-2);
  border-left: 1px solid var(--line);
  box-shadow: var(--shadow-3);
  z-index: 160;
  transform: translateX(100%);
  transition: transform .36s var(--ease-out);
  display: flex; flex-direction: column;
}
.drawer.open { transform: none; }
.drawer-head { padding: var(--s-4); border-bottom: 1px solid var(--line-soft); display: flex; justify-content: space-between; align-items: center; }
.drawer-body { padding: var(--s-4); overflow-y: auto; flex: 1; }
.drawer-close {
  background: none; border: none; color: var(--paper-2);
  font-size: 20px; padding: 0; min-height: 32px; width: 32px;
}

/* ====== FAB · 浮动按钮 ======= */
.fab {
  position: fixed;
  right: max(20px, env(safe-area-inset-right));
  bottom: max(20px, env(safe-area-inset-bottom));
  width: var(--fab-size); height: var(--fab-size);
  border-radius: 50%;
  background: linear-gradient(180deg, var(--gold-2), var(--gold-3));
  color: var(--ink-1);
  border: none;
  font-size: 24px;
  cursor: pointer;
  box-shadow: 0 6px 24px var(--gold-glow);
  z-index: 100;
  display: inline-flex; align-items: center; justify-content: center;
  transition: transform .2s var(--ease-spring), box-shadow .2s var(--ease-out);
  animation: fab-pulse 3.6s var(--ease-out) infinite;
}
.fab:hover { transform: scale(1.06); box-shadow: 0 8px 32px var(--gold-glow); }
.fab:active { transform: scale(.95); }
.fab.pulse-out { animation: none; }
@keyframes fab-pulse {
  0%, 100% { box-shadow: 0 6px 24px var(--gold-glow), 0 0 0 0 var(--gold-glow); }
  50%      { box-shadow: 0 6px 24px var(--gold-glow), 0 0 0 14px transparent; }
}

/* ====== 横向滚动 Carousel（首屏低信息密度）====== */
.row-carousel {
  display: flex;
  gap: var(--s-3);
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-padding: 0 var(--s-4);
  padding: var(--s-2) 0 var(--s-4);
  margin: 0 calc(-1 * var(--s-4)) var(--s-4);
  padding-left: var(--s-4);
  padding-right: var(--s-4);
  scrollbar-width: thin;
  scrollbar-color: var(--line) transparent;
}
.row-carousel::-webkit-scrollbar { height: 4px; }
.row-carousel::-webkit-scrollbar-thumb { background: var(--line); border-radius: 2px; }
.row-carousel > * {
  flex: 0 0 220px;
  scroll-snap-align: start;
}

/* 工具类 */
.fx-reveal {
  opacity: 0;
  transform: translateY(14px);
  transition: opacity .7s var(--ease-out), transform .7s var(--ease-out);
}
.fx-reveal.in { opacity: 1; transform: none; }

.fx-num { font-variant-numeric: tabular-nums; font-family: var(--font-serif); }

/* 主按钮 hover 涟漪 */
.ripple {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  transform: scale(0);
  animation: ripple-out .6s var(--ease-out);
  pointer-events: none;
}
@keyframes ripple-out { to { transform: scale(4); opacity: 0; } }

/* ====== Student Hero · 学生端首屏 ======= */
.hero {
  position: relative;
  padding: var(--s-6);
  border: 1px solid var(--line);
  border-radius: var(--r-xl);
  background: var(--ink-glass);
  backdrop-filter: blur(10px) saturate(120%);
  -webkit-backdrop-filter: blur(10px) saturate(120%);
  box-shadow: var(--shadow-2);
  margin-bottom: var(--s-4);
  overflow: hidden;
  animation: rise .8s var(--ease-out) both;
}
.hero::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0; height: 1px;
  background: linear-gradient(90deg, transparent, var(--gold-glow-s), transparent);
}
.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--s-3);
  margin-bottom: var(--s-4);
}
.hero h1 { margin-bottom: 6px; }
.hero p { color: var(--paper-2); font-size: 14px; }
.student-badge {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 4px 12px;
  border: 1px solid var(--gold-3);
  border-radius: var(--r-pill);
  background: var(--gold-glow-xs);
  color: var(--gold-1);
  font-size: 12px;
  font-weight: 600;
  white-space: nowrap;
  flex: 0 0 auto;
}
.student-trust {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--s-2);
  margin: var(--s-4) 0;
}
.trust-item {
  padding: var(--s-3);
  border: 1px solid var(--line-soft);
  border-radius: var(--r-md);
  background: var(--ink-glass-2);
}
.trust-item strong {
  display: block;
  color: var(--gold-1);
  font-family: var(--font-serif);
  font-size: 14px;
  margin-bottom: 4px;
}
.trust-item span { color: var(--paper-2); font-size: 12.5px; line-height: 1.5; }

.steps {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: var(--s-2);
  margin: var(--s-4) 0;
}
.step {
  padding: var(--s-3);
  border: 1px solid var(--line-soft);
  border-radius: var(--r-md);
  background: var(--ink-glass-2);
  font-family: var(--font-serif);
  font-size: 13.5px;
  color: var(--paper-1);
  position: relative;
  transition: border-color var(--dur-base), transform var(--dur-base);
}
.step::before {
  content: "";
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 2px;
  background: linear-gradient(180deg, var(--gold-1), var(--gold-3));
  border-radius: 2px;
  opacity: 0;
  transition: opacity var(--dur-base);
}
.step:hover { border-color: var(--gold-glow-s); transform: translateX(2px); }
.step:hover::before { opacity: 1; }

.login-panel {
  margin-top: var(--s-3);
  padding: var(--s-4);
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  background: var(--ink-glass-2);
}
.login-form {
  display: grid;
  grid-template-columns: 1fr 1fr auto auto;
  gap: var(--s-2);
  align-items: end;
}
.login-form button { min-height: 42px; }
.login-meta {
  display: flex; flex-wrap: wrap;
  gap: var(--s-3);
  align-items: center;
  margin-top: var(--s-2);
}
.care-note {
  margin-top: var(--s-3);
  padding: var(--s-3);
  border-left: 3px solid var(--gold-3);
  background: rgba(232, 185, 92, 0.06);
  color: var(--paper-2);
  font-size: 12.5px;
  border-radius: 0 var(--r-sm) var(--r-sm) 0;
  line-height: 1.6;
}

/* ====== Today Overview（学生端）====== */
.today-overview {
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  background: var(--ink-glass);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  padding: var(--s-5);
  margin-bottom: var(--s-4);
}
.today-overview h2 { margin-bottom: 4px; }
.today-overview .hint { color: var(--paper-2); font-size: 13px; margin-bottom: var(--s-3); }
.today-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--s-3);
  margin-top: var(--s-3);
}
.today-cell {
  padding: var(--s-3) var(--s-4);
  border: 1px solid var(--line-soft);
  border-radius: var(--r-md);
  background: var(--ink-glass-2);
  transition: border-color var(--dur-base), transform var(--dur-base);
}
.today-cell:hover { border-color: var(--gold-glow-s); transform: translateY(-1px); }
.today-cell strong {
  display: block;
  font-family: var(--font-serif);
  font-size: 22px;
  color: var(--gold-1);
  margin-bottom: 2px;
}
.today-cell span { color: var(--paper-2); font-size: 12.5px; line-height: 1.5; }
.route-note {
  margin-top: var(--s-3);
  padding: var(--s-3) var(--s-4);
  border-left: 3px solid var(--gold-2);
  background: rgba(232, 185, 92, 0.06);
  color: var(--paper-1);
  font-size: 13px;
  border-radius: 0 var(--r-sm) var(--r-sm) 0;
}

.voice-list, .card-list, .history-list { display: grid; gap: var(--s-3); }
.voice-card, .knowledge-card {
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  background: var(--ink-glass-2);
  padding: var(--s-4);
  transition: border-color var(--dur-base), background var(--dur-base), transform var(--dur-base);
}
.knowledge-card { cursor: pointer; }
.knowledge-card:hover { border-color: var(--gold-glow-s); transform: translateY(-1px); }
.knowledge-card.open { background: var(--ink-3); }
.knowledge-card h3 { color: var(--gold-2); font-size: 14px; margin-bottom: 6px; }
.knowledge-card p { margin: 0; color: var(--paper-1); font-size: 14px; }
.answer {
  display: none;
  margin-top: var(--s-2);
  padding-top: var(--s-2);
  border-top: 1px dashed var(--line-soft);
  color: var(--paper-2);
  font-size: 13.5px;
}
.knowledge-card.open .answer { display: block; }

.target {
  display: flex; align-items: baseline; flex-wrap: wrap; gap: var(--s-2);
  margin-bottom: var(--s-2);
}
.target strong { font-family: var(--font-serif); font-size: 18px; color: var(--paper-1); }
.target span { color: var(--paper-2); font-size: 13px; }

.hold-button {
  min-height: 52px;
  background: linear-gradient(180deg, var(--gold-2), var(--gold-3));
  color: var(--ink-1);
  border: 1px solid var(--gold-2);
  font-weight: 600;
  flex: 1 1 180px;
  touch-action: none;
  user-select: none;
  position: relative;
  overflow: hidden;
}
.hold-button.recording {
  background: linear-gradient(180deg, #c66b5a, #a3524a);
  border-color: var(--err);
  color: var(--paper-1);
  animation: hold-pulse 1.4s var(--ease-out) infinite;
}
@keyframes hold-pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(212, 131, 106, .45); }
  50%      { box-shadow: 0 0 0 12px rgba(212, 131, 106, 0); }
}

.history-day {
  border: 1px solid var(--line-soft);
  border-radius: var(--r-md);
  background: var(--ink-glass-2);
  overflow: hidden;
}
.history-day summary {
  display: flex; align-items: center; justify-content: space-between;
  padding: var(--s-3) var(--s-4);
  cursor: pointer;
  font-weight: 600;
  list-style: none;
}
.history-day summary::-webkit-details-marker { display: none; }
.history-day summary::after { content: "+"; color: var(--gold-2); font-family: var(--font-serif); font-size: 20px; transition: transform .2s; }
.history-day[open] summary::after { content: "−"; }
.history-day summary span:first-child { color: var(--paper-1); font-family: var(--font-serif); }
.history-day summary span:last-child  { color: var(--paper-3); font-size: 12.5px; }
.history-body { padding: 0 var(--s-4) var(--s-4); border-top: 1px solid var(--line-soft); }
.history-card-list, .history-voice-list { display: grid; gap: var(--s-2); margin-top: var(--s-2); }
.history-voice-title { color: var(--gold-2); font-weight: 600; margin: var(--s-2) 0 0; font-family: var(--font-serif); font-size: 13px; }

.memory {
  background: rgba(232, 185, 92, 0.04);
  border-color: var(--gold-3);
}
.memory h2 { color: var(--gold-1); }
.memory p { color: var(--paper-1); font-family: var(--font-serif); font-size: 15px; line-height: 1.8; }

/* ====== 后台 · 模型 / 队列 ======= */
.workarea section {
  animation-delay: .1s;
}
.workarea .grid { margin-bottom: var(--s-4); }
.workarea .body { color: var(--paper-2); font-size: 13.5px; }

/* ====== 预览徽章 / Preview badge ======= */
.preview-badge {
  position: fixed;
  top: 70px;
  left: max(20px, env(safe-area-inset-left));
  padding: 6px 12px;
  border: 1px solid var(--gold-3);
  border-radius: var(--r-pill);
  background: var(--ink-3);
  color: var(--gold-1);
  font-size: 12px;
  z-index: 90;
  display: inline-flex; align-items: center; gap: 6px;
  box-shadow: var(--shadow-amber);
  animation: rise .6s var(--ease-out) .3s both;
}
.preview-badge::before {
  content: "";
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--gold-2);
  box-shadow: 0 0 6px var(--gold-glow);
  animation: pulse 1.6s var(--ease-out) infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50%      { opacity: .3; }
}

/* ====== 滚动行为 ======= */
html { scroll-behavior: smooth; }

/* ====== 焦点环 ======= */
:focus-visible { outline: 2px solid var(--gold-1); outline-offset: 2px; border-radius: 4px; }

/* ====== 安全区适配 ======= */
header, .fab, .preview-badge { padding-left: env(safe-area-inset-left); padding-right: env(safe-area-inset-right); }

/* ============================================================
   v7 新增组件
   ============================================================ */

/* ====== 真实台灯组件（v7 关键）====== */
.xueji-lamp {
  position: fixed;
  top: 6px;
  right: clamp(16px, 3vw, 36px);
  width: 96px;
  height: 110px;
  z-index: 30;
  pointer-events: auto;
  cursor: pointer;
  user-select: none;
  -webkit-tap-highlight-color: transparent;
  transition: transform var(--dur-base) var(--ease-out);
  filter: drop-shadow(0 4px 8px rgba(0,0,0,.4));
}
.xueji-lamp:hover { transform: translateY(-2px) rotate(-2deg); }
.xueji-lamp:active { transform: translateY(0) rotate(0); }
.xueji-lamp svg { width: 100%; height: 100%; overflow: visible; }

/* 灯罩金属渐变 */
.xueji-lamp .lamp-shade {
  fill: url(#lampShadeGrad);
  stroke: var(--gold-4);
  stroke-width: 1;
  filter: drop-shadow(0 0 6px var(--gold-glow));
  transition: filter var(--dur-base);
}
.xueji-lamp:hover .lamp-shade { filter: drop-shadow(0 0 12px var(--gold-glow)); }
.xueji-lamp .lamp-rim   { fill: var(--gold-3); }
.xueji-lamp .lamp-base  { fill: url(#lampBaseGrad); stroke: var(--gold-4); stroke-width: 1; }
.xueji-lamp .lamp-arm   { stroke: var(--gold-3); stroke-width: 5; stroke-linecap: round; fill: none; }
.xueji-lamp .lamp-joint { fill: var(--gold-2); stroke: var(--gold-4); stroke-width: 1; }

/* 灯泡（灯亮时） */
.xueji-lamp .lamp-bulb {
  fill: var(--gold-1);
  filter: drop-shadow(0 0 10px var(--gold-glow));
  animation: lamp-bulb-glow 3.4s var(--ease-out) infinite;
}
@keyframes lamp-bulb-glow {
  0%, 100% { opacity: 1;   filter: drop-shadow(0 0 10px var(--gold-glow)); }
  50%      { opacity: .82; filter: drop-shadow(0 0 18px var(--gold-glow)); }
}

/* 拉绳 */
.xueji-lamp .lamp-cord       { stroke: var(--gold-4); stroke-width: 1.2; fill: none; }
.xueji-lamp .lamp-cord-bead  { fill: var(--gold-2); stroke: var(--gold-4); stroke-width: 0.8; }
.xueji-lamp.lamp-pulling .lamp-cord,
.xueji-lamp.lamp-pulling .lamp-cord-bead {
  transform-origin: 60px 70px;
  animation: cord-swing .55s var(--ease-out);
}
@keyframes cord-swing {
  0%   { transform: rotate(0); }
  20%  { transform: rotate(18deg); }
  55%  { transform: rotate(-6deg); }
  100% { transform: rotate(0); }
}

/* 光锥（固定在 header 下方的金黄渐变锥） */
.xueji-lamp .lamp-cone {
  fill: url(#lampConeGrad);
  pointer-events: none;
  mix-blend-mode: screen;
  transform-origin: 50% 0%;
  animation: lamp-cone-sway 6.4s var(--ease-out) infinite;
}
@keyframes lamp-cone-sway {
  0%, 100% { transform: rotate(-1.2deg); }
  50%      { transform: rotate(1.2deg); }
}

/* 熄灯模式：灯泡灭、光锥隐、台灯去色 */
body.lamp-off .xueji-lamp .lamp-bulb { fill: var(--ink-4); filter: none; animation: none; }
body.lamp-off .xueji-lamp .lamp-shade { filter: drop-shadow(0 0 2px rgba(0,0,0,.5)); }
body.lamp-off .xueji-lamp .lamp-cone  { display: none; }
body.lamp-off .fx-bg::before { opacity: .15; }
body.lamp-off .fx-bg::after  { opacity: .4; }
body.lamp-off .fx-bg .ember  { display: none; }
body.lamp-off .fx-bg { background: var(--ink-0); }
body.lamp-off main, body.lamp-off header, body.lamp-off .workarea { filter: brightness(.92) saturate(.85); }

/* 熄灯提示 */
body.lamp-off::after {
  content: "夜深了，灯熄一盏，继续读也舒心。";
  position: fixed;
  bottom: 16px; left: 50%;
  transform: translateX(-50%);
  z-index: 40;
  padding: 6px 14px;
  border-radius: var(--r-pill);
  background: rgba(12, 10, 8, 0.85);
  border: 1px solid var(--line);
  color: var(--paper-2);
  font-size: 12px;
  font-family: var(--font-serif);
  letter-spacing: .05em;
  opacity: 0;
  animation: lamp-off-hint 6s var(--ease-out) forwards;
}
@keyframes lamp-off-hint {
  0%   { opacity: 0; transform: translateX(-50%) translateY(8px); }
  15%  { opacity: 1; transform: translateX(-50%) translateY(0); }
  85%  { opacity: 1; }
  100% { opacity: 0; transform: translateX(-50%) translateY(-4px); }
}

/* ====== 光标追光（桌面 + 细指针）====== */
.xueji-cursor {
  position: fixed;
  top: 0; left: 0;
  width: 360px; height: 360px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(207, 168, 107, 0.10) 0%, transparent 60%);
  pointer-events: none;
  z-index: 5;
  transform: translate(-50%, -50%);
  transition: opacity var(--dur-base);
  opacity: 0;
  mix-blend-mode: screen;
}
.xueji-cursor.is-on { opacity: 1; }
body.lamp-off .xueji-cursor { opacity: 0 !important; }

/* ====== 磁吸按钮（v7 加在主按钮上）====== */
button.primary { transform-style: preserve-3d; }

/* ====== 字符渐显 · 标题分字入场 ======= */
.title-letters {
  display: inline-block;
  overflow: hidden;
  vertical-align: bottom;
}
.title-letters > span {
  display: inline-block;
  opacity: 0;
  transform: translateY(.7em) rotate(6deg);
  animation: letter-rise .8s var(--ease-out) forwards;
}
@keyframes letter-rise {
  to { opacity: 1; transform: translateY(0) rotate(0); }
}

/* ====== 文房五色 · 分布式上色（打破单调）====== */
/* 3 张特点卡（trust-strip）— 大色块底色 + 左侧彩条 + 顶部彩条 */
.trust-strip {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--s-2);
  margin: var(--s-3) 0 var(--s-4);
}
.trust-strip > :nth-child(1) {
  border-top: 4px solid var(--c-indigo);
  border-left: 4px solid var(--c-indigo);
  background:
    linear-gradient(135deg, rgba(122,147,173,.22) 0%, rgba(122,147,173,.04) 70%, transparent 100%),
    var(--ink-glass-2);
  box-shadow: inset 4px 0 0 var(--c-indigo), 0 1px 0 rgba(122,147,173,.25) inset;
}
.trust-strip > :nth-child(2) {
  border-top: 4px solid var(--c-bamboo);
  border-left: 4px solid var(--c-bamboo);
  background:
    linear-gradient(135deg, rgba(138,168,143,.22) 0%, rgba(138,168,143,.04) 70%, transparent 100%),
    var(--ink-glass-2);
  box-shadow: inset 4px 0 0 var(--c-bamboo), 0 1px 0 rgba(138,168,143,.25) inset;
}
.trust-strip > :nth-child(3) {
  border-top: 4px solid var(--c-cinnabar);
  border-left: 4px solid var(--c-cinnabar);
  background:
    linear-gradient(135deg, rgba(201,123,99,.22) 0%, rgba(201,123,99,.04) 70%, transparent 100%),
    var(--ink-glass-2);
  box-shadow: inset 4px 0 0 var(--c-cinnabar), 0 1px 0 rgba(201,123,99,.25) inset;
}
.trust-strip > :nth-child(1) strong { color: var(--c-indigo); }
.trust-strip > :nth-child(2) strong { color: var(--c-bamboo); }
.trust-strip > :nth-child(3) strong { color: var(--c-cinnabar); }

/* 5 步学习流（student steps） */
.steps .step:nth-child(1)::before { background: linear-gradient(180deg, var(--c-indigo), var(--c-ink)); }
.steps .step:nth-child(2)::before { background: linear-gradient(180deg, var(--c-bamboo), var(--c-ink)); }
.steps .step:nth-child(3)::before { background: linear-gradient(180deg, var(--gold-1), var(--gold-3)); }
.steps .step:nth-child(4)::before { background: linear-gradient(180deg, var(--c-rose), var(--c-cinnabar)); }
.steps .step:nth-child(5)::before { background: linear-gradient(180deg, var(--c-cinnabar), var(--gold-4)); }
.steps .step[data-active="1"] {
  border-color: var(--c-indigo);
  background: linear-gradient(135deg, rgba(122,147,173,.15), transparent 70%), var(--ink-3);
}
.steps .step[data-active="2"] {
  border-color: var(--c-bamboo);
  background: linear-gradient(135deg, rgba(138,168,143,.15), transparent 70%), var(--ink-3);
}
.steps .step[data-active="3"] {
  border-color: var(--gold-2);
  background: linear-gradient(135deg, rgba(207,168,107,.15), transparent 70%), var(--ink-3);
}
.steps .step[data-active="4"] {
  border-color: var(--c-rose);
  background: linear-gradient(135deg, rgba(176,138,143,.15), transparent 70%), var(--ink-3);
}
.steps .step[data-active="5"] {
  border-color: var(--c-cinnabar);
  background: linear-gradient(135deg, rgba(201,123,99,.15), transparent 70%), var(--ink-3);
}

/* 3 今日数据格（today-cell）— 大色块 + 数字着色 */
.today-grid > :nth-child(1) {
  border-left: 5px solid var(--c-indigo);
  background:
    linear-gradient(135deg, rgba(122,147,173,.20) 0%, rgba(122,147,173,.04) 60%, transparent 100%),
    var(--ink-glass-2);
  box-shadow: inset 5px 0 0 var(--c-indigo);
}
.today-grid > :nth-child(2) {
  border-left: 5px solid var(--c-bamboo);
  background:
    linear-gradient(135deg, rgba(138,168,143,.20) 0%, rgba(138,168,143,.04) 60%, transparent 100%),
    var(--ink-glass-2);
  box-shadow: inset 5px 0 0 var(--c-bamboo);
}
.today-grid > :nth-child(3) {
  border-left: 5px solid var(--c-cinnabar);
  background:
    linear-gradient(135deg, rgba(201,123,99,.20) 0%, rgba(201,123,99,.04) 60%, transparent 100%),
    var(--ink-glass-2);
  box-shadow: inset 5px 0 0 var(--c-cinnabar);
}
.today-grid > :nth-child(1) strong { color: var(--c-indigo); }
.today-grid > :nth-child(2) strong { color: var(--c-bamboo); }
.today-grid > :nth-child(3) strong { color: var(--c-cinnabar); }

/* 后台 ops-card 4 步 — 大色块底色 */
.ops-grid > :nth-child(1) {
  border-left: 5px solid var(--c-indigo);
  background:
    linear-gradient(135deg, rgba(122,147,173,.18) 0%, rgba(122,147,173,.04) 60%, transparent 100%),
    var(--ink-glass-2);
  box-shadow: inset 5px 0 0 var(--c-indigo);
}
.ops-grid > :nth-child(2) {
  border-left: 5px solid var(--c-bamboo);
  background:
    linear-gradient(135deg, rgba(138,168,143,.18) 0%, rgba(138,168,143,.04) 60%, transparent 100%),
    var(--ink-glass-2);
  box-shadow: inset 5px 0 0 var(--c-bamboo);
}
.ops-grid > :nth-child(3) {
  border-left: 5px solid var(--gold-2);
  background:
    linear-gradient(135deg, rgba(207,168,107,.18) 0%, rgba(207,168,107,.04) 60%, transparent 100%),
    var(--ink-glass-2);
  box-shadow: inset 5px 0 0 var(--gold-2);
}
.ops-grid > :nth-child(4) {
  border-left: 5px solid var(--c-rose);
  background:
    linear-gradient(135deg, rgba(176,138,143,.18) 0%, rgba(176,138,143,.04) 60%, transparent 100%),
    var(--ink-glass-2);
  box-shadow: inset 5px 0 0 var(--c-rose);
}

/* 后台 5 tab 用 5 色描边 */
.tabs button:nth-child(1).active { border-bottom-color: var(--c-indigo); color: var(--c-indigo); }
.tabs button:nth-child(2).active { border-bottom-color: var(--c-bamboo); color: var(--c-bamboo); }
.tabs button:nth-child(3).active { border-bottom-color: var(--gold-2);  color: var(--gold-1); }
.tabs button:nth-child(4).active { border-bottom-color: var(--c-rose);  color: var(--c-rose); }
.tabs button:nth-child(5).active { border-bottom-color: var(--c-cinnabar); color: var(--c-cinnabar); }

/* 学生 hero 三个特色 */
.student-trust > :nth-child(1) {
  border-left: 5px solid var(--c-indigo);
  background: linear-gradient(135deg, rgba(122,147,173,.18), transparent 70%), var(--ink-glass-2);
  box-shadow: inset 5px 0 0 var(--c-indigo);
}
.student-trust > :nth-child(2) {
  border-left: 5px solid var(--c-bamboo);
  background: linear-gradient(135deg, rgba(138,168,143,.18), transparent 70%), var(--ink-glass-2);
  box-shadow: inset 5px 0 0 var(--c-bamboo);
}
.student-trust > :nth-child(3) {
  border-left: 5px solid var(--c-cinnabar);
  background: linear-gradient(135deg, rgba(201,123,99,.18), transparent 70%), var(--ink-glass-2);
  box-shadow: inset 5px 0 0 var(--c-cinnabar);
}
.student-trust > :nth-child(1) strong { color: var(--c-indigo); }
.student-trust > :nth-child(2) strong { color: var(--c-bamboo); }
.student-trust > :nth-child(3) strong { color: var(--c-cinnabar); }

/* ====== 标题字符渐显 ====== */

/* 表格状态色 */
.status-dot.dot-good     { color: var(--c-bamboo); }
.status-dot.dot-warn     { color: var(--gold-2); }
.status-dot.dot-err      { color: var(--c-cinnabar); }
.status-dot.dot-info     { color: var(--c-indigo); }

/* ====== 修家长端布局：登录卡不拉长 ======= */
.service-brief { align-items: start; }
.service-brief .auth-panel { align-self: start; height: auto; }

/* ====== 修字体溢出：徽章 / 工具条 ======= */
.preview-badge,
.status .pill,
.status .tag {
  max-width: min(340px, calc(100vw - 32px));
  white-space: normal;
  word-break: break-word;
  text-align: left;
  line-height: 1.4;
}

/* ====== 鼠标光斑（magnetic 已就位）====== */
.is-magnetic { transition: transform var(--dur-base) var(--ease-out); }

/* ====== 降级 · reduced motion ======= */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
    scroll-behavior: auto !important;
  }
  .fx-bg::before { animation: none; }
  .fx-bg .ember { display: none; }
  .fx-reveal { opacity: 1; transform: none; }
  .meter span::after { display: none; }
  button.primary::before { display: none; }
  .fab { animation: none; }
  .preview-badge::before { animation: none; }
  .hold-button.recording { animation: none; }
}

/* ====== 响应式 ======= */
@media (max-width: 1024px) {
  .service-brief { grid-template-columns: 1fr; }
  .auth-shell { grid-template-columns: 1fr; }
  .ops-brief { padding: var(--s-4) 0; }
  .section-guide, .ops-grid, .student-trust, .today-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .trust-strip { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}

@media (max-width: 720px) {
  header .top, header .topbar {
    flex-wrap: wrap;
    padding: 10px var(--s-3);
    gap: var(--s-2);
  }
  header h1 { font-size: 16px; }
  main { padding: 0 var(--s-3); }
  section { padding: var(--s-4); border-radius: var(--r-md); }
  .grid { grid-template-columns: 1fr; }
  .grid > .span2 { grid-column: span 1; }
  .auth-shell { grid-template-columns: 1fr; }
  .auth-panel { padding: var(--s-4); }
  .service-brief { grid-template-columns: 1fr; padding: var(--s-4) 0; }
  .brief-rail { font-size: 12.5px; }
  .section-guide, .ops-grid, .student-trust, .today-grid, .steps, .trust-strip {
    grid-template-columns: 1fr;
  }
  .student-list, .cards { grid-template-columns: 1fr; }
  .login-form { grid-template-columns: 1fr; }
  .login-form button { width: 100%; }
  .actions { flex-direction: column; }
  .actions button { width: 100%; }
  .tabs button, nav button { padding: 8px 10px; font-size: 13px; }
  .fab { width: 48px; height: 48px; font-size: 20px; right: 14px; bottom: 14px; }
  .preview-badge { top: 64px; font-size: 11px; padding: 4px 10px; }
  .row-carousel { padding-left: var(--s-3); padding-right: var(--s-3); margin: 0 calc(-1 * var(--s-3)) var(--s-3); }
  .row-carousel > * { flex: 0 0 200px; }
  .hero { padding: var(--s-4); border-radius: var(--r-md); }
  .hero-top { flex-direction: column; }
  .student-badge { align-self: flex-start; }
  .knowledge-card p { font-size: 14px; }
  .target strong { font-size: 16px; }
  .step { font-size: 13px; padding: 10px; }
}

@media (max-width: 420px) {
  :root { --container: 100%; }
  header .top .status, header .topbar .status { display: none; }
  h1 { font-size: 22px; }
  h2 { font-size: 18px; }
  .brief-copy h2 { font-size: 22px; }
  .ops-brief h2 { font-size: 22px; }
  .today-cell strong { font-size: 18px; }
  .student-trust .trust-item { padding: 10px; }
}

</style>
</head>
<body>
  <header>
    <div class="topbar">
      <div>
        <h1 data-title-letters>学记教育闭环后台</h1>
      </div>
      <div class="status">
        <span class="pill">服务 <strong id="serviceStatus">检查中</strong></span>
        <span class="pill">学生 <strong id="studentCount">0</strong></span>
        <span class="pill">待处理 <strong id="actionCount">0</strong></span>
      </div>
    </div>
  </header>

  <main>
    <nav>
      <button class="active" data-view="intake">初始建档</button>
      <button data-view="feedback">每日反馈</button>
      <button data-view="students">学生列表</button>
      <button data-view="actions">调整队列</button>
      <button data-view="aiJobs">AI任务队列</button>
      <button data-view="detail">学生详情</button>
      <button data-view="voiceCheck">发音评测校准</button>
      <button data-view="knowledgeBase">学科知识库</button>
      <button data-view="parents">家长权益</button>
      <button data-view="models">模型配置</button>
    </nav>

    <div class="workarea">
      <div class="ops-brief">
        <h2>老师工作台</h2>
        <p>后台优先处理三件事：看学生风险、处理调整队列、发布前复核方案。AI 负责整理初稿，老师负责判断是否适合当前孩子。</p>
        <div class="ops-grid" aria-label="后台处理优先级">
          <div class="ops-card"><strong>先看风险</strong><span>学生列表和每日反馈里优先看抗拒、疲劳、未反馈和完成率低的学生。</span></div>
          <div class="ops-card"><strong>再处理队列</strong><span>调整队列用于判断是否减量、错卡回炉、研学保温或生成下一版。</span></div>
          <div class="ops-card"><strong>发布前确认</strong><span>方案、DOCX、权益和学生端状态确认后，再发给家长执行。</span></div>
        </div>
      </div>

      <section id="intake" class="active">
        <div class="section-head">
          <h2>初始建档</h2>
          <button class="secondary" id="fillSample">填入样例</button>
        </div>
        <div class="body split">
          <form id="intakeForm">
            <div class="grid">
              <div>
                <label for="student_name">学生称呼</label>
                <input id="student_name" name="student_name" placeholder="如：小陈">
              </div>
              <div>
                <label for="grade_region">年级/地区</label>
                <input id="grade_region" name="grade_region" placeholder="如：初一/湖南">
              </div>
              <div>
                <label for="goal">目标</label>
                <input id="goal" name="goal" placeholder="如：期末基础抢分">
              </div>
              <div>
                <label for="exam_date_text">最近考试时间</label>
                <input id="exam_date_text" name="exam_date_text" placeholder="如：2周后">
              </div>
              <div>
                <label for="time_budget">每天可用时间</label>
                <select id="time_budget" name="time_budget">
                  <option>5-10分钟</option>
                  <option selected>15-25分钟</option>
                  <option>30-40分钟</option>
                </select>
              </div>
              <div>
                <label for="cooperation">配合度</label>
                <select id="cooperation" name="cooperation">
                  <option>抗拒</option>
                  <option selected>一般</option>
                  <option>能接受</option>
                  <option>比较配合</option>
                </select>
              </div>
              <div class="span2">
                <label for="priority_subjects">优先科目/考试</label>
                <input id="priority_subjects" name="priority_subjects" placeholder="如：语文古诗、历史道法、英语基础词">
              </div>
              <div>
                <label for="difficulties">最大困难</label>
                <textarea id="difficulties" name="difficulties" placeholder="如：记不住、一问就慌、启动困难"></textarea>
              </div>
              <div>
                <label for="parent_support">家长能做什么</label>
                <textarea id="parent_support" name="parent_support" placeholder="如：每天微信问3张，拍照反馈"></textarea>
              </div>
              <div>
                <label for="evidence_summary">已有证据</label>
                <textarea id="evidence_summary" name="evidence_summary" placeholder="如：有错题照片、成绩单、已做卡片"></textarea>
              </div>
              <div>
                <label for="extra_notes">补充情况</label>
                <textarea id="extra_notes" name="extra_notes" placeholder="如：明后天研学，时间很碎"></textarea>
              </div>
            </div>
            <div class="actions">
              <button class="primary" type="submit">提交建档并生成V1</button>
              <button class="secondary" type="button" id="clearIntake">清空</button>
            </div>
          </form>
          <div>
            <pre id="intakeResult">等待提交建档。</pre>
          </div>
        </div>
      </section>

      <section id="feedback">
        <div class="section-head">
          <h2>每日反馈</h2>
          <button class="secondary" id="loadLatestStudent">使用最新学生</button>
        </div>
        <div class="body split">
          <form id="feedbackForm">
            <div class="grid three">
              <div>
                <label for="student_id">学生ID</label>
                <input id="student_id" name="student_id" type="number" min="1" required>
              </div>
              <div>
                <label for="feedback_date">反馈日期</label>
                <input id="feedback_date" name="feedback_date" type="date">
              </div>
              <div>
                <label for="day_mode">今天模式</label>
                <select id="day_mode" name="day_mode">
                  <option>正常</option>
                  <option>研学</option>
                  <option>疲劳</option>
                  <option>抗拒</option>
                </select>
              </div>
              <div>
                <label for="planned_cards">计划张数</label>
                <input id="planned_cards" name="planned_cards" type="number" min="0" value="3">
              </div>
              <div>
                <label for="completed_cards">完成张数</label>
                <input id="completed_cards" name="completed_cards" type="number" min="0" value="2">
              </div>
              <div>
                <label for="known_cards">会了几张</label>
                <input id="known_cards" name="known_cards" type="number" min="0" value="1">
              </div>
              <div class="span2">
                <label for="star_card_codes">★卡编号</label>
                <input id="star_card_codes" name="star_card_codes" placeholder="如：D1-03、D2-01">
              </div>
              <div>
                <label for="mood">情绪</label>
                <select id="mood" name="mood">
                  <option>轻松</option>
                  <option selected>能接受</option>
                  <option>有点烦</option>
                  <option>明显抗拒</option>
                </select>
              </div>
              <div>
                <label for="evidence_type">证据</label>
                <select id="evidence_type" name="evidence_type">
                  <option>无</option>
                  <option>照片</option>
                  <option>语音</option>
                  <option>视频</option>
                </select>
              </div>
              <div class="span2">
                <label for="parent_note">家长备注</label>
                <textarea id="parent_note" name="parent_note" placeholder="如：路上语音答了两张，第三张不太想答"></textarea>
              </div>
            </div>
            <div class="actions">
              <button class="primary" type="submit">提交反馈并生成建议</button>
            </div>
          </form>
          <div>
            <pre id="feedbackResult">等待提交反馈。</pre>
          </div>
        </div>
      </section>

      <section id="students">
        <div class="section-head">
          <div>
            <h2>学生列表</h2>
            <p class="section-helper">先看目标、当前档位、执行方式和最近状态；需要调整的学生再打开详情。</p>
          </div>
          <button class="secondary" id="refreshStudents">刷新</button>
        </div>
        <div class="body">
          <div id="studentCards" class="cards"></div>
        </div>
      </section>

      <section id="actions">
        <div class="section-head">
          <div>
            <h2>调整队列</h2>
            <p class="section-helper">这里是老师每天优先处理的入口：抗拒、疲劳、研学、错卡回炉和下一版方案都从这里确认。</p>
          </div>
          <button class="secondary" id="refreshActions">刷新</button>
        </div>
        <div class="body">
          <table>
            <thead>
              <tr>
                <th style="width: 82px;">优先级</th>
                <th style="width: 130px;">学生</th>
                <th>触发原因</th>
                <th>建议动作</th>
                <th style="width: 92px;">处理</th>
              </tr>
            </thead>
            <tbody id="actionsBody"></tbody>
          </table>
        </div>
      </section>

      <section id="aiJobs">
        <div class="section-head">
          <h2>AI任务队列</h2>
          <div class="actions" style="margin:0;">
            <select id="aiJobStatus" style="width:140px;">
              <option value="all">全部任务</option>
              <option value="queued">排队中</option>
              <option value="running">生成中</option>
              <option value="error">失败/已取消</option>
              <option value="success">已完成</option>
            </select>
            <button class="secondary" id="refreshAiJobs">刷新</button>
          </div>
        </div>
        <div class="body">
          <table>
            <thead>
              <tr>
                <th style="width:70px;">ID</th>
                <th style="width:95px;">状态</th>
                <th>家长/学生</th>
                <th style="width:130px;">任务</th>
                <th>备注/错误</th>
                <th style="width:150px;">时间</th>
                <th style="width:130px;">处理</th>
              </tr>
            </thead>
            <tbody id="aiJobsBody"></tbody>
          </table>
          <p class="helper">排队中的任务可以取消；失败或已取消的任务可以重新排队。正在生成的任务不强制中断，避免结果刚好返回时被打断。</p>
        </div>
      </section>

      <section id="detail">
        <div class="section-head">
          <div>
            <h2>学生详情</h2>
            <p class="section-helper">发布前先核对档案、当前方案、反馈时间线、DOCX 文件和学生端可见状态。</p>
          </div>
          <div class="actions" style="margin:0;">
            <input id="detailStudentId" type="number" min="1" placeholder="学生ID" style="width:120px;">
            <button class="secondary" id="loadDetail">查看</button>
            <button class="secondary" id="createNextPlan">生成V2</button>
            <button class="secondary" id="publishCurrentPlan">发布当前方案</button>
            <button class="secondary" id="makeWeeklyReport">周反馈</button>
            <button class="secondary" id="bindCurrentDocx">上传并绑定DOCX</button>
            <input id="currentDocxFile" type="file" accept=".docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document" hidden>
            <button class="secondary" id="openCurrentFile">打开文件</button>
            <button class="secondary" id="copyCurrentFile">复制链接</button>
          </div>
        </div>
        <div class="body">
          <div class="grid three" style="margin-bottom:14px;">
            <div>
              <label for="student_account_phone">学生手机号</label>
              <input id="student_account_phone" autocomplete="tel" inputmode="numeric" placeholder="账号不存在时需填写">
            </div>
            <div>
              <label for="student_new_password">学生新密码</label>
              <input id="student_new_password" type="password" autocomplete="new-password" minlength="8" maxlength="64" placeholder="至少8位，含字母和数字">
            </div>
            <div>
              <label>学生端账号</label>
              <button class="warn" id="resetStudentPassword">重置学生密码</button>
              <div class="helper">会清掉旧学生登录态；学生下次用新密码登录。</div>
            </div>
          </div>
          <pre id="detailResult">输入学生ID查看档案、当前方案、反馈和调整动作。</pre>
          <table style="margin-top:14px;">
            <thead>
              <tr>
                <th style="width:110px;">依据类型</th>
                <th>标题/范围</th>
                <th>匹配原因</th>
                <th style="width:90px;">来源</th>
              </tr>
            </thead>
            <tbody id="planEvidenceRefsBody">
              <tr><td colspan="4" class="muted">查看学生后显示当前方案引用的课标、资源、知识点和真题考法。</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section id="voiceCheck">
        <div class="section-head">
          <h2>发音评测校准</h2>
          <button class="secondary" id="refreshVoiceSamples">刷新样本</button>
        </div>
        <div class="body">
          <div class="helper">只给老师后台使用：上传一段真实录音，或直接选最近一条系统里已有的真实录音，快速验收讯飞评测链路。本页不写入学生记录。</div>
          <div class="grid three" style="margin-top:14px;">
            <div class="span2">
              <label for="voice_sample_id">最近真实录音</label>
              <select id="voice_sample_id">
                <option value="">手动上传一段音频</option>
              </select>
            </div>
            <div>
              <label for="voice_student_id">学生ID（可选）</label>
              <input id="voice_student_id" type="number" min="1" placeholder="用于显示次数">
            </div>
            <div>
              <label for="voice_target_type">题型</label>
              <select id="voice_target_type">
                <option value="word">单词</option>
                <option value="phrase">短语</option>
                <option value="sentence" selected>句子</option>
              </select>
            </div>
            <div class="span2">
              <label for="voice_target_text">目标文本</label>
              <input id="voice_target_text" placeholder="例如 bike / ride a bike / I go to school by bike.">
            </div>
            <div class="span2">
              <label for="voice_transcript">兜底文本（可选）</label>
              <textarea id="voice_transcript" placeholder="如果讯飞不可用，且你希望看本地兜底分数，可补一段已知文本。"></textarea>
            </div>
            <div class="span2">
              <label for="voice_source_file">上传音频</label>
              <input id="voice_source_file" type="file" accept="audio/*">
            </div>
          </div>
          <div class="actions">
            <button class="primary" id="runVoiceAssessment">执行校准</button>
            <button class="secondary" id="clearVoiceAssessment">清空</button>
          </div>
          <div class="helper" id="voiceSampleHint">请选择一条样本，或上传一段录音。选择样本会自动带出学生ID、题型和目标文本。</div>
          <pre id="voiceAssessmentResult" style="margin-top:14px;">等待选择录音并执行校准。</pre>
        </div>
      </section>

      <section id="knowledgeBase">
        <div class="section-head">
          <div>
            <h2>学科知识库</h2>
            <p class="section-helper">先沉淀课标、教材、真题和老师整理的高频考点；AI生成计划时会优先引用这些依据。</p>
          </div>
          <button class="secondary" id="refreshKnowledgeResources">刷新</button>
        </div>
        <div class="body">
          <div class="grid three">
            <div>
              <label for="kb_title">资源标题</label>
              <input id="kb_title" placeholder="如：七下英语期末高频：一般过去时">
            </div>
            <div>
              <label for="kb_source_type">类型</label>
              <select id="kb_source_type">
                <option value="official_platform">官方平台</option>
                <option value="curriculum_standard">课标</option>
                <option value="textbook_reference">教材</option>
                <option value="exam_pattern">真题/考频</option>
                <option value="teacher_curated">老师整理</option>
              </select>
            </div>
            <div>
              <label for="kb_authority_level">可信级别</label>
              <select id="kb_authority_level">
                <option value="official">官方</option>
                <option value="publisher">出版社</option>
                <option value="teacher_curated" selected>老师整理</option>
                <option value="reference">参考</option>
              </select>
            </div>
            <div>
              <label for="kb_subject">学科</label>
              <input id="kb_subject" placeholder="英语/生物/历史/全科">
            </div>
            <div>
              <label for="kb_grade">年级</label>
              <input id="kb_grade" placeholder="七下/义务教育">
            </div>
            <div>
              <label for="kb_region">地区</label>
              <input id="kb_region" placeholder="全国/湖南/本校">
            </div>
            <div>
              <label for="kb_textbook_version">教材版本</label>
              <input id="kb_textbook_version" placeholder="人教版/译林版/待确认">
            </div>
            <div class="span2">
              <label for="kb_url">来源链接</label>
              <input id="kb_url" placeholder="https://...">
            </div>
            <div class="span2">
              <label for="kb_summary">摘要/考点说明</label>
              <textarea id="kb_summary" placeholder="写清楚适用范围、常考题型、答题关键词、易错点。不要粘贴整本教材或整套试卷。"></textarea>
            </div>
            <div>
              <label for="kb_tags">标签</label>
              <textarea id="kb_tags" placeholder="七下,英语,期末,一般过去时"></textarea>
            </div>
          </div>
          <div class="actions">
            <button class="primary" id="saveKnowledgeResource">保存资源</button>
            <button class="secondary" id="clearKnowledgeResource">清空</button>
          </div>
          <div class="grid three" style="margin-top:14px;">
            <div>
              <label for="kb_search">搜索</label>
              <input id="kb_search" placeholder="学科/年级/考点/来源">
            </div>
            <div>
              <label for="kb_filter_subject">筛选学科</label>
              <input id="kb_filter_subject" placeholder="英语">
            </div>
            <div>
              <label for="kb_filter_grade">筛选年级</label>
              <input id="kb_filter_grade" placeholder="七下">
            </div>
          </div>
          <table style="margin-top:14px;">
            <thead>
              <tr>
                <th style="width:70px;">ID</th>
                <th>资源</th>
                <th style="width:150px;">范围</th>
                <th>摘要</th>
                <th style="width:90px;">级别</th>
              </tr>
            </thead>
            <tbody id="knowledgeResourcesBody"></tbody>
          </table>
          <pre id="knowledgeResourceResult" style="margin-top:14px;">知识库会先保存官方资源入口；老师整理的考点和真题规律会逐步补齐。</pre>

          <div class="section-head" style="margin:16px -16px 0;">
            <div>
              <h2>知识点索引</h2>
              <p class="section-helper">把教材单元、课标要求、常见错法和记忆提示拆成可复用的小条目；生成学习计划时优先匹配这些点。</p>
            </div>
            <button class="secondary" id="refreshKnowledgePoints">刷新知识点</button>
          </div>
          <div class="grid three" style="margin-top:14px;">
            <div>
              <label for="kp_resource_id">资源ID</label>
              <input id="kp_resource_id" type="number" min="1" placeholder="可选，关联上方资源">
            </div>
            <div>
              <label for="kp_subject">学科</label>
              <input id="kp_subject" placeholder="英语/生物/历史">
            </div>
            <div>
              <label for="kp_grade">年级</label>
              <input id="kp_grade" placeholder="七下/高三">
            </div>
            <div>
              <label for="kp_textbook_version">教材版本</label>
              <input id="kp_textbook_version" placeholder="人教版/译林版/待确认">
            </div>
            <div>
              <label for="kp_unit_name">单元/模块</label>
              <input id="kp_unit_name" placeholder="Unit 11 / 第四单元">
            </div>
            <div>
              <label for="kp_importance">重要性</label>
              <select id="kp_importance">
                <option value="high">高频/必抓</option>
                <option value="normal" selected>常规</option>
                <option value="low">低频</option>
              </select>
            </div>
            <div>
              <label for="kp_point_name">知识点</label>
              <input id="kp_point_name" placeholder="一般过去时 Did 问句">
            </div>
            <div>
              <label for="kp_requirement_level">要求层级</label>
              <input id="kp_requirement_level" placeholder="了解/理解/掌握/运用">
            </div>
            <div class="span2">
              <label for="kp_common_errors">常见错法</label>
              <textarea id="kp_common_errors" placeholder="学生常错在哪里；哪些去年考过可少放，哪些每年都考要重复复背。"></textarea>
            </div>
            <div>
              <label for="kp_memory_hint">记忆提示</label>
              <textarea id="kp_memory_hint" placeholder="短句、口诀、辨析提示，不粘贴教材大段原文。"></textarea>
            </div>
          </div>
          <div class="actions">
            <button class="primary" id="saveKnowledgePoint">保存知识点</button>
            <button class="secondary" id="clearKnowledgePoint">清空</button>
          </div>
          <div class="grid three" style="margin-top:14px;">
            <div>
              <label for="kp_search">搜索知识点</label>
              <input id="kp_search" placeholder="单元/知识点/易错/提示">
            </div>
            <div>
              <label for="kp_filter_subject">筛选学科</label>
              <input id="kp_filter_subject" placeholder="英语">
            </div>
            <div>
              <label for="kp_filter_grade">筛选年级</label>
              <input id="kp_filter_grade" placeholder="七下">
            </div>
          </div>
          <table style="margin-top:14px;">
            <thead>
              <tr>
                <th style="width:70px;">ID</th>
                <th style="width:120px;">范围</th>
                <th>知识点</th>
                <th>常见错法/提示</th>
                <th style="width:90px;">重要性</th>
              </tr>
            </thead>
            <tbody id="knowledgePointsBody"></tbody>
          </table>
          <pre id="knowledgePointResult" style="margin-top:14px;">知识点用于让计划不只按年级匹配，还能按学生错法和考点精确命中。</pre>

          <div class="section-head" style="margin:16px -16px 0;">
            <div>
              <h2>真题题型/考法</h2>
              <p class="section-helper">记录历年常考题型、答题要点和来源；计划生成时会把“每年都考”和“近期高频”的依据带进去。</p>
            </div>
            <button class="secondary" id="refreshExamPatterns">刷新题型</button>
          </div>
          <div class="grid three" style="margin-top:14px;">
            <div>
              <label for="ep_knowledge_point_id">知识点ID</label>
              <input id="ep_knowledge_point_id" type="number" min="1" placeholder="可选，关联上方知识点">
            </div>
            <div>
              <label for="ep_resource_id">资源ID</label>
              <input id="ep_resource_id" type="number" min="1" placeholder="可选，关联资源">
            </div>
            <div>
              <label for="ep_frequency_level">考频</label>
              <select id="ep_frequency_level">
                <option value="must">每年必抓</option>
                <option value="high" selected>高频</option>
                <option value="medium">中频</option>
                <option value="low">低频</option>
                <option value="unknown">待确认</option>
              </select>
            </div>
            <div>
              <label for="ep_subject">学科</label>
              <input id="ep_subject" placeholder="英语/生物/历史">
            </div>
            <div>
              <label for="ep_grade">年级</label>
              <input id="ep_grade" placeholder="七下/高三">
            </div>
            <div>
              <label for="ep_region">地区</label>
              <input id="ep_region" placeholder="全国/湖南/本校">
            </div>
            <div>
              <label for="ep_exam_scope">考试范围</label>
              <input id="ep_exam_scope" placeholder="期末/中考/高考/单元测">
            </div>
            <div>
              <label for="ep_year_text">年份说明</label>
              <input id="ep_year_text" placeholder="2022-2026常考/近三年">
            </div>
            <div>
              <label for="ep_question_type">题型</label>
              <input id="ep_question_type" placeholder="句型问答/材料分析/实验探究">
            </div>
            <div class="span2">
              <label for="ep_pattern_text">题型/例题模式</label>
              <textarea id="ep_pattern_text" placeholder="用自己的话概括题型模式、设问方式、常见陷阱。"></textarea>
            </div>
            <div>
              <label for="ep_answer_points">答题要点</label>
              <textarea id="ep_answer_points" placeholder="关键词、步骤、评分点。"></textarea>
            </div>
            <div class="span2">
              <label for="ep_source_url">来源链接</label>
              <input id="ep_source_url" placeholder="https://...">
            </div>
          </div>
          <div class="actions">
            <button class="primary" id="saveExamPattern">保存题型</button>
            <button class="secondary" id="clearExamPattern">清空</button>
          </div>
          <div class="grid three" style="margin-top:14px;">
            <div>
              <label for="ep_search">搜索题型</label>
              <input id="ep_search" placeholder="题型/考点/答题点/来源">
            </div>
            <div>
              <label for="ep_filter_subject">筛选学科</label>
              <input id="ep_filter_subject" placeholder="英语">
            </div>
            <div>
              <label for="ep_filter_grade">筛选年级</label>
              <input id="ep_filter_grade" placeholder="七下">
            </div>
          </div>
          <table style="margin-top:14px;">
            <thead>
              <tr>
                <th style="width:70px;">ID</th>
                <th style="width:120px;">范围</th>
                <th style="width:110px;">题型</th>
                <th>模式/答题点</th>
                <th style="width:90px;">考频</th>
              </tr>
            </thead>
            <tbody id="examPatternsBody"></tbody>
          </table>
          <pre id="examPatternResult" style="margin-top:14px;">题型库用于让知识卡生成时兼顾课标、教材和历年真题规律。</pre>

          <div class="section-head" style="margin:16px -16px 0;">
            <div>
              <h2>资源覆盖率</h2>
              <p class="section-helper">按 K12 年级/学科统计资源、知识点和题型数量；优先补 seed 和 empty 的范围。</p>
            </div>
            <button class="secondary" id="refreshLearningCoverage">刷新覆盖率</button>
          </div>
          <div class="grid three" style="margin-top:14px;">
            <div>
              <label for="coverage_stage">学段</label>
              <select id="coverage_stage">
                <option value="">全部</option>
                <option value="小学">小学</option>
                <option value="初中">初中</option>
                <option value="高中">高中</option>
              </select>
            </div>
            <div>
              <label for="coverage_grade">年级</label>
              <input id="coverage_grade" placeholder="七下/高三">
            </div>
            <div>
              <label for="coverage_subject">学科</label>
              <input id="coverage_subject" placeholder="英语/物理">
            </div>
          </div>
          <table style="margin-top:14px;">
            <thead>
              <tr>
                <th style="width:80px;">状态</th>
                <th style="width:80px;">学段</th>
                <th style="width:90px;">年级</th>
                <th style="width:90px;">学科</th>
                <th>数量</th>
                <th>下一步</th>
              </tr>
            </thead>
            <tbody id="learningCoverageBody"></tbody>
          </table>
          <pre id="learningCoverageResult" style="margin-top:14px;">ready=已有知识点和题型；partial=缺一边；seed=只有通用资源入口；empty=还没有任何可用依据。</pre>
          <table style="margin-top:14px;">
            <thead>
              <tr>
                <th style="width:86px;">优先级</th>
                <th style="width:120px;">范围</th>
                <th style="width:120px;">任务</th>
                <th>要补什么</th>
                <th style="width:150px;">当前数量</th>
              </tr>
            </thead>
            <tbody id="learningCollectionTasksBody">
              <tr><td colspan="5" class="muted">覆盖率刷新后显示待采集队列。</td></tr>
            </tbody>
          </table>
          <pre id="learningCollectionTasksResult" style="margin-top:14px;">待采集队列从 partial、seed、empty 自动生成，用来安排下一批资料入库。</pre>
          <div class="actions">
            <button class="primary" id="syncCollectionTasks">保存当前缺口为任务</button>
            <button class="secondary" id="refreshCollectionTaskRecords">刷新已保存任务</button>
            <select id="collection_task_status_filter" style="width:150px;">
              <option value="todo">待采集</option>
              <option value="doing">采集中</option>
              <option value="review">待审核</option>
              <option value="blocked">需复查</option>
              <option value="done">已完成</option>
              <option value="all">全部</option>
            </select>
          </div>
          <div class="grid three" style="margin-top:14px;">
            <div>
              <label for="collection_task_id">任务ID</label>
              <input id="collection_task_id" type="number" min="1" placeholder="点击下方任务回填">
            </div>
            <div>
              <label for="collection_task_status">状态</label>
              <select id="collection_task_status">
                <option value="todo">待采集</option>
                <option value="doing">采集中</option>
                <option value="review">待审核</option>
                <option value="blocked">需复查</option>
                <option value="done">已完成</option>
              </select>
            </div>
            <div>
              <label for="collection_task_assignee">负责人</label>
              <input id="collection_task_assignee" placeholder="老师/采集人">
            </div>
            <div class="span2">
              <label for="collection_task_source_url">来源URL</label>
              <input id="collection_task_source_url" placeholder="https://...">
            </div>
            <div>
              <label for="collection_task_review_note">审核备注</label>
              <textarea id="collection_task_review_note" placeholder="来源是否可靠、是否已拆成资源/知识点/题型。"></textarea>
            </div>
          </div>
          <div class="actions">
            <button class="primary" id="saveCollectionTaskRecord">保存审核状态</button>
          </div>
          <table style="margin-top:14px;">
            <thead>
              <tr>
                <th style="width:64px;">ID</th>
                <th style="width:90px;">状态</th>
                <th style="width:120px;">范围</th>
                <th>任务</th>
                <th style="width:130px;">负责人/来源</th>
              </tr>
            </thead>
            <tbody id="collectionTaskRecordsBody">
              <tr><td colspan="5" class="muted">保存缺口后显示可审核的采集任务。</td></tr>
            </tbody>
          </table>
          <pre id="collectionTaskRecordResult" style="margin-top:14px;">采集任务完成后，再把资料拆入资源、知识点和题型库。</pre>

          <div class="section-head" style="margin:16px -16px 0;">
            <div>
              <h2>K12范围索引</h2>
              <p class="section-helper">这里不是具体考点，而是小学、初中、高中各年级各学科的检索骨架；后续教材、政策、真题和错题都挂到这个骨架下。</p>
            </div>
            <button class="secondary" id="refreshScopeIndex">刷新索引</button>
          </div>
          <div class="grid three" style="margin-top:14px;">
            <div>
              <label for="scope_stage">学段</label>
              <select id="scope_stage">
                <option value="">全部</option>
                <option value="小学">小学</option>
                <option value="初中">初中</option>
                <option value="高中">高中</option>
              </select>
            </div>
            <div>
              <label for="scope_grade">年级</label>
              <input id="scope_grade" placeholder="一年级/七下/高三">
            </div>
            <div>
              <label for="scope_subject">学科</label>
              <input id="scope_subject" placeholder="语文/英语/物理">
            </div>
          </div>
          <table style="margin-top:14px;">
            <thead>
              <tr>
                <th style="width:80px;">学段</th>
                <th style="width:90px;">年级</th>
                <th style="width:90px;">学科</th>
                <th>资源类型</th>
                <th>计划用途</th>
              </tr>
            </thead>
            <tbody id="scopeIndexBody"></tbody>
          </table>
          <pre id="scopeIndexResult" style="margin-top:14px;">K12范围索引用于防止系统只围绕某个学生或某个年级建库。</pre>
        </div>
      </section>

      <section id="parents">
        <div class="section-head">
          <h2>家长权益</h2>
          <button class="secondary" id="refreshParents">刷新</button>
        </div>
        <div class="body">
          <div class="grid three">
            <div>
              <label for="ent_parent_id">家长ID</label>
              <input id="ent_parent_id" type="number" min="1">
            </div>
            <div>
              <label for="ent_plan_name">套餐</label>
              <select id="ent_plan_name">
                <option value="trial">7天试用</option>
                <option value="monthly">月卡</option>
                <option value="quarterly">季卡</option>
                <option value="annual">年卡</option>
                <option value="custom">自定义</option>
              </select>
              <div class="helper" id="entPresetHint">选择套餐后会自动带出有效期和额度。</div>
            </div>
            <div>
              <label for="ent_status">状态</label>
              <select id="ent_status">
                <option value="active">active</option>
                <option value="paused">paused</option>
                <option value="disabled">disabled</option>
              </select>
            </div>
            <div>
              <label for="ent_expires">有效期</label>
              <input id="ent_expires" placeholder="YYYY-MM-DD">
            </div>
            <div>
              <label for="ent_usage_limit">AI额度</label>
              <input id="ent_usage_limit" type="number" min="0" placeholder="20">
            </div>
            <div>
              <label for="ent_usage_used">已用</label>
              <input id="ent_usage_used" type="number" min="0" placeholder="0">
            </div>
            <div>
              <label for="ent_apply_preset">套餐规则</label>
              <select id="ent_apply_preset">
                <option value="1">按套餐自动设置</option>
                <option value="0">只保存手动填写</option>
              </select>
            </div>
            <div>
              <label for="ent_reset_usage">已用额度</label>
              <select id="ent_reset_usage">
                <option value="1">开通时清零</option>
                <option value="0">保留当前已用</option>
              </select>
            </div>
            <div>
              <label for="parent_new_password">家长新密码</label>
              <input id="parent_new_password" type="password" autocomplete="new-password" minlength="8" maxlength="64" placeholder="至少8位，含字母和数字">
            </div>
          </div>
          <div class="actions">
            <button class="primary" id="saveEntitlement">保存权益</button>
            <button class="warn" id="resetParentPassword">重置家长密码</button>
          </div>
          <pre id="parentPasswordResult" style="margin-top:14px;">选中家长后，可由管理员重置登录密码。</pre>
          <table style="margin-top:14px;">
            <thead>
              <tr>
                <th style="width:80px;">ID</th>
                <th>家长</th>
                <th>套餐</th>
                <th>有效期</th>
                <th>额度</th>
                <th>学生</th>
                <th>状态</th>
              </tr>
            </thead>
            <tbody id="parentsBody"></tbody>
          </table>
        </div>
      </section>

      <section id="models">
        <div class="section-head">
          <h2>模型配置</h2>
          <button class="secondary" id="refreshModels">刷新</button>
        </div>
        <div class="body">
          <div class="grid three">
            <div>
              <label for="model_task_type">任务类型</label>
              <select id="model_task_type">
                <option value="initial_plan">初始学习规划</option>
                <option value="daily_feedback">每日反馈分析</option>
                <option value="followup">跟进建议</option>
                <option value="weekly_adjustment">周调整方案</option>
                <option value="card_generation">知识卡片生成</option>
              </select>
            </div>
            <div>
              <label for="model_provider">服务商</label>
              <input id="model_provider" placeholder="OpenAI / DeepSeek / 通义 / 自建网关">
            </div>
            <div>
              <label for="model_name">模型名</label>
              <input id="model_name" placeholder="如：gpt-4.1-mini">
            </div>
            <div class="span2">
              <label for="model_endpoint">Endpoint</label>
              <input id="model_endpoint" placeholder="https://api.example.com/v1/chat/completions">
            </div>
            <div>
              <label for="model_key_env">Key环境变量</label>
              <input id="model_key_env" placeholder="OPENAI_API_KEY">
            </div>
            <div>
              <label for="model_temperature">温度</label>
              <input id="model_temperature" type="number" step="0.1" min="0" max="2" value="0.2">
            </div>
            <div>
              <label for="model_enabled">启用</label>
              <select id="model_enabled">
                <option value="1">启用</option>
                <option value="0">停用</option>
              </select>
            </div>
          </div>
          <div class="actions">
            <button class="primary" id="saveModelConfig">保存模型配置</button>
            <button class="secondary" id="configureXiaomi">一键配置小米</button>
          </div>
          <table style="margin-top:14px;">
            <thead>
              <tr>
                <th>任务</th>
                <th>服务商</th>
                <th>模型</th>
                <th>Endpoint</th>
                <th>Key变量</th>
                <th>Key状态</th>
                <th>启用</th>
              </tr>
            </thead>
            <tbody id="modelsBody"></tbody>
          </table>
          <pre id="modelResult" style="margin-top:14px;">API Key 请写入服务器环境变量，不要填在网页里。</pre>
        </div>
      </section>
    </div>
  </main>

  <script>
    const $ = (id) => document.getElementById(id);
    const prefix = location.pathname.startsWith("/xueji") ? "/xueji" : "";
    let adminKey = localStorage.getItem("xueji_admin_key") || "";
    if (!adminKey && location.pathname.includes("/admin")) {
      adminKey = prompt("请输入老师后台口令") || "";
      if (adminKey) localStorage.setItem("xueji_admin_key", adminKey);
    }
    const api = async (path, options = {}) => {
      const response = await fetch(prefix + path, {
        headers: { "Content-Type": "application/json", "X-Admin-Key": adminKey },
        ...options
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || data.detail || "请求失败");
      return data;
    };

    const formJson = (form) => Object.fromEntries(new FormData(form).entries());
    const mainlandMobilePattern = /^1[3-9]\d{9}$/;
    const weakPasswords = new Set(["12345678", "123456789", "1234567890", "password1", "password123", "abc12345", "abcdefg1", "qwerty123"]);
    const show = (el, data) => { el.textContent = typeof data === "string" ? data : JSON.stringify(data, null, 2); };
    const h = (value) => String(value ?? "").replace(/[&<>"']/g, char => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[char]));
    const safeHttpUrl = (value) => {
      const text = String(value || "").trim();
      if (!text) return "";
      try {
        const url = new URL(text);
        return ["http:", "https:"].includes(url.protocol) ? h(url.href) : "";
      } catch {
        return "";
      }
    };
    const pendingUiActions = new Set();
    const entitlementPresets = {
      trial: { label: "7天试用", days: 7, usage_limit: 20 },
      monthly: { label: "月卡", days: 30, usage_limit: 120 },
      quarterly: { label: "季卡", days: 90, usage_limit: 360 },
      annual: { label: "年卡", days: 365, usage_limit: 1200 }
    };
    let currentDetail = null;
    let voiceSampleRows = [];

    function normalizePhoneInput(value) {
      let phone = String(value || "").trim().replace(/[\s\-()（）]/g, "");
      if (phone.startsWith("+86")) phone = phone.slice(3);
      if (phone.startsWith("0086")) phone = phone.slice(4);
      if (phone.startsWith("86") && phone.length === 13 && phone[2] === "1") phone = phone.slice(2);
      return phone;
    }

    function validateMainlandPhone(value, label = "手机号") {
      const phone = normalizePhoneInput(value);
      if (!phone) throw new Error(`请输入${label}`);
      if (!mainlandMobilePattern.test(phone)) throw new Error(`请输入有效的中国大陆11位${label}`);
      return phone;
    }

    function validatePassword(value, phone = "", label = "密码") {
      const password = String(value || "").trim();
      if (!password) throw new Error(`请输入${label}`);
      if (password.length < 8) throw new Error(`${label}至少8位`);
      if (password.length > 64) throw new Error(`${label}不能超过64位`);
      if (/\s/.test(password)) throw new Error(`${label}不能包含空格`);
      if (!/[A-Za-z]/.test(password) || !/\d/.test(password)) throw new Error(`${label}需同时包含字母和数字`);
      if (new Set(password.toLowerCase()).size <= 2 || weakPasswords.has(password.toLowerCase())) throw new Error(`${label}过于简单，请换一个`);
      if (phone && password === phone) throw new Error(`${label}不能和手机号相同`);
      return password;
    }

    function syncStudentAccountFields(detail) {
      const account = detail && detail.student_account ? detail.student_account : {};
      $("student_account_phone").value = account.phone || "";
      $("student_new_password").value = "";
    }

    function setButtonBusy(button, busy, label = "处理中...") {
      if (!button) return;
      if (!button.dataset.defaultText) button.dataset.defaultText = button.textContent;
      button.disabled = busy;
      button.textContent = busy ? label : button.dataset.defaultText;
    }

    async function runOnce(key, button, label, action) {
      if (pendingUiActions.has(key)) return null;
      pendingUiActions.add(key);
      setButtonBusy(button, true, label);
      try {
        return await action();
      } finally {
        pendingUiActions.delete(key);
        setButtonBusy(button, false);
      }
    }

    function dateAfter(days) {
      const d = new Date();
      d.setDate(d.getDate() + Number(days || 0));
      return d.toISOString().slice(0, 10);
    }

    function absoluteUrl(url) {
      if (!url) return "";
      if (/^https?:\/\//.test(url)) return url;
      return location.origin + url;
    }

    function planEvidenceLabel(type) {
      return {
        learning_scope: "K12范围",
        learning_resource: "资源",
        knowledge_point: "知识点",
        exam_pattern: "题型/考法"
      }[type] || type || "";
    }

    function planEvidenceTitle(item) {
      if (item.display_title) return item.display_title;
      if (item.evidence_type === "learning_scope") return [item.stage, item.grade, item.subject].filter(Boolean).join(" / ");
      if (item.evidence_type === "learning_resource") return item.title || "";
      if (item.evidence_type === "knowledge_point") return item.point_name || "";
      if (item.evidence_type === "exam_pattern") return item.question_type || item.pattern_text || "";
      return `${item.evidence_type || "依据"} #${item.evidence_id || ""}`;
    }

    function planEvidenceSource(item) {
      const url = safeHttpUrl(item.url || item.source_url);
      if (url) return `<a href="${url}" target="_blank" rel="noopener" onclick="event.stopPropagation()">打开</a>`;
      return item.evidence_id ? `#${h(item.evidence_id)}` : "";
    }

    function renderPlanEvidenceRefs(detail) {
      const body = $("planEvidenceRefsBody");
      const refs = detail && detail.current_plan_evidence_refs ? detail.current_plan_evidence_refs : [];
      if (!refs.length) {
        body.innerHTML = '<tr><td colspan="4" class="muted">当前方案还没有记录引用依据；新生成或重新发布后会自动写入。</td></tr>';
        return;
      }
      body.innerHTML = refs.map(item => `
        <tr>
          <td>${h(planEvidenceLabel(item.evidence_type))}</td>
          <td><strong>${h(planEvidenceTitle(item))}</strong><br><span class="muted">${[item.subject, item.grade, item.region, item.textbook_version, item.exam_scope, item.year_text].filter(Boolean).map(h).join(" / ")}</span></td>
          <td>${h(item.reason || "")}</td>
          <td>${planEvidenceSource(item)}</td>
        </tr>
      `).join("");
    }

    function readFileAsDataUrl(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.onerror = () => reject(reader.error || new Error("文件读取失败"));
        reader.readAsDataURL(file);
      });
    }

    function activate(view) {
      document.querySelectorAll("nav button").forEach(btn => btn.classList.toggle("active", btn.dataset.view === view));
      document.querySelectorAll("section").forEach(section => section.classList.toggle("active", section.id === view));
    }

    async function refreshCounts() {
      try {
        const health = await api("/health");
        $("serviceStatus").textContent = health.status;
      } catch {
        $("serviceStatus").textContent = "异常";
      }
      try {
        const students = await api("/api/students");
        $("studentCount").textContent = students.items.length;
        renderStudents(students.items);
      } catch {
        $("studentCount").textContent = "0";
      }
      try {
        const actions = await api("/api/admin/adjustments?status=pending");
        $("actionCount").textContent = actions.items.length;
        renderActions(actions.items);
      } catch {
        $("actionCount").textContent = "0";
      }
    }

    function renderStudents(items) {
      const box = $("studentCards");
      if (!items.length) {
        box.innerHTML = '<div class="card"><h3>暂无学生</h3><p class="muted">先从初始建档开始。</p></div>';
        return;
      }
      box.innerHTML = items.map(item => `
        <div class="card">
          <h3>${item.student_code}｜${item.display_name || ""}</h3>
          <div class="card-meta">
            <div class="meta-chip">目标<strong>${item.goal || "未填写"}</strong></div>
            <div class="meta-chip">年级/地区<strong>${item.grade_region || "未填写"}</strong></div>
            <div class="meta-chip">当前档位<strong>${item.current_level || "待判断"}｜${item.current_card_load || "待生成"}</strong></div>
            <div class="meta-chip">执行方式<strong>${item.execution_mode || "待生成"}</strong></div>
          </div>
          <p class="muted">处理建议：先看详情里的反馈和调整动作，再决定是否发布下一版。</p>
          <div class="actions">
            <button class="secondary" onclick="openDetail(${item.id})">详情</button>
            <button class="secondary" onclick="useStudent(${item.id})">填反馈</button>
          </div>
        </div>
      `).join("");
    }

    function renderActions(items) {
      const body = $("actionsBody");
      if (!items.length) {
        body.innerHTML = '<tr><td colspan="5" class="muted">暂无待处理动作。</td></tr>';
        return;
      }
      body.innerHTML = items.map(item => `
        <tr>
          <td class="${item.priority === "high" ? "danger" : "good"}">${item.priority}</td>
          <td>${item.student_code}<br>${item.display_name || ""}</td>
          <td>${item.trigger_reason || ""}</td>
          <td>${item.action_text || ""}</td>
          <td><button class="secondary" onclick="handleAction(event, ${item.action_id})">完成</button></td>
        </tr>
      `).join("");
    }

    async function loadAiJobs() {
      const status = $("aiJobStatus").value || "all";
      const data = await api(`/api/admin/ai-jobs?status=${encodeURIComponent(status)}`);
      renderAiJobs(data.items || []);
    }

    function renderAiJobs(items) {
      const body = $("aiJobsBody");
      if (!items.length) {
        body.innerHTML = '<tr><td colspan="7" class="muted">暂无AI任务。</td></tr>';
        return;
      }
      const statusClass = (status) => status === "success" ? "good" : (status === "error" ? "danger" : "muted");
      body.innerHTML = items.map(item => `
        <tr>
          <td>${item.id}</td>
          <td class="${statusClass(item.status)}">${item.status || ""}</td>
          <td>${item.parent_label || ""}<br>${item.student_code || ""} ${item.display_name || ""}</td>
          <td>${item.task_label || item.task_type || ""}</td>
          <td>${item.note || ""}${item.error_text ? `<br><span class="danger">${item.error_text}</span>` : ""}</td>
          <td>${item.created_at || ""}<br>${item.finished_at || item.started_at || ""}</td>
          <td>
            <span class="inline-tools">
              <button class="secondary" onclick="openDetail(${item.student_id})">学生</button>
              ${item.status === "queued" ? `<button class="warn" onclick="handleAiJob(event, ${item.id}, 'cancel')">取消</button>` : ""}
              ${item.status === "error" ? `<button class="secondary" onclick="handleAiJob(event, ${item.id}, 'retry')">重试</button>` : ""}
            </span>
          </td>
        </tr>
      `).join("");
    }

    window.handleAiJob = async (event, id, action) => {
      await runOnce(`ai-job-${id}-${action}`, event && event.currentTarget, "处理中...", async () => {
        await api(`/api/admin/ai-jobs/${id}/handle`, {
          method: "POST",
          body: JSON.stringify({ action })
        });
        await loadAiJobs();
      });
    };

    window.handleAction = async (event, id) => {
      await runOnce(`adjustment-${id}`, event && event.currentTarget, "处理中...", async () => {
        await api(`/api/admin/adjustments/${id}/handle`, {
          method: "POST",
          body: JSON.stringify({ status: "handled" })
        });
        await refreshCounts();
      });
    };

    async function loadEntitlementPresets() {
      try {
        const data = await api("/api/admin/entitlement-presets");
        (data.items || []).forEach(item => {
          entitlementPresets[item.plan_name] = item;
        });
        updateEntitlementPreview();
      } catch {
        updateEntitlementPreview();
      }
    }

    function updateEntitlementPreview() {
      const plan = $("ent_plan_name").value;
      const preset = entitlementPresets[plan];
      if (!preset) {
        $("entPresetHint").textContent = "自定义套餐不会自动改有效期和额度。";
        return;
      }
      $("entPresetHint").textContent = `${preset.label || plan}：保存时自动设置 ${preset.days} 天，有效期到 ${dateAfter(preset.days)}，AI额度 ${preset.usage_limit} 次。`;
      if ($("ent_apply_preset").value === "1") {
        $("ent_expires").value = dateAfter(preset.days);
        $("ent_usage_limit").value = preset.usage_limit;
      }
    }

    async function loadParents() {
      const data = await api("/api/admin/parents");
      renderParents(data.items || []);
    }

    function renderParents(items) {
      const body = $("parentsBody");
      if (!items.length) {
        body.innerHTML = '<tr><td colspan="7" class="muted">暂无家长帐号。</td></tr>';
        return;
      }
      body.innerHTML = items.map(item => `
        <tr onclick="fillEntitlement(${item.id})">
          <td>${item.id}</td>
          <td>${item.nickname || ""}<br>${item.phone || ""}</td>
          <td>${item.plan_name || ""}</td>
          <td class="${item.is_expired ? "danger" : "good"}">${item.service_expires_at || "未设置"}</td>
          <td>${item.usage_used || 0}/${item.usage_limit == null ? "不限" : item.usage_limit}</td>
          <td>${item.student_count || 0}</td>
          <td>${item.status || ""}</td>
        </tr>
      `).join("");
      window.parentRows = items;
    }

    window.fillEntitlement = (id) => {
      const item = (window.parentRows || []).find(row => row.id === id);
      if (!item) return;
      $("ent_parent_id").value = item.id;
      $("ent_plan_name").value = entitlementPresets[item.plan_name] ? item.plan_name : "custom";
      $("ent_status").value = item.status || "active";
      $("ent_expires").value = item.service_expires_at || "";
      $("ent_usage_limit").value = item.usage_limit == null ? "" : item.usage_limit;
      $("ent_usage_used").value = item.usage_used || 0;
      $("ent_apply_preset").value = "0";
      $("ent_reset_usage").value = "0";
      $("parent_new_password").value = "";
      updateEntitlementPreview();
    };

    async function loadModels() {
      const data = await api("/api/admin/model-configs");
      renderModels(data.items || []);
    }

    async function loadVoiceSamples() {
      const data = await api("/api/admin/voice-practice/samples?limit=30");
      renderVoiceSamples(data.items || []);
    }

    async function loadKnowledgeResources() {
      const params = new URLSearchParams();
      const q = $("kb_search").value.trim();
      const subject = $("kb_filter_subject").value.trim();
      const grade = $("kb_filter_grade").value.trim();
      if (q) params.set("q", q);
      if (subject) params.set("subject", subject);
      if (grade) params.set("grade", grade);
      const suffix = params.toString() ? `?${params.toString()}` : "";
      const data = await api(`/api/admin/learning-resources${suffix}`);
      renderKnowledgeResources(data.items || []);
      $("knowledgeResourceResult").textContent = `已加载 ${data.total || 0} 条资源。`;
    }

    function renderKnowledgeResources(items) {
      const body = $("knowledgeResourcesBody");
      if (!items.length) {
        body.innerHTML = '<tr><td colspan="5" class="muted">暂无资源；先保存课标、教材入口或老师整理的考点。</td></tr>';
        return;
      }
      body.innerHTML = items.map(item => `
        <tr onclick="fillKnowledgeResource(${item.id})">
          <td>${h(item.id)}</td>
          <td><strong>${h(item.title)}</strong><br>${h(item.source_type)}${safeHttpUrl(item.url) ? ` / <a href="${safeHttpUrl(item.url)}" target="_blank" rel="noopener" onclick="event.stopPropagation()">来源</a>` : ""}</td>
          <td>${[item.subject, item.grade, item.region, item.textbook_version].filter(Boolean).map(h).join("<br>")}</td>
          <td>${h(item.summary)}<br><span class="muted">${h(item.tags)}</span></td>
          <td>${h(item.authority_level)}</td>
        </tr>
      `).join("");
      window.knowledgeResourceRows = items;
    }

    window.fillKnowledgeResource = (id) => {
      const item = (window.knowledgeResourceRows || []).find(row => row.id === id);
      if (!item) return;
      $("kb_title").value = item.title || "";
      $("kb_source_type").value = item.source_type || "teacher_curated";
      $("kb_authority_level").value = item.authority_level || "reference";
      $("kb_subject").value = item.subject || "";
      $("kb_grade").value = item.grade || "";
      $("kb_region").value = item.region || "";
      $("kb_textbook_version").value = item.textbook_version || "";
      $("kb_url").value = item.url || "";
      $("kb_summary").value = item.summary || "";
      $("kb_tags").value = item.tags || "";
      $("knowledgeResourceResult").dataset.editingId = String(item.id);
      $("knowledgeResourceResult").textContent = `正在编辑资源 #${item.id}`;
    };

    function clearKnowledgeResourceForm() {
      ["kb_title", "kb_subject", "kb_grade", "kb_region", "kb_textbook_version", "kb_url", "kb_summary", "kb_tags"].forEach(id => { $(id).value = ""; });
      $("kb_source_type").value = "teacher_curated";
      $("kb_authority_level").value = "teacher_curated";
      $("knowledgeResourceResult").dataset.editingId = "";
      $("knowledgeResourceResult").textContent = "已清空，可以录入下一条资源。";
    }

    async function loadKnowledgePoints() {
      const params = new URLSearchParams();
      const q = $("kp_search").value.trim();
      const subject = $("kp_filter_subject").value.trim();
      const grade = $("kp_filter_grade").value.trim();
      if (q) params.set("q", q);
      if (subject) params.set("subject", subject);
      if (grade) params.set("grade", grade);
      const suffix = params.toString() ? `?${params.toString()}` : "";
      const data = await api(`/api/admin/knowledge-points${suffix}`);
      renderKnowledgePoints(data.items || []);
      $("knowledgePointResult").textContent = `已加载 ${data.total || 0} 条知识点。`;
    }

    function renderKnowledgePoints(items) {
      const body = $("knowledgePointsBody");
      if (!items.length) {
        body.innerHTML = '<tr><td colspan="5" class="muted">暂无知识点；先从教材目录、课标要求或高频错法录入。</td></tr>';
        window.knowledgePointRows = [];
        return;
      }
      body.innerHTML = items.map(item => `
        <tr onclick="fillKnowledgePoint(${item.id})">
          <td>${h(item.id)}</td>
          <td>${[item.subject, item.grade, item.textbook_version, item.unit_name].filter(Boolean).map(h).join("<br>")}</td>
          <td><strong>${h(item.point_name)}</strong><br><span class="muted">${h(item.requirement_level)}${item.resource_id ? ` / 资源#${h(item.resource_id)}` : ""}</span></td>
          <td>${h(item.common_errors)}<br><span class="muted">${h(item.memory_hint)}</span></td>
          <td>${h(item.importance)}</td>
        </tr>
      `).join("");
      window.knowledgePointRows = items;
    }

    window.fillKnowledgePoint = (id) => {
      const item = (window.knowledgePointRows || []).find(row => row.id === id);
      if (!item) return;
      $("kp_resource_id").value = item.resource_id || "";
      $("kp_subject").value = item.subject || "";
      $("kp_grade").value = item.grade || "";
      $("kp_textbook_version").value = item.textbook_version || "";
      $("kp_unit_name").value = item.unit_name || "";
      $("kp_point_name").value = item.point_name || "";
      $("kp_requirement_level").value = item.requirement_level || "";
      $("kp_importance").value = item.importance || "normal";
      $("kp_common_errors").value = item.common_errors || "";
      $("kp_memory_hint").value = item.memory_hint || "";
      $("knowledgePointResult").dataset.editingId = String(item.id);
      $("knowledgePointResult").textContent = `正在编辑知识点 #${item.id}`;
    };

    function clearKnowledgePointForm() {
      ["kp_resource_id", "kp_subject", "kp_grade", "kp_textbook_version", "kp_unit_name", "kp_point_name", "kp_requirement_level", "kp_common_errors", "kp_memory_hint"].forEach(id => { $(id).value = ""; });
      $("kp_importance").value = "normal";
      $("knowledgePointResult").dataset.editingId = "";
      $("knowledgePointResult").textContent = "已清空，可以录入下一条知识点。";
    }

    async function loadExamPatterns() {
      const params = new URLSearchParams();
      const q = $("ep_search").value.trim();
      const subject = $("ep_filter_subject").value.trim();
      const grade = $("ep_filter_grade").value.trim();
      if (q) params.set("q", q);
      if (subject) params.set("subject", subject);
      if (grade) params.set("grade", grade);
      const suffix = params.toString() ? `?${params.toString()}` : "";
      const data = await api(`/api/admin/exam-patterns${suffix}`);
      renderExamPatterns(data.items || []);
      $("examPatternResult").textContent = `已加载 ${data.total || 0} 条题型/考法。`;
    }

    function renderExamPatterns(items) {
      const body = $("examPatternsBody");
      if (!items.length) {
        body.innerHTML = '<tr><td colspan="5" class="muted">暂无题型；先录入历年常考题型、答题点或老师整理规律。</td></tr>';
        window.examPatternRows = [];
        return;
      }
      body.innerHTML = items.map(item => `
        <tr onclick="fillExamPattern(${item.id})">
          <td>${h(item.id)}</td>
          <td>${[item.subject, item.grade, item.region, item.exam_scope, item.year_text].filter(Boolean).map(h).join("<br>")}</td>
          <td>${h(item.question_type)}<br><span class="muted">${item.knowledge_point_id ? `知识点#${h(item.knowledge_point_id)}` : ""}${item.resource_id ? ` / 资源#${h(item.resource_id)}` : ""}</span></td>
          <td>${h(item.pattern_text)}<br><span class="muted">${h(item.answer_points)}${safeHttpUrl(item.source_url) ? ` / <a href="${safeHttpUrl(item.source_url)}" target="_blank" rel="noopener" onclick="event.stopPropagation()">来源</a>` : ""}</span></td>
          <td>${h(item.frequency_level)}</td>
        </tr>
      `).join("");
      window.examPatternRows = items;
    }

    window.fillExamPattern = (id) => {
      const item = (window.examPatternRows || []).find(row => row.id === id);
      if (!item) return;
      $("ep_knowledge_point_id").value = item.knowledge_point_id || "";
      $("ep_resource_id").value = item.resource_id || "";
      $("ep_subject").value = item.subject || "";
      $("ep_grade").value = item.grade || "";
      $("ep_region").value = item.region || "";
      $("ep_exam_scope").value = item.exam_scope || "";
      $("ep_year_text").value = item.year_text || "";
      $("ep_question_type").value = item.question_type || "";
      $("ep_frequency_level").value = item.frequency_level || "unknown";
      $("ep_pattern_text").value = item.pattern_text || "";
      $("ep_answer_points").value = item.answer_points || "";
      $("ep_source_url").value = item.source_url || "";
      $("examPatternResult").dataset.editingId = String(item.id);
      $("examPatternResult").textContent = `正在编辑题型 #${item.id}`;
    };

    function clearExamPatternForm() {
      ["ep_knowledge_point_id", "ep_resource_id", "ep_subject", "ep_grade", "ep_region", "ep_exam_scope", "ep_year_text", "ep_question_type", "ep_pattern_text", "ep_answer_points", "ep_source_url"].forEach(id => { $(id).value = ""; });
      $("ep_frequency_level").value = "high";
      $("examPatternResult").dataset.editingId = "";
      $("examPatternResult").textContent = "已清空，可以录入下一条题型。";
    }

    async function loadLearningCoverage() {
      const params = new URLSearchParams();
      const stage = $("coverage_stage").value.trim();
      const grade = $("coverage_grade").value.trim();
      const subject = $("coverage_subject").value.trim();
      if (stage) params.set("stage", stage);
      if (grade) params.set("grade", grade);
      if (subject) params.set("subject", subject);
      const suffix = params.toString() ? `?${params.toString()}` : "";
      const data = await api(`/api/admin/learning-coverage${suffix}`);
      renderLearningCoverage(data.items || []);
      const s = data.summary || {};
      $("learningCoverageResult").textContent = `已加载 ${data.total || 0} 条范围。ready ${s.ready || 0} / partial ${s.partial || 0} / seed ${s.seed || 0} / empty ${s.empty || 0}`;
      await loadLearningCollectionTasks(params);
    }

    function coverageNextStep(item) {
      if (item.coverage_level === "ready") return "可用于计划生成；继续补地区真题。";
      if (item.coverage_level === "partial") return item.knowledge_point_count ? "补真题题型/考法。" : "补具体知识点。";
      if (item.coverage_level === "seed") return "从教材目录和高频考点开始补。";
      return "先补官方/教材入口。";
    }

    function renderLearningCoverage(items) {
      const body = $("learningCoverageBody");
      if (!items.length) {
        body.innerHTML = '<tr><td colspan="6" class="muted">没有匹配的覆盖率范围。</td></tr>';
        return;
      }
      body.innerHTML = items.map(item => `
        <tr>
          <td class="${item.coverage_level === "ready" ? "good" : item.coverage_level === "empty" ? "danger" : "muted"}">${h(item.coverage_level)}</td>
          <td>${h(item.stage)}</td>
          <td>${h(item.grade)}</td>
          <td>${h(item.subject)}</td>
          <td>资源 ${h(item.resource_count)} / 知识点 ${h(item.knowledge_point_count)} / 题型 ${h(item.exam_pattern_count)}</td>
          <td>${h(coverageNextStep(item))}</td>
        </tr>
      `).join("");
    }

    async function loadLearningCollectionTasks(params = null) {
      const current = params || new URLSearchParams();
      if (!params) {
        const stage = $("coverage_stage").value.trim();
        const grade = $("coverage_grade").value.trim();
        const subject = $("coverage_subject").value.trim();
        if (stage) current.set("stage", stage);
        if (grade) current.set("grade", grade);
        if (subject) current.set("subject", subject);
      }
      const suffix = current.toString() ? `?${current.toString()}` : "";
      const data = await api(`/api/admin/learning-collection-tasks${suffix}`);
      renderLearningCollectionTasks(data.items || []);
      $("learningCollectionTasksResult").textContent = `待采集 ${data.total || 0} 项。优先处理 high，再处理 seed 拆分。`;
    }

    function collectionTaskLabel(type) {
      return {
        collect_source: "补来源",
        collect_foundation: "拆基础",
        collect_knowledge_points: "补知识点",
        collect_exam_patterns: "补题型"
      }[type] || type || "";
    }

    function renderLearningCollectionTasks(items) {
      const body = $("learningCollectionTasksBody");
      if (!items.length) {
        body.innerHTML = '<tr><td colspan="5" class="muted">当前筛选范围没有待采集任务。</td></tr>';
        return;
      }
      body.innerHTML = items.map(item => `
        <tr>
          <td class="${item.priority === "high" ? "danger" : "muted"}">${h(item.priority)}</td>
          <td>${h(item.stage)} / ${h(item.grade)} / ${h(item.subject)}<br><span class="muted">${h(item.coverage_level)}</span></td>
          <td>${h(collectionTaskLabel(item.task_type))}</td>
          <td>${h(item.task_text)}</td>
          <td>资源 ${h(item.resource_count)}<br>知识点 ${h(item.knowledge_point_count)} / 题型 ${h(item.exam_pattern_count)}</td>
        </tr>
      `).join("");
    }

    async function loadCollectionTaskRecords() {
      const params = new URLSearchParams();
      const status = $("collection_task_status_filter").value || "todo";
      const stage = $("coverage_stage").value.trim();
      const grade = $("coverage_grade").value.trim();
      const subject = $("coverage_subject").value.trim();
      params.set("status", status);
      if (stage) params.set("stage", stage);
      if (grade) params.set("grade", grade);
      if (subject) params.set("subject", subject);
      const data = await api(`/api/admin/learning-collection-task-records?${params.toString()}`);
      renderCollectionTaskRecords(data.items || []);
      $("collectionTaskRecordResult").textContent = `已加载 ${data.total || 0} 条已保存采集任务。`;
    }

    function renderCollectionTaskRecords(items) {
      const body = $("collectionTaskRecordsBody");
      if (!items.length) {
        body.innerHTML = '<tr><td colspan="5" class="muted">当前筛选范围没有已保存任务。</td></tr>';
        window.collectionTaskRows = [];
        return;
      }
      body.innerHTML = items.map(item => `
        <tr onclick="fillCollectionTaskRecord(${item.id})">
          <td>${h(item.id)}</td>
          <td class="${item.status === "done" ? "good" : item.status === "blocked" ? "danger" : "muted"}">${h(item.status)}<br><span class="muted">${h(item.priority)}</span></td>
          <td>${h(item.stage)} / ${h(item.grade)} / ${h(item.subject)}<br><span class="muted">${h(item.coverage_level)}</span></td>
          <td>${h(collectionTaskLabel(item.task_type))}｜${h(item.task_text)}<br><span class="muted">${h(item.review_note)}</span></td>
          <td>${h(item.assignee)}<br>${safeHttpUrl(item.source_url) ? `<a href="${safeHttpUrl(item.source_url)}" target="_blank" rel="noopener" onclick="event.stopPropagation()">来源</a>` : h(item.source_url)}</td>
        </tr>
      `).join("");
      window.collectionTaskRows = items;
    }

    window.fillCollectionTaskRecord = (id) => {
      const item = (window.collectionTaskRows || []).find(row => row.id === id);
      if (!item) return;
      $("collection_task_id").value = item.id || "";
      $("collection_task_status").value = item.status || "todo";
      $("collection_task_assignee").value = item.assignee || "";
      $("collection_task_source_url").value = item.source_url || "";
      $("collection_task_review_note").value = item.review_note || "";
      $("collectionTaskRecordResult").textContent = `正在编辑采集任务 #${item.id}`;
    };

    async function loadScopeIndex() {
      const params = new URLSearchParams();
      const stage = $("scope_stage").value.trim();
      const grade = $("scope_grade").value.trim();
      const subject = $("scope_subject").value.trim();
      if (stage) params.set("stage", stage);
      if (grade) params.set("grade", grade);
      if (subject) params.set("subject", subject);
      const suffix = params.toString() ? `?${params.toString()}` : "";
      const data = await api(`/api/admin/learning-scope-index${suffix}`);
      renderScopeIndex(data.items || []);
      $("scopeIndexResult").textContent = `已加载 ${data.total || 0} 条K12范围索引。`;
    }

    function renderScopeIndex(items) {
      const body = $("scopeIndexBody");
      if (!items.length) {
        body.innerHTML = '<tr><td colspan="5" class="muted">没有匹配的范围索引。</td></tr>';
        return;
      }
      body.innerHTML = items.map(item => `
        <tr>
          <td>${item.stage || ""}</td>
          <td>${item.grade || ""}<br><span class="muted">${item.grade_aliases || ""}</span></td>
          <td>${item.subject || ""}<br><span class="muted">${item.subject_aliases || ""}</span></td>
          <td>${item.resource_types || ""}<br><span class="muted">${item.default_textbook_versions || ""}</span></td>
          <td>${item.exam_focus || ""}<br><span class="muted">${item.intervention_modes || ""}</span></td>
        </tr>
      `).join("");
    }

    function renderVoiceSamples(items) {
      voiceSampleRows = items;
      const select = $("voice_sample_id");
      const current = select.value;
      select.innerHTML = ['<option value="">手动上传一段音频</option>'].concat(items.map(item => {
        const parts = [
          item.student_code || `学生${item.student_id || ""}`,
          item.display_name || "",
          item.target_text || "",
          item.created_at || ""
        ].filter(Boolean);
        return `<option value="${item.id}">${parts.join(" / ")}</option>`;
      })).join("");
      if (current) select.value = current;
      if (select.value) applyVoiceSample(select.value);
    }

    function applyVoiceSample(sampleId) {
      const sample = voiceSampleRows.find(item => String(item.id) === String(sampleId));
      if (!sample) return;
      $("voice_sample_id").value = String(sample.id);
      $("voice_student_id").value = sample.student_id || "";
      $("voice_target_type").value = sample.target_type || "sentence";
      $("voice_target_text").value = sample.target_text || "";
      $("voice_transcript").value = sample.transcript || "";
      $("voice_source_file").value = "";
      $("voiceSampleHint").textContent = `${sample.student_code || ""}${sample.display_name ? ` / ${sample.display_name}` : ""} / ${sample.created_at || ""}${sample.audio_url ? ` / ${absoluteUrl(sample.audio_url)}` : ""}`;
    }

    function renderVoiceAssessmentResult(result) {
      const source = result.source || {};
      const xfyun = result.xfyun || {};
      const assessment = result.assessment || {};
      const scores = xfyun.scores || assessment.scores || {};
      const quota = result.quota || null;
      const lines = [];
      const sourceBits = [source.kind || "上传"];
      if (source.student_code) sourceBits.push(source.student_code);
      if (source.display_name) sourceBits.push(source.display_name);
      if (source.session_id) sourceBits.push(`样本#${source.session_id}`);
      lines.push(`录音来源：${sourceBits.join(" / ")}`);
      if (source.audio_url) lines.push(`录音链接：${absoluteUrl(source.audio_url)}`);
      if (result.practice_date) lines.push(`次数日期：${result.practice_date}`);
      lines.push(`目标文本：${result.target_text || ""}`);
      lines.push(`题型：${result.target_type || ""}`);
      if (result.transcript) lines.push(`兜底文本：${result.transcript}`);
      lines.push("");
      lines.push(`最终结果：${assessment.provider || "unknown"}${assessment.available ? " / 讯飞" : " / 兜底"}`);
      lines.push(`总分：${assessment.score ?? "—"}`);
      lines.push(`状态：${assessment.status || "—"}`);
      lines.push(`反馈：${assessment.feedback || "—"}`);
      if (scores.total_score != null || scores.accuracy_score != null || scores.standard_score != null || scores.fluency_score != null || scores.integrity_score != null) {
        lines.push("");
        lines.push("讯飞分项：");
        lines.push(`总分 ${scores.total_score ?? "—"} / 准确度 ${scores.accuracy_score ?? "—"} / 流畅度 ${scores.fluency_score ?? "—"} / 标准度 ${scores.standard_score ?? "—"} / 完整度 ${scores.integrity_score ?? "—"}`);
      }
      if (scores.phones && scores.phones.length) {
        const phones = scores.phones.slice(0, 3).map(item => `${item.content || ""}${item.message ? `(${item.message})` : ""}`).filter(Boolean);
        if (phones.length) lines.push(`重点音素：${phones.join("，")}`);
      }
      if (xfyun.message) lines.push(`讯飞消息：${xfyun.message}`);
      lines.push("");
      lines.push(`是否走 fallback：${result.fallback_used ? "是" : "否"}`);
      lines.push(`按正式流程是否消耗次数：${result.would_consume_quota === null ? "未知" : result.would_consume_quota ? "是" : "否"}`);
      if (quota) {
        lines.push(`次数：${quota.used}/${quota.limit}，剩余 ${quota.remaining}`);
      }
      show($("voiceAssessmentResult"), lines.join("\n"));
      $("voiceSampleHint").textContent = result.fallback_used
        ? "这次已经回退到本地兜底；如果你期待的是讯飞结果，请检查音频、环境变量，或当天次数。"
        : "这次已经走到讯飞评测链路。";
    }

    function renderModels(items) {
      const body = $("modelsBody");
      if (!items.length) {
        body.innerHTML = '<tr><td colspan="7" class="muted">暂无模型配置。</td></tr>';
        return;
      }
      body.innerHTML = items.map(item => `
        <tr onclick="fillModel('${item.task_type}')">
          <td>${item.task_label || item.task_type}</td>
          <td>${item.provider_name || ""}</td>
          <td>${item.model_name || ""}</td>
          <td>${item.endpoint_url || ""}</td>
          <td>${item.api_key_env || ""}</td>
          <td class="${item.api_key_available ? "good" : "danger"}">${item.api_key_available ? "已设置" : "未设置"}</td>
          <td>${item.enabled ? "启用" : "停用"}</td>
        </tr>
      `).join("");
      window.modelRows = items;
    }

    window.fillModel = (taskType) => {
      const item = (window.modelRows || []).find(row => row.task_type === taskType);
      if (!item) return;
      $("model_task_type").value = item.task_type;
      $("model_provider").value = item.provider_name || "";
      $("model_name").value = item.model_name || "";
      $("model_endpoint").value = item.endpoint_url || "";
      $("model_key_env").value = item.api_key_env || "";
      $("model_temperature").value = item.temperature ?? 0.2;
      $("model_enabled").value = String(item.enabled ? 1 : 0);
    };

    window.runVoiceAssessment = async (event) => {
      const sampleId = $("voice_sample_id").value;
      const file = $("voice_source_file").files && $("voice_source_file").files[0];
      const targetText = $("voice_target_text").value.trim();
      const targetType = $("voice_target_type").value;
      const transcript = $("voice_transcript").value.trim();
      const studentId = $("voice_student_id").value.trim();
      if (!sampleId && !file) {
        show($("voiceAssessmentResult"), "请先选择一条样本，或者上传一段音频。");
        return;
      }
      if (file && !targetText && !sampleId) {
        show($("voiceAssessmentResult"), "上传音频时请先填写目标文本。");
        return;
      }
      await runOnce("voice-assessment", event && event.currentTarget, "校准中...", async () => {
        const payload = {
          source_kind: file ? "upload" : "sample",
          session_id: sampleId ? Number(sampleId) : 0,
          student_id: studentId ? Number(studentId) : 0,
          target_text: targetText,
          target_type: targetType,
          transcript
        };
        if (file) {
          payload.audio_data_url = await readFileAsDataUrl(file);
          payload.file_name = file.name;
          payload.source_kind = "upload";
        }
        try {
          const result = await api("/api/admin/voice-assessment/calibrate", {
            method: "POST",
            body: JSON.stringify(payload)
          });
          renderVoiceAssessmentResult(result);
        } catch (error) {
          show($("voiceAssessmentResult"), String(error.message || error));
        }
      });
    };

    window.clearVoiceAssessment = () => {
      $("voice_sample_id").value = "";
      $("voice_student_id").value = "";
      $("voice_target_type").value = "sentence";
      $("voice_target_text").value = "";
      $("voice_transcript").value = "";
      $("voice_source_file").value = "";
      $("voiceSampleHint").textContent = "请选择一条样本，或上传一段录音。选择样本会自动带出学生ID、题型和目标文本。";
      show($("voiceAssessmentResult"), "等待选择录音并执行校准。");
    };

    $("voice_sample_id").addEventListener("change", (event) => {
      if (event.currentTarget.value) {
        applyVoiceSample(event.currentTarget.value);
      }
    });

    $("voice_source_file").addEventListener("change", () => {
      if ($("voice_source_file").files && $("voice_source_file").files[0]) {
        $("voice_sample_id").value = "";
        $("voiceSampleHint").textContent = `已选择上传文件：${$("voice_source_file").files[0].name}`;
      }
    });

    window.openDetail = async (id) => {
      $("detailStudentId").value = id;
      activate("detail");
      currentDetail = await api(`/api/students/${id}`);
      syncStudentAccountFields(currentDetail);
      renderPlanEvidenceRefs(currentDetail);
      show($("detailResult"), currentDetail);
    };

    window.useStudent = (id) => {
      $("student_id").value = id;
      activate("feedback");
    };

    document.querySelectorAll("nav button").forEach(btn => {
      btn.addEventListener("click", () => activate(btn.dataset.view));
    });

    $("fillSample").addEventListener("click", () => {
      const sample = {
        student_name: "小陈",
        grade_region: "初一/湖南",
        goal: "期末基础抢分",
        exam_date_text: "2周后",
        time_budget: "15-25分钟",
        cooperation: "抗拒",
        priority_subjects: "语文古诗、历史道法、英语基础词",
        difficulties: "记不住，一问就慌，背了3天有一点印象但不稳",
        parent_support: "研学期间可以微信问3张，平时每天10分钟抽查",
        evidence_summary: "已有3天卡片反馈",
        extra_notes: "明后天研学，时间碎片化"
      };
      Object.entries(sample).forEach(([key, value]) => { if ($(key)) $(key).value = value; });
    });

    $("clearIntake").addEventListener("click", () => {
      $("intakeForm").reset();
      show($("intakeResult"), "等待提交建档。");
    });

    $("intakeForm").addEventListener("submit", async (event) => {
      event.preventDefault();
      await runOnce("admin-intake-submit", event.submitter, "提交中...", async () => {
        const payload = { source: "local_tool", ...formJson(event.currentTarget) };
        try {
          const result = await api("/api/students/intake", {
            method: "POST",
            body: JSON.stringify(payload)
          });
          show($("intakeResult"), result);
          $("student_id").value = result.student_id;
          $("detailStudentId").value = result.student_id;
          await refreshCounts();
        } catch (error) {
          show($("intakeResult"), String(error.message || error));
        }
      });
    });

    $("feedbackForm").addEventListener("submit", async (event) => {
      event.preventDefault();
      await runOnce("admin-feedback-submit", event.submitter, "提交中...", async () => {
        const payload = formJson(event.currentTarget);
        const studentId = payload.student_id;
        delete payload.student_id;
        ["planned_cards", "completed_cards", "known_cards"].forEach(key => payload[key] = Number(payload[key] || 0));
        try {
          const result = await api(`/api/students/${studentId}/daily-feedback`, {
            method: "POST",
            body: JSON.stringify(payload)
          });
          show($("feedbackResult"), result);
          await refreshCounts();
        } catch (error) {
          show($("feedbackResult"), String(error.message || error));
        }
      });
    });

    $("refreshStudents").addEventListener("click", refreshCounts);
    $("refreshActions").addEventListener("click", refreshCounts);
    $("refreshAiJobs").addEventListener("click", loadAiJobs);
    $("aiJobStatus").addEventListener("change", loadAiJobs);
    $("refreshParents").addEventListener("click", loadParents);
    $("refreshModels").addEventListener("click", loadModels);
    $("refreshVoiceSamples").addEventListener("click", loadVoiceSamples);
    $("refreshKnowledgeResources").addEventListener("click", loadKnowledgeResources);
    $("refreshKnowledgePoints").addEventListener("click", loadKnowledgePoints);
    $("refreshExamPatterns").addEventListener("click", loadExamPatterns);
    $("refreshLearningCoverage").addEventListener("click", loadLearningCoverage);
    $("refreshCollectionTaskRecords").addEventListener("click", loadCollectionTaskRecords);
    $("collection_task_status_filter").addEventListener("change", loadCollectionTaskRecords);
    $("kb_search").addEventListener("change", loadKnowledgeResources);
    $("kb_filter_subject").addEventListener("change", loadKnowledgeResources);
    $("kb_filter_grade").addEventListener("change", loadKnowledgeResources);
    $("kp_search").addEventListener("change", loadKnowledgePoints);
    $("kp_filter_subject").addEventListener("change", loadKnowledgePoints);
    $("kp_filter_grade").addEventListener("change", loadKnowledgePoints);
    $("ep_search").addEventListener("change", loadExamPatterns);
    $("ep_filter_subject").addEventListener("change", loadExamPatterns);
    $("ep_filter_grade").addEventListener("change", loadExamPatterns);
    $("coverage_stage").addEventListener("change", loadLearningCoverage);
    $("coverage_grade").addEventListener("change", loadLearningCoverage);
    $("coverage_subject").addEventListener("change", loadLearningCoverage);
    $("syncCollectionTasks").addEventListener("click", async (event) => {
      await runOnce("collection-task-sync", event.currentTarget, "同步中...", async () => {
        const result = await api("/api/admin/learning-collection-task-records/sync", {
          method: "POST",
          body: JSON.stringify({
            stage: $("coverage_stage").value,
            grade: $("coverage_grade").value,
            subject: $("coverage_subject").value
          })
        });
        show($("collectionTaskRecordResult"), result);
        await loadCollectionTaskRecords();
      });
    });
    $("saveCollectionTaskRecord").addEventListener("click", async (event) => {
      const id = $("collection_task_id").value;
      if (!id) {
        show($("collectionTaskRecordResult"), "请先点击一条已保存采集任务。");
        return;
      }
      await runOnce(`collection-task-save-${id}`, event.currentTarget, "保存中...", async () => {
        const result = await api("/api/admin/learning-collection-task-records", {
          method: "POST",
          body: JSON.stringify({
            id: Number(id),
            status: $("collection_task_status").value,
            source_url: $("collection_task_source_url").value,
            assignee: $("collection_task_assignee").value,
            review_note: $("collection_task_review_note").value
          })
        });
        show($("collectionTaskRecordResult"), result);
        await loadCollectionTaskRecords();
      });
    });
    $("refreshScopeIndex").addEventListener("click", loadScopeIndex);
    $("scope_stage").addEventListener("change", loadScopeIndex);
    $("scope_grade").addEventListener("change", loadScopeIndex);
    $("scope_subject").addEventListener("change", loadScopeIndex);
    $("clearKnowledgeResource").addEventListener("click", clearKnowledgeResourceForm);
    $("clearKnowledgePoint").addEventListener("click", clearKnowledgePointForm);
    $("clearExamPattern").addEventListener("click", clearExamPatternForm);
    $("saveKnowledgeResource").addEventListener("click", async (event) => {
      await runOnce("knowledge-resource-save", event.currentTarget, "保存中...", async () => {
        const payload = {
          id: Number($("knowledgeResourceResult").dataset.editingId || 0),
          title: $("kb_title").value,
          source_type: $("kb_source_type").value,
          authority_level: $("kb_authority_level").value,
          subject: $("kb_subject").value,
          grade: $("kb_grade").value,
          region: $("kb_region").value,
          textbook_version: $("kb_textbook_version").value,
          url: $("kb_url").value,
          summary: $("kb_summary").value,
          tags: $("kb_tags").value
        };
        const result = await api("/api/admin/learning-resources", {
          method: "POST",
          body: JSON.stringify(payload)
        });
        show($("knowledgeResourceResult"), result);
        $("knowledgeResourceResult").dataset.editingId = String(result.resource.id || "");
        await loadKnowledgeResources();
      });
    });
    $("saveKnowledgePoint").addEventListener("click", async (event) => {
      await runOnce("knowledge-point-save", event.currentTarget, "保存中...", async () => {
        const payload = {
          id: Number($("knowledgePointResult").dataset.editingId || 0),
          resource_id: $("kp_resource_id").value,
          subject: $("kp_subject").value,
          grade: $("kp_grade").value,
          textbook_version: $("kp_textbook_version").value,
          unit_name: $("kp_unit_name").value,
          point_name: $("kp_point_name").value,
          requirement_level: $("kp_requirement_level").value,
          importance: $("kp_importance").value,
          common_errors: $("kp_common_errors").value,
          memory_hint: $("kp_memory_hint").value
        };
        const result = await api("/api/admin/knowledge-points", {
          method: "POST",
          body: JSON.stringify(payload)
        });
        show($("knowledgePointResult"), result);
        $("knowledgePointResult").dataset.editingId = String(result.point.id || "");
        await loadKnowledgePoints();
      });
    });
    $("saveExamPattern").addEventListener("click", async (event) => {
      await runOnce("exam-pattern-save", event.currentTarget, "保存中...", async () => {
        const payload = {
          id: Number($("examPatternResult").dataset.editingId || 0),
          knowledge_point_id: $("ep_knowledge_point_id").value,
          resource_id: $("ep_resource_id").value,
          subject: $("ep_subject").value,
          grade: $("ep_grade").value,
          region: $("ep_region").value,
          exam_scope: $("ep_exam_scope").value,
          year_text: $("ep_year_text").value,
          question_type: $("ep_question_type").value,
          frequency_level: $("ep_frequency_level").value,
          pattern_text: $("ep_pattern_text").value,
          answer_points: $("ep_answer_points").value,
          source_url: $("ep_source_url").value
        };
        const result = await api("/api/admin/exam-patterns", {
          method: "POST",
          body: JSON.stringify(payload)
        });
        show($("examPatternResult"), result);
        $("examPatternResult").dataset.editingId = String(result.pattern.id || "");
        await loadExamPatterns();
      });
    });
    $("runVoiceAssessment").addEventListener("click", window.runVoiceAssessment);
    $("clearVoiceAssessment").addEventListener("click", window.clearVoiceAssessment);
    $("ent_plan_name").addEventListener("change", () => {
      $("ent_apply_preset").value = entitlementPresets[$("ent_plan_name").value] ? "1" : "0";
      $("ent_reset_usage").value = "1";
      updateEntitlementPreview();
    });
    $("ent_apply_preset").addEventListener("change", updateEntitlementPreview);
    $("resetParentPassword").addEventListener("click", async (event) => {
      const id = $("ent_parent_id").value;
      if (!id) {
        show($("parentPasswordResult"), "请先从家长列表选择一个家长。");
        return;
      }
      const parent = (window.parentRows || []).find(row => String(row.id) === String(id));
      try {
        const password = validatePassword($("parent_new_password").value, parent && parent.phone ? normalizePhoneInput(parent.phone) : "", "家长新密码");
        if (!confirm(`确定重置家长 #${id} 的登录密码吗？`)) return;
        await runOnce(`parent-password-${id}`, event.currentTarget, "重置中...", async () => {
          const result = await api(`/api/admin/parents/${id}/password`, {
            method: "POST",
            body: JSON.stringify({ password })
          });
          $("parent_new_password").value = "";
          show($("parentPasswordResult"), result);
          await loadParents();
        });
      } catch (error) {
        show($("parentPasswordResult"), String(error.message || error));
      }
    });
    $("saveEntitlement").addEventListener("click", async () => {
      const id = $("ent_parent_id").value;
      if (!id) return;
      const payload = {
        plan_name: $("ent_plan_name").value,
        status: $("ent_status").value,
        service_expires_at: $("ent_expires").value,
        usage_limit: $("ent_usage_limit").value,
        usage_used: $("ent_usage_used").value,
        apply_preset: $("ent_apply_preset").value === "1",
        reset_usage_used: $("ent_reset_usage").value === "1"
      };
      await api(`/api/admin/parents/${id}/entitlement`, {
        method: "POST",
        body: JSON.stringify(payload)
      });
      await loadParents();
    });
    $("saveModelConfig").addEventListener("click", async () => {
      const payload = {
        task_type: $("model_task_type").value,
        provider_name: $("model_provider").value,
        model_name: $("model_name").value,
        endpoint_url: $("model_endpoint").value,
        api_key_env: $("model_key_env").value,
        temperature: Number($("model_temperature").value || 0.2),
        enabled: $("model_enabled").value === "1"
      };
      const result = await api("/api/admin/model-configs", {
        method: "POST",
        body: JSON.stringify(payload)
      });
      show($("modelResult"), result);
      await loadModels();
    });
    $("configureXiaomi").addEventListener("click", async () => {
      const result = await api("/api/admin/model-configs/xiaomi", {
        method: "POST",
        body: JSON.stringify({
          endpoint_url: "https://token-plan-cn.xiaomimimo.com/v1",
          model_name: "mimo-v2.5-pro",
          temperature: 0.2
        })
      });
      show($("modelResult"), result);
      await loadModels();
    });
    $("loadDetail").addEventListener("click", async () => {
      const id = $("detailStudentId").value;
      if (!id) return;
      currentDetail = await api(`/api/students/${id}`);
      syncStudentAccountFields(currentDetail);
      renderPlanEvidenceRefs(currentDetail);
      show($("detailResult"), currentDetail);
    });
    $("resetStudentPassword").addEventListener("click", async (event) => {
      const id = $("detailStudentId").value;
      if (!id) {
        show($("detailResult"), "请先输入学生ID或从学生列表打开详情。");
        return;
      }
      try {
        const rawPhone = $("student_account_phone").value;
        const phone = rawPhone ? validateMainlandPhone(rawPhone, "学生手机号") : "";
        const password = validatePassword($("student_new_password").value, phone, "学生新密码");
        if (!phone && !(currentDetail && currentDetail.student_account && currentDetail.student_account.phone)) {
          throw new Error("学生还没有登录账号，请先填写学生手机号。");
        }
        if (!confirm(`确定重置学生 #${id} 的登录密码吗？`)) return;
        await runOnce(`student-password-${id}`, event.currentTarget, "重置中...", async () => {
          const result = await api(`/api/admin/students/${id}/password`, {
            method: "POST",
            body: JSON.stringify({ phone, password })
          });
          $("student_new_password").value = "";
          currentDetail = await api(`/api/students/${id}`);
          syncStudentAccountFields(currentDetail);
          renderPlanEvidenceRefs(currentDetail);
          show($("detailResult"), { reset: result, detail: currentDetail });
        });
      } catch (error) {
        show($("detailResult"), String(error.message || error));
      }
    });
    $("openCurrentFile").addEventListener("click", () => {
      const url = currentDetail && currentDetail.current_plan && currentDetail.current_plan.file_url;
      if (!url) {
        show($("detailResult"), "当前学生还没有可下载文件。");
        return;
      }
      window.open(absoluteUrl(url), "_blank");
    });
    $("copyCurrentFile").addEventListener("click", async () => {
      const url = currentDetail && currentDetail.current_plan && currentDetail.current_plan.file_url;
      if (!url) {
        show($("detailResult"), "当前学生还没有可复制的文件链接。");
        return;
      }
      const full = absoluteUrl(url);
      await navigator.clipboard.writeText(full);
      show($("detailResult"), `已复制文件链接：\n${full}`);
    });
    $("bindCurrentDocx").addEventListener("click", () => {
      const id = $("detailStudentId").value;
      if (!id) {
        show($("detailResult"), "请先输入学生ID或从学生列表打开详情。");
        return;
      }
      $("currentDocxFile").value = "";
      $("currentDocxFile").click();
    });
    $("currentDocxFile").addEventListener("change", async (event) => {
      const id = $("detailStudentId").value;
      const file = event.currentTarget.files && event.currentTarget.files[0];
      if (!id || !file) return;
      if (!file.name.toLowerCase().endsWith(".docx")) {
        show($("detailResult"), "请选择DOCX文件。");
        return;
      }
      if (file.size > 8 * 1024 * 1024) {
        show($("detailResult"), "DOCX文件不能超过8MB。");
        return;
      }
      const ok = confirm(`将把“${file.name}”绑定到当前方案，并覆盖当前方案文件链接。继续吗？`);
      if (!ok) return;
      try {
        show($("detailResult"), "正在上传并绑定DOCX，请稍候。");
        const dataUrl = await readFileAsDataUrl(file);
        const result = await api(`/api/admin/students/${id}/current-plan-docx`, {
          method: "POST",
          body: JSON.stringify({
            file_name: file.name,
            data_url: dataUrl,
            note: "老师后台上传并绑定现成DOCX"
          })
        });
        currentDetail = await api(`/api/students/${id}`);
        show($("detailResult"), {
          ...result,
          file_url_full: absoluteUrl(result.file_url),
          current_plan: currentDetail.current_plan
        });
        await refreshCounts();
      } catch (error) {
        show($("detailResult"), String(error.message || error));
      }
    });
    $("createNextPlan").addEventListener("click", async (event) => {
      const id = $("detailStudentId").value;
      if (!id) return;
      await runOnce(`next-plan-${id}`, event.currentTarget, "生成中...", async () => {
        const result = await api(`/api/students/${id}/plans`, {
          method: "POST",
          body: JSON.stringify({
            plan_type: "adjustment",
            reason: "老师根据反馈生成下一版执行方案。",
            generate_files: true
          })
        });
        show($("detailResult"), result);
        await refreshCounts();
      });
    });
    $("publishCurrentPlan").addEventListener("click", async (event) => {
      const id = $("detailStudentId").value;
      if (!id) return;
      await runOnce(`publish-plan-${id}`, event.currentTarget, "发布中...", async () => {
        const detail = await api(`/api/students/${id}`);
        const planId = detail.current_plan && detail.current_plan.id;
        if (!planId) throw new Error("当前学生没有方案");
        const result = await api(`/api/plans/${planId}/publish`, {
          method: "POST",
          body: JSON.stringify({ notify_parent: true, generate_files: true })
        });
        currentDetail = await api(`/api/students/${id}`);
        syncStudentAccountFields(currentDetail);
        renderPlanEvidenceRefs(currentDetail);
        show($("detailResult"), { publish: result, detail: currentDetail });
        await refreshCounts();
      });
    });
    $("makeWeeklyReport").addEventListener("click", async (event) => {
      const id = $("detailStudentId").value;
      if (!id) return;
      await runOnce(`weekly-report-${id}`, event.currentTarget, "生成中...", async () => {
        const today = new Date();
        const start = new Date(today);
        start.setDate(today.getDate() - 6);
        const asDate = (d) => d.toISOString().slice(0, 10);
        const result = await api(`/api/students/${id}/weekly-report`, {
          method: "POST",
          body: JSON.stringify({ week_start: asDate(start), week_end: asDate(today) })
        });
        show($("detailResult"), result);
        await refreshCounts();
      });
    });
    $("loadLatestStudent").addEventListener("click", async () => {
      const students = await api("/api/students");
      if (students.items[0]) $("student_id").value = students.items[0].id;
    });

    $("feedback_date").valueAsDate = new Date();
    refreshCounts();
    loadEntitlementPresets().catch(() => {});
    loadParents().catch(() => {});
    loadModels().catch(() => {});
    loadVoiceSamples().catch(() => {});
    loadKnowledgeResources().catch(() => {});
    loadKnowledgePoints().catch(() => {});
    loadExamPatterns().catch(() => {});
    loadLearningCoverage().catch(() => {});
    loadCollectionTaskRecords().catch(() => {});
    loadScopeIndex().catch(() => {});
    loadAiJobs().catch(() => {});
  </script>
</body>
</html>
