<!doctype html>
<html lang="zh-CN">
<head>
<!-- xueji-fx-engine v8.3 · 像素 RPG · 标题屏 + 任务日志 + 对话框 -->
<script>
/* ============================================================
   学记 · 灯下书卷  v8 — fx-engine.js
   - PREVIEW_MODE：拦截 fetch 返回 503 + 占位数据（沿用 v7）
   - v8 全新：像素 RPG 视觉层
     · 标题屏 PRESS START（点击/Enter 进入主屏）
     · Canvas 像素星点背景
     · 主屏包裹 <main> 为 .frame（角色卡 / 任务日志 / 成就墙）
     · 任务日志 tab：主线 / 支线 / 图鉴 / 传说
     · 详情对话框：点击任务条目弹出，含 ◀ / ▶ / 关闭
   - 沿用：reveal / count-up / ripple / title-letters / preview-badge / toast
   - 全部带 prefers-reduced-motion 降级
   ============================================================ */

(function () {
  "use strict";
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const isMobile = /Mobi|Android|iPhone|iPad/i.test(navigator.userAgent);
  const isWeChat = /MicroMessenger/i.test(navigator.userAgent || "");

  /* ===========================================================
     0. 工具：占位数据
     =========================================================== */
  const previewFlag = new URLSearchParams(location.search).get("preview");
  const previewOn = previewFlag !== "0" && localStorage.getItem("xueji_preview_mode") !== "0";
  if (previewOn) localStorage.setItem("xueji_preview_mode", "1");

  const placeholder = {
    ok: (data) => ({ ok: true, status: 200, json: async () => data, text: async () => JSON.stringify(data) }),
    fail: (msg, code = 503) => ({
      ok: false, status: code,
      json: async () => ({ error: msg, detail: msg }),
      text: async () => JSON.stringify({ error: msg })
    })
  };

  function pickApiMock(url, method) {
    if (!previewOn) return null;
    const m = String(url || "");
    const path = m.replace(/^https?:\/\/[^/]+/, "").replace(/^\/xueji/, "");
    const isApi = /\/api\//.test(path) || /\/xueji\/health$/.test(m) || /\/xueji\/api\//.test(m);
    if (!isApi) return null;

    if (/health|ping|status/.test(path)) return placeholder.ok({ status: "ok", mode: "preview" });

    // 学生端
    if (/\/api\/student-access\/[^/]+\/today$/.test(path) && method === "GET") {
      return placeholder.ok(studentTodayMock());
    }
    if (/\/api\/student-access\/[^/]+\/voice-practice\/tts$/.test(path)) {
      return placeholder.ok({ audio_url: "", message: "预览模式：用浏览器朗读" });
    }
    if (/\/api\/student-access\/[^/]+\/voice-practice\/submissions$/.test(path)) {
      const score = 70 + Math.floor(Math.random() * 25);
      return placeholder.ok({ score, feedback: "预览模式评分：完成度不错，多读两遍更稳。" });
    }
    if (/\/api\/students\/login$/.test(path) && method === "POST") {
      return placeholder.ok({ token: "preview-student-token", account: { phone: "13800000000" } });
    }
    if (/\/api\/students\/logout$/.test(path)) {
      return placeholder.ok({ ok: true });
    }

    // 家长端
    if (/\/api\/parents\/login$/.test(path) && method === "POST") {
      return placeholder.ok({ token: "preview-parent-token", parent: { phone: "13800000000", nickname: "预览家长" } });
    }
    if (/\/api\/parents\/register$/.test(path) && method === "POST") {
      return placeholder.ok({ token: "preview-parent-token", parent: { phone: "13800000000", nickname: "预览家长" } });
    }
    if (/\/api\/parents\/me$/.test(path)) {
      return placeholder.ok({ parent: { phone: "13800000000", nickname: "预览家长" }, students: parentStudentsMock() });
    }
    if (/\/api\/parents\/intake$/.test(path) && method === "POST") {
      return placeholder.ok({ student: { id: 1, display_name: "预览同学", student_code: "PREVIEW-001" } });
    }
    if (/\/api\/parents\/logout$/.test(path)) {
      return placeholder.ok({ ok: true });
    }
    if (/plan$/.test(path) && method === "GET") {
      return placeholder.ok(planMock());
    }
    if (/plan$/.test(path) && method === "POST") {
      return placeholder.ok({ status: "queued", job_id: "preview-job-" + Date.now() });
    }
    if (/cards$/.test(path) && method === "GET") {
      return placeholder.ok({ docx_url: "https://example.com/preview.docx", updated_at: "2026-07-28" });
    }
    if (/cards$/.test(path) && method === "POST") {
      return placeholder.ok({ status: "queued", job_id: "preview-cards-" + Date.now() });
    }
    if (/voice-practice$/.test(path) && method === "GET") {
      return placeholder.ok({ items: voiceItemsMock() });
    }
    if (/feedbacks$/.test(path) && method === "POST") {
      return placeholder.ok({ status: "saved", feedback_id: "preview-fb-" + Date.now() });
    }
    if (/feedback-ai$/.test(path) && method === "POST") {
      return placeholder.ok({ status: "queued", job_id: "preview-ai-" + Date.now() });
    }
    if (/referrals$/.test(path)) {
      return placeholder.ok({ code: "PREVIEW-CODE", total_rewards: 0, items: [] });
    }

    // 后台 / tool-api
    if (/parents\/list$/.test(path)) {
      return placeholder.ok({ items: adminParentsMock() });
    }
    if (/students\/list$/.test(path)) {
      return placeholder.ok({ items: adminStudentsMock() });
    }
    if (/actions\/list$/.test(path)) {
      return placeholder.ok({ items: [] });
    }
    if (/ai-jobs\/list$/.test(path)) {
      return placeholder.ok({ items: [] });
    }
    if (/voice-samples$/.test(path)) {
      return placeholder.ok({ items: [] });
    }
    if (/knowledge-points$/.test(path)) {
      return placeholder.ok({ items: [] });
    }
    if (/knowledge-resources$/.test(path)) {
      return placeholder.ok({ items: [] });
    }
    if (/exam-patterns$/.test(path)) {
      return placeholder.ok({ items: [] });
    }
    if (/model-configs$/.test(path)) {
      return placeholder.ok({ items: [] });
    }
    if (/entitlements$/.test(path)) {
      return placeholder.ok({ items: [] });
    }
    if (/scope-index$/.test(path)) {
      return placeholder.ok({ items: [] });
    }
    if (/coverage$/.test(path)) {
      return placeholder.ok({ items: [] });
    }
    if (/collection-tasks$/.test(path)) {
      return placeholder.ok({ items: [] });
    }
    if (/collection-task-records$/.test(path)) {
      return placeholder.ok({ items: [] });
    }
    if (/student-detail$/.test(path) && method === "GET") {
      return placeholder.ok({ student: adminStudentsMock()[0], feedbacks: [], plans: [] });
    }
    return placeholder.fail("预览模式：该接口无占位数据", 503);
  }

  function studentTodayMock() {
    return {
      student: { display_name: "预览同学", grade_region: "初一 · 北京", goal: "期末基础抢分" },
      date: "2026-07-28",
      guide: { steps: ["英语跟读", "记忆故事", "知识卡", "往日回顾", "今日打卡"] },
      voice: {
        items: [
          { target_text: "Good morning, my friend.", target_meaning: "早上好，我的朋友。", scenario: "日常问候" },
          { target_text: "I finished my homework on time.", target_meaning: "我按时完成了作业。", scenario: "日常表达" },
          { target_text: "The weather is wonderful today.", target_meaning: "今天天气真好。", scenario: "天气描述" }
        ]
      },
      assessment: { quota: { limit: 5, remaining: 5 } },
      knowledge: {
        memory_story: "今天有一条新的记忆故事：一只小猫在灯下读完了整本书。重复一遍，关键词会留在脑海里。",
        cards: [
          { tag: "语文·古诗", q: "「床前明月光」的下一句？", a: "疑是地上霜。" },
          { tag: "数学·单位", q: "1 小时等于多少分钟？", a: "60 分钟。" },
          { tag: "英语·词汇", q: "\"book\" 的复数？", a: "books" }
        ],
        review_cards: [
          { tag: "复习 D1", q: "昨天记过的古诗第二句？", a: "疑是地上霜。" }
        ],
        history_days: [],
        current_day_index: 0,
        adjustment_note: "按 D1/D3/D7 间隔复习，优先处理★卡。"
      },
      account: { phone: "13800000000" }
    };
  }

  function parentStudentsMock() {
    return [
      { id: 1, display_name: "预览同学", student_code: "PREVIEW-001", grade_region: "初一 · 北京", goal: "期末基础抢分", current_level: "中等", execution_mode: "标准", student_account_phone: "13800000001" }
    ];
  }

  function planMock() {
    return {
      plan: {
        student_name: "预览同学",
        summary: "本周按 5 科路径排：语文 1 + 数学 1 + 英语 2 + 历史 1 + 道法 1，每天 6 格小步。",
        subjects: [
          { name: "语文", sessions: 1, focus: "古诗 + 字词" },
          { name: "数学", sessions: 1, focus: "方程基础" },
          { name: "英语", sessions: 2, focus: "跟读 + 词汇" },
          { name: "历史", sessions: 1, focus: "近代史脉络" },
          { name: "道法", sessions: 1, focus: "时政 + 答题方法" }
        ],
        weekly_pace: "5 天 / 周，每天 15-25 分钟"
      },
      versions: [
        { version_code: "V1", published_at: "2026-07-21", status: "published" }
      ]
    };
  }

  function voiceItemsMock() {
    return [
      { id: 1, target_text: "Open your book, please.", target_meaning: "请打开你的书。", scenario: "课堂指令" },
      { id: 2, target_text: "I have a question.", target_meaning: "我有一个问题。", scenario: "主动发言" }
    ];
  }

  function adminParentsMock() {
    return [
      { id: 1, phone: "13800000000", nickname: "预览家长", students_count: 1, package: "试用 7 天" }
    ];
  }

  function adminStudentsMock() {
    return [
      { id: 1, display_name: "预览同学", student_code: "PREVIEW-001", grade_region: "初一 · 北京", goal: "期末基础抢分", parent_phone: "13800000000", status: "在读" }
    ];
  }

  /* ===========================================================
     1. 拦截 fetch
     =========================================================== */
  if (previewOn && !window.__xuejiFetchPatched) {
    window.__xuejiFetchPatched = true;
    const origFetch = window.fetch.bind(window);
    window.fetch = async function (input, init) {
      let url = typeof input === "string" ? input : (input && input.url) || "";
      const method = (init && init.method) || (input && input.method) || "GET";
      const mock = pickApiMock(url, method);
      if (mock) {
        await new Promise(r => setTimeout(r, 80 + Math.random() * 100));
        return mock;
      }
      return origFetch(input, init);
    };
  }

  /* ===========================================================
     2. v8 像素 RPG 视觉层
     =========================================================== */

  /* --- 2.1 像素星点背景 canvas --- */
  function injectStars() {
    if (document.querySelector(".xueji-stars")) return;
    const canvas = document.createElement("canvas");
    canvas.className = "xueji-stars";
    canvas.setAttribute("aria-hidden", "true");
    document.body.appendChild(canvas);
    if (reducedMotion) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    let w = 0, h = 0, dpr = Math.max(1, Math.min(2, window.devicePixelRatio || 1));
    let stars = [];

    const COLORS = ["#FFD23F", "#5BC0EB", "#7BC950", "#FF6EC7", "#FFF8E7"];

    function resize() {
      w = window.innerWidth;
      h = window.innerHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      canvas.style.width = w + "px";
      canvas.style.height = h + "px";
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.min(120, Math.max(60, Math.floor((w * h) / 18000)));
      stars = [];
      for (let i = 0; i < count; i++) {
        stars.push({
          x: Math.floor(Math.random() * w),
          y: Math.floor(Math.random() * h),
          size: Math.random() < 0.85 ? 1 : 2,
          c: COLORS[Math.floor(Math.random() * COLORS.length)],
          tw: Math.random() * Math.PI * 2,
          sp: 0.02 + Math.random() * 0.04
        });
      }
    }

    function tick() {
      ctx.clearRect(0, 0, w, h);
      const t = performance.now() / 1000;
      for (const s of stars) {
        const a = 0.4 + 0.6 * (0.5 + 0.5 * Math.sin(t * s.sp * 6 + s.tw));
        ctx.globalAlpha = a;
        ctx.fillStyle = s.c;
        ctx.fillRect(s.x, s.y, s.size, s.size);
      }
      ctx.globalAlpha = 1;
      requestAnimationFrame(tick);
    }

    resize();
    if (!reducedMotion) requestAnimationFrame(tick);
    else {
      ctx.clearRect(0, 0, w, h);
      ctx.globalAlpha = 0.6;
      for (const s of stars) {
        ctx.fillStyle = s.c;
        ctx.fillRect(s.x, s.y, s.size, s.size);
      }
      ctx.globalAlpha = 1;
    }
    let resizeT = 0;
    window.addEventListener("resize", () => {
      clearTimeout(resizeT);
      resizeT = setTimeout(resize, 200);
    }, { passive: true });
  }

  /* --- 2.2 标题屏（PRESS START）--- */
  function detectPageMeta() {
    const path = (location.pathname || "").toLowerCase();
    if (path.includes("parent")) return { code: "PARENT", name: "家长终端", subtitle: "PARENT · 灯下书卷" };
    if (path.includes("student")) return { code: "STUDENT", name: "学生终端", subtitle: "STUDENT · 灯下书卷" };
    if (path.includes("loop_tool") || path.includes("tool")) return { code: "ADMIN", name: "调度终端", subtitle: "ADMIN · 灯下书卷" };
    return { code: "XUEJI", name: "灯下书卷", subtitle: "XUEJI · 灯下书卷" };
  }

  function injectTitleScreen() {
    if (new URLSearchParams(location.search).get("skip-title") === "1") return;
    if (document.querySelector(".title-screen")) return;
    const meta = detectPageMeta();
    const screen = document.createElement("div");
    screen.className = "title-screen";
    screen.setAttribute("role", "button");
    screen.setAttribute("tabindex", "0");
    screen.setAttribute("aria-label", "点击开始进入 " + meta.name);
    screen.innerHTML = `
      <div class="console">
        <div class="logo">学记 · 灯下书卷</div>
        <div class="subtitle">${meta.subtitle} · v8</div>
        <div class="press-start">▶ PRESS START · 按 ENTER 开始</div>
        <div class="hint">点击屏幕 / 敲击空格 / 按 ENTER 键 · 继续冒险</div>
        <div class="copy">© 2026 灯下书卷 · RPG QUEST LOG</div>
      </div>
    `;
    document.body.appendChild(screen);
    return screen;
  }

  function setupTitleScreen() {
    const screen = document.querySelector(".title-screen");
    if (!screen) return;
    let started = false;
    const start = () => {
      if (started) return;
      started = true;
      screen.classList.add("fade-out");
      setTimeout(() => {
        screen.setAttribute("hidden", "");
        if (window.xuejiToast) {
          window.xuejiToast("冒险开始 · 灯下书卷已就绪", { type: "good", pos: "tr", dur: 1800 });
        }
      }, 380);
    };
    screen.addEventListener("click", start);
    screen.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        start();
      }
    });
    const onceKey = (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        start();
        document.removeEventListener("keydown", onceKey);
      }
    };
    setTimeout(() => document.addEventListener("keydown", onceKey), 50);
  }

  /* --- 2.3 主屏包裹为 .frame --- */
  function wrapAsFrame() {
    const main = document.querySelector("main, .workarea");
    if (!main || main.classList.contains("frame")) return;
    const frame = document.createElement("div");
    frame.className = "frame";
    const top = document.createElement("div");
    top.className = "frame-top";
    const meta = detectPageMeta();
    top.textContent = "★ QUEST LOG · " + meta.name + " ★";
    const foot = document.createElement("div");
    foot.className = "frame-foot";
    foot.textContent = "v8 · 像素 RPG · 灯下书卷";
    while (main.firstChild) frame.appendChild(main.firstChild);
    main.appendChild(top);
    main.appendChild(frame);
    main.appendChild(foot);
  }

  /* --- 2.4 任务日志 tab + 详情对话框 --- */
  const QUEST_CATEGORIES = [
    { key: "all",    label: "全部",   cn: "全部" },
    { key: "main",   label: "主线",   cn: "主线" },
    { key: "side",   label: "支线",   cn: "支线" },
    { key: "codex",  label: "图鉴",   cn: "图鉴" },
    { key: "legend", label: "传说",   cn: "传说" }
  ];

  // 把现有元素按子节点位置 → 任务分类
  function classifyRow(el, indexInParent, totalInParent) {
    // 顺序：前 50% 视为主线；之后 30% 支线；最后 20% 传说
    const ratio = totalInParent <= 1 ? 0 : (indexInParent / (totalInParent - 1));
    if (ratio < 0.5) return "main";
    if (ratio < 0.8) return "side";
    return "legend";
  }

  // 过滤掉不合格的"任务条目"——例如隐藏的 tab content、纯数字标签、空标题
  function isValidQuest(el) {
    // 1) 不能在隐藏元素里
    if (el.closest('[hidden], .hidden, [style*="display: none"], [style*="display:none"]')) return false;
    // 2) 不能在 .tab-content 容器里（学生端每个标签页的内容）—— 避免重复任务
    if (el.closest('.tab-content, .tab-pane, [role="tabpanel"][aria-hidden="true"]')) return false;
    // 3) 元素可见
    const rect = el.getBoundingClientRect();
    if (rect.width === 0 || rect.height === 0) return false;
    // 4) 不能是 input/button/form 本身
    if (el.matches('input, button, form, select, textarea, label, a[href]')) return false;
    return true;
  }

  // 提取更好的标题
  function pickTitle(el) {
    // 优先取 strong
    const strong = el.querySelector("strong, .quick-name, .title, .name, h1, h2, h3, h4");
    if (strong) {
      const t = strong.textContent.trim();
      if (t && t.length >= 2) return t;
    }
    // 退而取元素的纯文本（去掉数字干扰）
    const text = (el.textContent || "").replace(/\s+/g, " ").trim();
    return text.slice(0, 20);
  }

  // 描述
  function pickDesc(el) {
    const descEl = el.querySelector("p, .desc, .quick-desc, .sub, .label, span");
    return (descEl ? descEl.textContent.replace(/\s+/g, " ").trim() : "").slice(0, 80);
  }

  function buildQuestList() {
    const sels = [
      ".trust-strip > *",
      ".today-grid > *",
      ".ops-grid > *",
      ".steps > *",
      ".student-trust > *",
      ".quick-tile",
      ".guide-card",
      ".student-card",
      ".knowledge-card",
      ".voice-card"
    ];
    const seen = new Set();
    const rows = [];
    sels.forEach(sel => {
      document.querySelectorAll(sel).forEach((el) => {
        if (el.dataset.questBound === "1") return;
        if (!isValidQuest(el)) return;
        // 去重：相同 strong 文本的只取一次
        const title = pickTitle(el);
        if (!title || title.length < 2) return;
        // 过滤纯数字/单字标签（如 "0问"、"3"）
        if (/^[\d\s\.,:·、，：。]+$/.test(title)) return;
        if (seen.has(title)) return;
        seen.add(title);
        el.dataset.questBound = "1";
        el.classList.add("q-row-clickable");

        const desc = pickDesc(el);
        const parent = el.parentElement;
        const sibs = parent ? parent.children : [el];
        const idxInParent = Array.prototype.indexOf.call(sibs, el);
        const cat = classifyRow(el, idxInParent, sibs.length);
        const exp = 20 + (rows.length % 5) * 30;
        rows.push({
          el, title, desc, cat, exp,
          isDone: el.classList.contains("done") || el.dataset.done === "1",
          isPinned: el.classList.contains("pinned") || el.dataset.pinned === "1"
        });
      });
    });
    return rows;
  }

  function buildQuestSection(quests) {
    if (document.querySelector(".quest.xueji-quest-log")) return;
    const host = document.querySelector("main, .workarea") || document.body;

    const section = document.createElement("section");
    section.className = "quest xueji-quest-log";
    section.style.cssText = "padding: 16px 24px;";
    section.innerHTML = `
      <div class="tabs" data-xueji-tabs>
        ${QUEST_CATEGORIES.map((c, i) => `
          <button type="button" class="tab ${i === 0 ? "active" : ""}" data-cat="${c.key}">
            ${c.label}<span class="c">0</span>
          </button>
        `).join("")}
      </div>
      <div class="q-list" data-xueji-qlist></div>
    `;
    host.appendChild(section);

    const tabsHost = section.querySelector("[data-xueji-tabs]");
    const listHost = section.querySelector("[data-xueji-qlist]");
    function recount() {
      const counts = { all: quests.length, main: 0, side: 0, codex: 0, legend: 0 };
      quests.forEach(q => { counts[q.cat] = (counts[q.cat] || 0) + 1; });
      tabsHost.querySelectorAll(".tab").forEach(t => {
        const k = t.dataset.cat;
        const c = counts[k] || 0;
        t.querySelector(".c").textContent = c;
      });
    }
    recount();

    function render(filter) {
      const items = quests
        .map((q, i) => ({ q, i }))
        .filter(({ q }) => filter === "all" ? true : q.cat === filter);
      listHost.innerHTML = items.map(({ q, i }) => {
        const tagClass = "tag-" + q.cat;
        const tagLabel = (QUEST_CATEGORIES.find(c => c.key === q.cat) || {}).label || "主线";
        return `
          <div class="q-row" data-idx="${i}" data-qidx="${quests.indexOf(q)}">
            <span class="q-check ${q.isDone ? "" : "un"}">${q.isDone ? "✔" : "○"}</span>
            <div>
              <div class="q-title">${escapeHtml(q.title)}</div>
              <div class="q-cat">${tagLabel} · 任务 #${(quests.indexOf(q) + 1).toString().padStart(2, "0")}${q.isPinned ? '<span class="q-pin"> ★ 置顶</span>' : ""}</div>
            </div>
            <span class="d-tag ${tagClass}">${tagLabel}</span>
            <span class="q-exp">+${q.exp} EXP</span>
          </div>
        `;
      }).join("") || `<div class="q-row" style="cursor:default"><span class="q-check un">○</span><div class="q-title">当前分类暂无任务</div><span></span><span></span></div>`;
      listHost.querySelectorAll(".q-row").forEach(row => {
        if (row.dataset.bound === "1") return;
        row.dataset.bound = "1";
        row.addEventListener("click", () => {
          const idx = parseInt(row.dataset.qidx, 10);
          openDialogue(quests[idx]);
        });
      });
    }

    tabsHost.querySelectorAll(".tab").forEach(t => {
      t.addEventListener("click", () => {
        tabsHost.querySelectorAll(".tab").forEach(x => x.classList.remove("active"));
        t.classList.add("active");
        render(t.dataset.cat);
      });
    });

    render("all");
  }

  function escapeHtml(s) {
    return String(s || "").replace(/[&<>"']/g, c => ({
      "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
    }[c]));
  }

  /* --- 2.5 详情对话框 --- */
  let dialogueOpen = false;
  let dialogueList = [];
  let dialogueIndex = 0;

  function ensureDialogueHost() {
    if (document.querySelector(".dialogue.xueji-dialogue")) return;
    const d = document.createElement("div");
    d.className = "dialogue xueji-dialogue";
    d.setAttribute("hidden", "");
    d.innerHTML = `
      <div class="d-head">
        <span class="d-name">NPC · 灯下书卷</span>
        <span class="d-tag tag-main" data-xueji-dtag>主线</span>
      </div>
      <div class="d-body" data-xueji-dbody></div>
      <div class="d-foot">
        <span class="d-next" data-xueji-dnext>▼ 按 ESC 关闭 · 方向键切换</span>
        <div class="d-actions">
          <button type="button" data-xueji-dprev>◀ 上页</button>
          <button type="button" data-xueji-dnext-btn>下页 ▶</button>
          <button type="button" data-xueji-dclose>关闭 ✕</button>
        </div>
      </div>
    `;
    document.body.appendChild(d);
    d.querySelector("[data-xueji-dprev]").addEventListener("click", () => moveDialogue(-1));
    d.querySelector("[data-xueji-dnext-btn]").addEventListener("click", () => moveDialogue(+1));
    d.querySelector("[data-xueji-dclose]").addEventListener("click", closeDialogue);
  }

  function openDialogue(item) {
    if (!item) return;
    dialogueList = Array.from(document.querySelectorAll(".xueji-quest-log .q-row"))
      .map(r => parseInt(r.dataset.qidx, 10))
      .map(i => window.__xuejiQuests ? window.__xuejiQuests[i] : null)
      .filter(Boolean);
    dialogueIndex = dialogueList.indexOf(item);
    if (dialogueIndex < 0) dialogueIndex = 0;
    renderDialogue();
  }

  function renderDialogue() {
    const d = document.querySelector(".dialogue.xueji-dialogue");
    if (!d) return;
    const item = dialogueList[dialogueIndex];
    if (!item) {
      closeDialogue();
      return;
    }
    d.removeAttribute("hidden");
    dialogueOpen = true;
    const tag = d.querySelector("[data-xueji-dtag]");
    const labelMap = { main: "主线", side: "支线", codex: "图鉴", legend: "传说" };
    tag.className = "d-tag tag-" + item.cat;
    tag.textContent = labelMap[item.cat] || "主线";
    const body = d.querySelector("[data-xueji-dbody]");
    const expLine = `<p style="color: var(--gold); font-family: var(--font-mono);">+${item.exp} EXP · 任务奖励</p>`;
    body.innerHTML = `
      <h2>${escapeHtml(item.title)}</h2>
      <p>${item.desc ? escapeHtml(item.desc) : "本任务包含一段剧情或操作说明，点击「下页」可继续浏览；按 ESC 可关闭对话框。"}${item.isDone ? '<span style="color: var(--green); margin-left: 8px;">✔ 已完成</span>' : ""}</p>
      ${expLine}
      <h3>任务指引</h3>
      <ul>
        <li>查看顶部状态条（HP / MP / EXP）确认角色状态</li>
        <li>点击主菜单「继续冒险」或「成就墙」可切换主屏</li>
        <li>不确定时回「任务日志」切换分类（主线 / 支线 / 图鉴 / 传说）</li>
      </ul>
    `;
    d.querySelector("[data-xueji-dprev]").disabled = dialogueIndex <= 0;
    d.querySelector("[data-xueji-dnext-btn]").disabled = dialogueIndex >= dialogueList.length - 1;
    d.querySelector("[data-xueji-dnext]").textContent =
      `▼ 第 ${dialogueIndex + 1} / ${dialogueList.length} 条 · ESC 关闭 · 方向键切换`;
  }

  function moveDialogue(delta) {
    if (!dialogueOpen) return;
    const next = dialogueIndex + delta;
    if (next < 0 || next >= dialogueList.length) return;
    dialogueIndex = next;
    renderDialogue();
  }

  function closeDialogue() {
    const d = document.querySelector(".dialogue.xueji-dialogue");
    if (!d) return;
    d.setAttribute("hidden", "");
    dialogueOpen = false;
  }

  document.addEventListener("keydown", (e) => {
    if (!dialogueOpen) return;
    if (e.key === "Escape") { closeDialogue(); e.preventDefault(); return; }
    if (e.key === "ArrowLeft") { moveDialogue(-1); e.preventDefault(); }
    if (e.key === "ArrowRight") { moveDialogue(+1); e.preventDefault(); }
  });

  /* ===========================================================
     3. Preview 徽章
     =========================================================== */
  function injectPreviewBadge() {
    if (!previewOn) return;
    if (document.querySelector(".preview-badge")) return;
    const badge = document.createElement("span");
    badge.className = "preview-badge";
    badge.textContent = "预览模式 · 无后端";
    badge.title = "当前为无后端预览模式，所有 /api/* 请求被模拟返回";
    document.body.appendChild(badge);
  }

  /* ===========================================================
     4. 动效引擎（沿用 v7）
     =========================================================== */
  function setupReveal() {
    if (reducedMotion) {
      document.querySelectorAll(".fx-reveal").forEach(el => el.classList.add("in"));
      return;
    }
    const targets = document.querySelectorAll("section, .today-overview, .student-card, .guide-card, .ops-card, .today-cell, .trust-item, .step, .knowledge-card, .voice-card, .card, .auth-panel, .hero, .quest");
    targets.forEach((el, idx) => {
      el.classList.add("fx-reveal");
      el.style.transitionDelay = Math.min(idx * 30, 200) + "ms";
    });
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add("in");
          io.unobserve(e.target);
        }
      });
    }, { rootMargin: "-40px", threshold: 0.05 });
    targets.forEach(el => io.observe(el));
  }

  function setupCountUp() {
    if (reducedMotion) return;
    const animate = (el) => {
      const text = (el.textContent || "").trim();
      const match = text.match(/^(-?[\d,]+(?:\.\d+)?)(.*)$/);
      if (!match) return;
      const target = parseFloat(match[1].replace(/,/g, ""));
      const suffix = match[2] || "";
      if (!isFinite(target) || target === 0) return;
      const dur = 900;
      const start = performance.now();
      const from = 0;
      const tick = (now) => {
        const t = Math.min(1, (now - start) / dur);
        const eased = 1 - Math.pow(1 - t, 3);
        const val = from + (target - from) * eased;
        el.textContent = (Number.isInteger(target) ? Math.round(val).toLocaleString() : val.toFixed(1)) + suffix;
        if (t < 1) requestAnimationFrame(tick);
        else el.textContent = (Number.isInteger(target) ? target.toLocaleString() : target.toFixed(1)) + suffix;
      };
      requestAnimationFrame(tick);
    };
    const candidates = document.querySelectorAll("#studentCount, #actionCount, .today-cell strong, .meter span[data-num]");
    candidates.forEach((el, idx) => {
      setTimeout(() => animate(el), 300 + idx * 80);
    });
  }

  function setupRipple() {
    if (reducedMotion) return;
    document.addEventListener("pointerdown", (e) => {
      const btn = e.target.closest("button:not(.no-ripple)");
      if (!btn || btn.disabled) return;
      const rect = btn.getBoundingClientRect();
      const r = Math.max(rect.width, rect.height);
      const ink = document.createElement("span");
      ink.className = "ripple";
      ink.style.width = ink.style.height = r + "px";
      ink.style.left = (e.clientX - rect.left - r / 2) + "px";
      ink.style.top = (e.clientY - rect.top - r / 2) + "px";
      btn.appendChild(ink);
      setTimeout(() => ink.remove(), 700);
    }, { passive: true });
  }

  function setupMeterSheen() {
    if (reducedMotion) return;
    document.querySelectorAll(".meter span").forEach(span => {
      const pct = parseFloat(span.dataset.value || span.textContent || "0");
      if (pct) {
        setTimeout(() => { span.style.width = pct + "%"; }, 200);
      }
    });
  }

  function setupTitleLetters() {
    if (reducedMotion) return;
    document.querySelectorAll("[data-title-letters]").forEach(el => {
      if (el.dataset.lettered === "1") return;
      el.dataset.lettered = "1";
      const text = el.textContent || "";
      el.textContent = "";
      el.classList.add("title-letters");
      [...text].forEach((ch, i) => {
        const span = document.createElement("span");
        span.textContent = ch === " " ? "\u00A0" : ch;
        span.style.animationDelay = (i * 60) + "ms";
        el.appendChild(span);
      });
    });
  }

  function setupCarousel() {
    document.querySelectorAll(".row-carousel").forEach(c => {
      c.setAttribute("tabindex", "0");
      c.setAttribute("role", "region");
      c.setAttribute("aria-label", "横向滑动浏览");
    });
  }

  /* ===========================================================
     5. Toast 简易 API
     =========================================================== */
  window.xuejiToast = function (msg, opts = {}) {
    const { type = "info", pos = "tr", dur = 2400 } = opts;
    let host = document.querySelector(".toast-host." + pos);
    if (!host) {
      host = document.createElement("div");
      host.className = "toast-host " + pos;
      document.body.appendChild(host);
    }
    const t = document.createElement("div");
    t.className = "toast " + type;
    t.textContent = msg;
    host.appendChild(t);
    setTimeout(() => {
      t.classList.add("out");
      setTimeout(() => t.remove(), 320);
    }, dur);
  };

  /* ===========================================================
     6. 初始化
     =========================================================== */
  function init() {
    injectStars();
    injectTitleScreen();
    setupTitleScreen();
    injectPreviewBadge();
    ensureDialogueHost();
    setupReveal();
    setupCountUp();
    setupRipple();
    setupMeterSheen();
    setupTitleLetters();
    setupCarousel();

    setTimeout(() => {
      try {
        wrapAsFrame();
        const quests = buildQuestList();
        window.__xuejiQuests = quests;
        if (quests.length > 0) {
          buildQuestSection(quests);
        } else {
          // 没有任何候选任务时，注入一段 RPG 教程任务
          const seed = [
            { title: "认识灯下书卷", desc: "学记是游戏化学习任务系统，把学习包装成主线 / 支线 / 图鉴 / 传说四类任务。", cat: "main", exp: 50 },
            { title: "完成今日 5 步学习流", desc: "跟读 / 记忆故事 / 知识卡 / 往日回顾 / 今日打卡，每天 5 步。", cat: "main", exp: 80 },
            { title: "查看家长端计划", desc: "家长端会按 5 科路径排计划，确认后再生成知识卡。", cat: "side", exp: 30 },
            { title: "知识图鉴", desc: "复习 D1 / D3 / D7 间隔循环，错卡优先回炉。", cat: "codex", exp: 60 },
            { title: "每日反馈", desc: "记录完成数、会了几张、情绪和★卡，决定下一版调整。", cat: "side", exp: 40 },
            { title: "邀请好友", desc: "邀请其他家长加入，双方各得 7 天权益。", cat: "legend", exp: 200 }
          ];
          window.__xuejiQuests = seed;
          buildQuestSection(seed);
        }
      } catch (err) {
        console.warn("[xueji] v8 frame/quest 初始化失败：", err);
      }
    }, 60);

    if (previewOn) {
      setTimeout(() => {
        window.xuejiToast("预览模式：所有 /api/* 由本引擎模拟返回", { type: "warn", pos: "tr" });
      }, 600);
    }
    if (isWeChat) {
      console.info("[xueji] 微信内置浏览器已识别：safe-area-inset-* 已应用");
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();

</script>

<meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>学记教育家长端</title>
  <style>
/* ============================================================
   学记 · 灯下书卷  v8 — 像素 RPG 主题（参考 ZeroXCore 模板扩展）
   ============================================================
   设计方向：RPG 任务日志
   - 视觉：深紫夜底 + 像素金/绿/蓝/粉 + 4px 硬边 + 中文等宽
   - 字体：Press Start 2P / ZCOOL QingKe HuangYou / VT323 / Noto Sans SC
   - UX 三屏：标题屏 → 主屏（角色卡 + 任务 + 菜单）→ 详情对话框
   - 分类术语：主线 / 支线 / 图鉴 / 传说
   - 状态条：HP / MP / EXP（对应学习数据 / 复习强度 / 累计经验）
   ============================================================ */

@import url('https://miaoda.feishu.cn/fonts/css2?family=Press+Start+2P&family=ZCOOL+QingKe+HuangYou&family=VT323&family=DotGothic16&family=Noto+Sans+SC:wght@400;500;700;900&display=swap');

:root {
  /* === 像素 RPG 调色板（v8）=== */
  --night:        #1A1330;   /* 主背景：深紫夜 */
  --night-2:      #2B2140;   /* 二级背景：紫罗兰 */
  --panel:        #3A2C57;   /* 面板底：紫雾 */
  --panel-2:      #4A3972;   /* 面板高：雾紫 */
  --gold:         #FFD23F;   /* 像素金：主色 */
  --gold-2:       #E0A100;   /* 暗金：边框 */
  --green:        #7BC950;   /* HP / 成功：竹绿 */
  --green-2:      #5BA234;
  --blue:         #5BC0EB;   /* MP / 信息：青蓝 */
  --blue-2:       #1B6FAA;
  --pink:         #FF6EC7;   /* 传说 / 置顶：樱粉 */
  --rose:         #FF8FA3;
  --cinnabar:     #FF6B5B;   /* 警告 / 朱砂 */
  --white:        #FFF8E7;   /* 主文字：米白 */
  --shadow:       #0A0716;   /* 投影：近黑 */
  --line:         #4A3972;   /* 通用描边 */

  /* === 字体 === */
  --font-pixel: "Press Start 2P", "ZCOOL QingKe HuangYou", "DotGothic16", monospace;
  --font-cn:   "ZCOOL QingKe HuangYou", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif;
  --font-mono: "VT323", "DotGothic16", ui-monospace, "Cascadia Code", "Menlo", monospace;

  /* === 8px 栅格 + 圆角（保留） === */
  --s-1: 4px;
  --s-2: 8px;
  --s-3: 12px;
  --s-4: 16px;
  --s-5: 24px;
  --s-6: 32px;
  --s-7: 48px;
  --s-8: 64px;
  --s-9: 96px;
  --r-sm: 0;
  --r-md: 0;
  --r-lg: 0;
  --r-xl: 0;
  --container: 1200px;

  /* === v8.2 布局系统 === */
  --layout-max: 1180px;
  --layout-gutter: clamp(8px, 2vw, 24px);
  --section-pad: clamp(16px, 2.4vw, 28px);
  --control-min-h: 42px;
  --touch-min-h: 44px;
  --sidebar-min: 340px;

  /* === 缓动（保留） === */
  --ease: cubic-bezier(.22,.61,.36,1);
  --ease-out: cubic-bezier(.16,1,.3,1);
  --dur-fast: .14s;
  --dur-base: .24s;
}

/* ============================================================
   基础
   ============================================================ */
* { box-sizing: border-box; margin: 0; padding: 0; image-rendering: pixelated; }
html, body { height: 100%; }
html { scroll-behavior: smooth; }
body {
  background: var(--night);
  color: var(--white);
  font-family: var(--font-cn);
  font-size: 16px;
  line-height: 1.75;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: geometricPrecision;
  min-height: 100vh;
  /* 像素点阵背景（CSS 实现） */
  background-image:
    radial-gradient(rgba(91,192,235,.06) 1px, transparent 1px),
    radial-gradient(rgba(255,210,63,.04) 1px, transparent 1px);
  background-size: 32px 32px, 56px 56px;
  background-position: 0 0, 16px 16px;
}

/* 全局字体 fallback · v8.1 松绑：加大行距 + 放宽字间距 */
h1, h2, h3, h4 {
  font-family: var(--font-cn);
  font-weight: 700;
  letter-spacing: 0.06em;
  color: var(--white);
  line-height: 1.4;
  overflow-wrap: anywhere;
  word-break: break-word;
}
h1 { font-size: 24px; margin-bottom: 12px; }
h2 { font-size: 19px; margin-bottom: 10px; }
h3 { font-size: 16px; margin-bottom: 8px; }
p, li, dd, dt, label, input, button, select, textarea, a { font-family: var(--font-cn); color: var(--white); line-height: 1.7; }
p { margin-bottom: 12px; }
a { color: var(--gold); text-decoration: none; }
a:hover { color: var(--white); }
code, kbd, pre, samp { font-family: var(--font-mono); font-size: 16px; color: var(--green); }
strong, b { color: var(--gold); font-weight: 700; }

/* 像素星点 canvas（fx-engine 注入） */
.xueji-stars { position: fixed; inset: 0; z-index: 0; width: 100%; height: 100%; pointer-events: none; image-rendering: pixelated; }

/* ============================================================
   像素 RPG 屏
   ============================================================ */
/* 内容层永远在星空之上 */
main, header, nav, footer, section, .frame, .dialogue, .title-screen, .card-screen { position: relative; z-index: 2; }

/* === 通用 frame（角色卡 / 任务日志 / 成就墙） · v8.1 松绑 === */
.frame {
  background: var(--night-2);
  border: 4px solid var(--white);
  box-shadow: inset 0 0 0 4px var(--night-2), inset 0 0 0 8px var(--gold-2), 0 0 0 4px var(--shadow);
  padding: 0;
  max-width: 1180px;
  width: calc(100% - 32px);
  margin: var(--s-6) auto;
  position: relative;
  animation: frame-in .4s var(--ease-out) both;
  overflow: hidden;
}
@keyframes frame-in {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 1; transform: translateY(0); }
}
.frame-top {
  background: var(--gold);
  color: var(--shadow);
  font-family: var(--font-pixel);
  font-size: 12px;
  padding: 14px 24px;
  letter-spacing: 0.08em;
  text-align: center;
  border-bottom: 4px solid var(--white);
  white-space: normal;
  word-break: break-all;
  line-height: 1.5;
}
.frame-foot {
  background: var(--night);
  color: var(--blue);
  font-family: var(--font-pixel);
  font-size: 10px;
  padding: 12px 24px;
  letter-spacing: 0.06em;
  text-align: right;
  border-top: 4px solid var(--white);
}

/* === 标题屏（PRESS START） === */
.title-screen {
  position: fixed;
  inset: 0;
  z-index: 5;
  background: var(--night);
  display: grid;
  place-items: center;
  padding: var(--s-6);
  cursor: pointer;
  animation: screen-in .6s var(--ease-out) both;
  overflow: hidden;
}
.title-screen[hidden] { display: none; }
@keyframes screen-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}
.title-screen .console { text-align: center; max-width: 760px; padding: 0 var(--s-4); }
.title-screen .logo {
  font-family: var(--font-pixel);
  font-size: clamp(28px, 6vw, 48px);
  color: var(--gold);
  text-shadow: 4px 4px 0 var(--shadow), 8px 8px 0 var(--gold-2);
  letter-spacing: 0.06em;
  line-height: 1.3;
  margin-bottom: 20px;
  animation: logo-float 2.4s var(--ease) infinite alternate;
  overflow-wrap: anywhere;
}
@keyframes logo-float {
  from { transform: translateY(0); }
  to   { transform: translateY(-6px); }
}
.title-screen .subtitle {
  font-family: var(--font-pixel);
  color: var(--white);
  font-size: 13px;
  letter-spacing: 0.08em;
  line-height: 1.7;
  opacity: 0.9;
  margin-bottom: 36px;
  overflow-wrap: anywhere;
}
.title-screen .copy {
  font-family: var(--font-pixel);
  color: var(--gold-2);
  font-size: 11px;
  margin-top: 36px;
  letter-spacing: 0.06em;
  line-height: 1.7;
  overflow-wrap: anywhere;
}
.title-screen .press-start {
  font-family: var(--font-pixel);
  color: var(--white);
  margin-top: 44px;
  font-size: 17px;
  letter-spacing: 0.06em;
  line-height: 1.5;
  animation: blink 1.2s steps(2) infinite;
  overflow-wrap: anywhere;
}
@keyframes blink { 50% { opacity: 0; } }
.title-screen .hint {
  font-family: var(--font-pixel);
  color: var(--blue);
  font-size: 11px;
  margin-top: 18px;
  letter-spacing: 0.04em;
  line-height: 1.6;
  opacity: 0.75;
  overflow-wrap: anywhere;
}

/* === 角色卡（HP/MP/EXP + 装备 + 属性） · v8.1 松绑 === */
.card-grid {
  display: grid;
  grid-template-columns: minmax(200px, 240px) minmax(0, 1fr);
  gap: var(--s-6);
  padding: var(--s-6) var(--s-6);
  align-items: start;
}
.portrait {
  background: var(--night);
  border: 4px solid var(--gold);
  padding: var(--s-4);
  aspect-ratio: 1/1;
  display: grid;
  place-items: center;
  position: relative;
  overflow: hidden;
  width: 100%;
  min-width: 0;
}
.portrait-inner { position: relative; width: 100%; height: 100%; }
.portrait-inner .hat {
  position: absolute; top: 8%; left: 50%; transform: translateX(-50%);
  width: 60%; height: 18%; background: var(--gold);
  border: 3px solid var(--shadow);
}
.portrait-inner .face {
  position: absolute; top: 24%; left: 50%; transform: translateX(-50%);
  width: 60%; height: 32%; background: #F5D5A8;
  border: 3px solid var(--shadow);
}
.portrait-inner .body {
  position: absolute; bottom: 4%; left: 50%; transform: translateX(-50%);
  width: 80%; height: 32%; background: var(--blue-2);
  border: 3px solid var(--shadow);
}

/* === Stats / bars · v8.1 松绑：放大字号 + 允许换行 === */
.stats { min-width: 0; }
.stats .name {
  font-family: var(--font-pixel);
  font-size: 18px;
  color: var(--gold);
  letter-spacing: 0.06em;
  text-shadow: 2px 2px 0 var(--shadow);
  display: flex;
  align-items: baseline;
  gap: var(--s-3);
  flex-wrap: wrap;
  line-height: 1.5;
  word-break: break-word;
}
.stats .lv { font-size: 12px; color: var(--green); }
.stats .class {
  font-family: var(--font-pixel);
  color: var(--white);
  font-size: 11px;
  letter-spacing: 0.06em;
  margin-top: var(--s-3);
  opacity: 0.85;
  line-height: 1.6;
  word-break: break-word;
}
.bars { margin-top: var(--s-5); display: grid; gap: var(--s-3); }
.bar {
  display: grid;
  grid-template-columns: 56px minmax(0, 1fr) 80px;
  align-items: center;
  gap: var(--s-3);
  min-width: 0;
}
.bar .lbl { font-family: var(--font-pixel); color: var(--white); font-size: 11px; letter-spacing: 0.06em; }
.bar .val { font-family: var(--font-mono); color: var(--gold); font-size: 18px; text-align: right; white-space: nowrap; }
.track {
  height: 18px;
  background: var(--night);
  border: 2px solid var(--white);
  position: relative;
  overflow: hidden;
  min-width: 0;
}
.fill { height: 100%; transition: width 1.2s var(--ease-out); }
.fill.hp { background: linear-gradient(90deg, var(--green-2), var(--green)); }
.fill.mp { background: linear-gradient(90deg, var(--blue-2), var(--blue)); }
.fill.exp { background: linear-gradient(90deg, var(--gold-2), var(--gold)); }

/* === 装备栏（对应 v6/v7 .trust-strip） · v8.1 松绑 === */
.equips {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px 28px;
  margin-top: var(--s-5);
  min-width: 0;
}
.eq {
  font-family: var(--font-mono);
  color: var(--white);
  font-size: 17px;
  display: flex;
  gap: 12px;
  padding: 6px 0;
  border-bottom: 2px dashed var(--panel);
  line-height: 1.55;
  min-width: 0;
}
.eq .k { color: var(--blue); font-size: 13px; min-width: 56px; font-family: var(--font-pixel); flex-shrink: 0; }
.eq .v { color: var(--white); word-break: break-word; min-width: 0; }

/* === 属性三段（HP/MP/EXP 数字 + 标签） · v8.1 松绑 === */
.nums {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--s-4);
  margin-top: var(--s-5);
  border-top: 2px dashed var(--panel);
  padding-top: var(--s-4);
}
.num { text-align: center; font-family: var(--font-pixel); min-width: 0; }
.num b {
  display: block;
  color: var(--gold);
  font-size: 22px;
  text-shadow: 2px 2px 0 var(--shadow);
  font-family: var(--font-mono);
  font-weight: 400;
  line-height: 1.2;
  word-break: break-all;
}
.num span { color: var(--white); font-size: 11px; letter-spacing: 0.06em; opacity: 0.75; line-height: 1.5; }

/* === 主菜单（继续冒险 / 成就墙 / 设置 / 退出） · v8.1 松绑 === */
.menu { border-top: 4px solid var(--white); padding: var(--s-4) var(--s-5); background: var(--night); }
.menu-item {
  font-family: var(--font-pixel);
  color: var(--white);
  font-size: 12px;
  padding: 12px 6px;
  letter-spacing: 0.06em;
  cursor: pointer;
  border-bottom: 2px dashed var(--panel);
  line-height: 1.5;
  transition: color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
}
.menu-item:last-child { border-bottom: 0; }
.menu-item:hover, .menu-item:focus, .menu-item.is-on {
  color: var(--gold);
  outline: none;
  transform: translateX(4px);
}
.menu-item:hover::before, .menu-item:focus::before, .menu-item.is-on::before { content: "▶ "; color: var(--gold); }
.menu-item.disabled { color: var(--panel-2); cursor: not-allowed; }

/* === 任务日志（list） · v8.1 松绑 === */
.quest { padding: var(--s-6) var(--s-6); }
.quest .tabs {
  display: flex;
  gap: var(--s-3);
  margin-bottom: var(--s-5);
  flex-wrap: wrap;
  border-bottom: 4px solid var(--white);
  padding-bottom: var(--s-4);
}
.quest .tab {
  font-family: var(--font-pixel);
  font-size: 12px;
  color: var(--white);
  padding: 10px 18px;
  background: var(--night);
  border: 3px solid var(--white);
  cursor: pointer;
  letter-spacing: 0.06em;
  line-height: 1.5;
  white-space: nowrap;
  transition: all var(--dur-fast) var(--ease-out);
}
.quest .tab.active {
  background: var(--gold);
  color: var(--shadow);
  border-color: var(--gold-2);
  transform: translateY(-2px);
  box-shadow: 0 4px 0 var(--shadow);
}
.quest .tab:hover { color: var(--gold); }
.quest .tab.active:hover { color: var(--shadow); }
.quest .tab .c { color: var(--gold); margin-left: 10px; font-family: var(--font-mono); font-size: 15px; }
.quest .tab.active .c { color: var(--shadow); }

.q-row {
  display: grid;
  grid-template-columns: 32px minmax(0, 1fr) auto auto;
  align-items: center;
  padding: 16px 18px;
  border: 2px solid var(--panel-2);
  background: var(--night);
  margin-bottom: 8px;
  cursor: pointer;
  gap: var(--s-3);
  min-width: 0;
  transition: transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
}
.q-row > div { min-width: 0; }
.q-row:hover {
  transform: translate(-2px, -2px);
  box-shadow: 4px 4px 0 var(--gold-2);
  border-color: var(--gold);
}
.q-row.done .q-title { color: var(--gold); }
.q-row .q-check { font-family: var(--font-pixel); color: var(--green); font-size: 16px; line-height: 1; }
.q-row .q-check.un { color: var(--panel-2); }
.q-row .q-title {
  font-family: var(--font-cn);
  font-size: 17px;
  color: var(--white);
  font-weight: 700;
  line-height: 1.5;
  word-break: break-word;
  overflow-wrap: anywhere;
}
.q-row .q-cat {
  font-family: var(--font-pixel);
  font-size: 10px;
  color: var(--blue);
  letter-spacing: 0.06em;
  line-height: 1.5;
  margin-top: 4px;
  word-break: break-word;
}
.q-row .q-exp { font-family: var(--font-mono); color: var(--gold); font-size: 16px; text-align: right; white-space: nowrap; padding-left: 8px; }
.q-row .q-pin { color: var(--pink); }
.q-row .q-star { color: var(--pink); margin-left: 4px; }

/* === 详情对话框（点击任务弹出） · v8.1 松绑 === */
.dialogue {
  position: fixed;
  bottom: 24px;
  left: 24px;
  right: 24px;
  z-index: 20;
  max-width: 960px;
  margin: 0 auto;
  background: var(--night-2);
  border: 4px solid var(--white);
  box-shadow: inset 0 0 0 4px var(--night-2), inset 0 0 0 8px var(--gold), 0 0 0 4px var(--shadow);
  padding: var(--s-5) var(--s-6);
  animation: dialogue-up .3s var(--ease-out) both;
  max-height: 70vh;
  overflow-y: auto;
}
@keyframes dialogue-up {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}
.dialogue[hidden] { display: none; }
.dialogue .d-head { display: flex; gap: var(--s-3); align-items: center; margin-bottom: var(--s-3); flex-wrap: wrap; }
.dialogue .d-name { font-family: var(--font-pixel); color: var(--gold); font-size: 14px; letter-spacing: 0.06em; }
.dialogue .d-tag {
  font-family: var(--font-pixel);
  color: var(--white);
  font-size: 10px;
  padding: 4px 10px;
  background: var(--blue-2);
  letter-spacing: 0.06em;
  border: 2px solid var(--white);
  white-space: nowrap;
}
.dialogue .d-tag.tag-main { background: var(--gold-2); color: var(--shadow); }
.dialogue .d-tag.tag-side { background: var(--blue-2); color: var(--white); }
.dialogue .d-tag.tag-codex { background: var(--green-2); color: var(--shadow); }
.dialogue .d-tag.tag-legend { background: var(--pink); color: var(--shadow); }
.dialogue .d-body {
  font-family: var(--font-cn);
  color: var(--white);
  font-size: 16px;
  line-height: 1.85;
  min-height: 80px;
  max-height: 360px;
  overflow-y: auto;
  word-break: break-word;
  overflow-wrap: anywhere;
}
.dialogue .d-body h2 { font-family: var(--font-pixel); font-size: 16px; color: var(--gold); margin: var(--s-3) 0 var(--s-2); line-height: 1.4; word-break: break-word; }
.dialogue .d-body h3 { font-family: var(--font-pixel); font-size: 12px; color: var(--blue); margin: var(--s-3) 0 6px; letter-spacing: 0.06em; }
.dialogue .d-body p { margin-bottom: var(--s-3); }
.dialogue .d-body ul, .dialogue .d-body ol { margin: 6px 0 var(--s-3) 24px; }
.dialogue .d-body ul li, .dialogue .d-body ol li { margin-bottom: 6px; line-height: 1.7; }
.dialogue .d-body code { font-family: var(--font-mono); background: var(--shadow); padding: 2px 8px; font-size: 15px; color: var(--green); }
.dialogue .d-body pre { background: var(--shadow); padding: 14px; margin: var(--s-3) 0; overflow: auto; border: 2px solid var(--panel-2); }
.dialogue .d-body pre code { background: transparent; padding: 0; color: var(--green); }
.dialogue .d-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: var(--s-3);
  border-top: 2px dashed var(--panel-2);
  padding-top: var(--s-3);
  flex-wrap: wrap;
  gap: var(--s-3);
}
.dialogue .d-next { font-family: var(--font-pixel); font-size: 10px; color: var(--white); letter-spacing: 0.06em; animation: blink 1s steps(2) infinite; line-height: 1.5; }
.dialogue .d-actions { display: flex; gap: var(--s-3); flex-wrap: wrap; }
.dialogue .d-actions button {
  background: var(--night);
  border: 3px solid var(--white);
  color: var(--white);
  font-family: var(--font-pixel);
  font-size: 11px;
  padding: 8px 16px;
  cursor: pointer;
  letter-spacing: 0.06em;
  line-height: 1.5;
  white-space: nowrap;
  transition: all var(--dur-fast) var(--ease-out);
}
.dialogue .d-actions button:hover:not(:disabled) {
  background: var(--gold);
  color: var(--shadow);
  transform: translate(-1px, -1px);
  box-shadow: 2px 2px 0 var(--shadow);
}
.dialogue .d-actions button:disabled { opacity: .4; cursor: not-allowed; }

/* ============================================================
   通用按钮 / 表单（像素 RPG 形态） · v8.1 松绑
   ============================================================ */
button, .btn, input[type="submit"], input[type="button"] {
  font-family: var(--font-pixel);
  font-size: 12px;
  letter-spacing: 0.06em;
  background: var(--night);
  color: var(--white);
  border: 3px solid var(--white);
  padding: 10px 18px;
  cursor: pointer;
  transition: all var(--dur-fast) var(--ease-out);
  text-transform: uppercase;
  line-height: 1.5;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}
button:hover, .btn:hover {
  background: var(--gold);
  color: var(--shadow);
  transform: translate(-1px, -1px);
  box-shadow: 2px 2px 0 var(--shadow);
}
button:active, .btn:active { transform: translate(1px, 1px); box-shadow: none; }
button:disabled, .btn:disabled { opacity: .4; cursor: not-allowed; transform: none; box-shadow: none; }
button.primary, .btn-primary {
  background: var(--gold);
  color: var(--shadow);
  border-color: var(--gold-2);
  box-shadow: 0 4px 0 var(--gold-2);
}
button.primary:hover, .btn-primary:hover {
  background: var(--white);
  color: var(--shadow);
  box-shadow: 0 5px 0 var(--gold-2);
  transform: translate(-1px, -1px);
}
button.danger, .btn-danger {
  background: var(--cinnabar);
  color: var(--white);
  border-color: #C04A3A;
}
button.ghost, .btn-ghost {
  background: transparent;
  color: var(--blue);
  border-color: var(--blue);
}

input[type="text"], input[type="password"], input[type="email"], input[type="number"],
input[type="tel"], input[type="search"], input[type="date"], input[type="url"],
select, textarea {
  font-family: var(--font-cn);
  font-size: 16px;
  color: var(--white);
  background: var(--night);
  border: 3px solid var(--white);
  padding: 12px 14px;
  width: 100%;
  outline: none;
  line-height: 1.6;
  transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  overflow-wrap: anywhere;
  word-break: break-word;
}
input:focus, select:focus, textarea:focus {
  border-color: var(--gold);
  box-shadow: 0 0 0 3px rgba(255, 210, 63, .25);
}
input::placeholder, textarea::placeholder { color: var(--panel-2); }
label { display: block; font-family: var(--font-pixel); color: var(--blue); font-size: 11px; letter-spacing: 0.06em; margin-bottom: 8px; line-height: 1.5; }
.field { margin-bottom: var(--s-4); min-width: 0; }
.field .hint { font-size: 13px; color: var(--panel-2); margin-top: 6px; line-height: 1.6; word-break: break-word; }

/* ============================================================
   v8.2 共享布局系统
   - 页面容器：--layout-max 1180px + --layout-gutter 24px 安全边距
   - 共享组件：.grid / .head / .actions / .split / .table-scroll / .toolbar-actions
   - 通用溢出防御：min-width: 0 / overflow-wrap: anywhere
   ============================================================ */
html, body { max-width: 100%; overflow-x: clip; }
main, header, nav, footer, section, form, fieldset, .frame, .workarea,
.content, .body, .grid, .actions, .section-head, .head { min-width: 0; }

button, .btn, input[type="submit"], input[type="button"] {
  min-height: var(--control-min-h);
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
  overflow-wrap: anywhere;
  word-break: break-word;
}

input, select, textarea {
  display: block;
  width: 100%;
  max-width: 100%;
  min-width: 0;
}

textarea {
  min-height: 112px;
  resize: vertical;
}

.content, .body {
  padding: var(--section-pad);
}

.head, .section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--s-4);
  padding: var(--s-5) var(--section-pad) var(--s-4);
  border-bottom: 3px solid var(--panel-2);
  flex-wrap: wrap;
}

.head > div, .section-head > div { min-width: 0; }
.head h2, .section-head h2 { margin: 0; }
.head .hint, .section-head .section-helper { margin: 6px 0 0; max-width: 72ch; }

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--s-4);
  align-items: start;
}
.grid.three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.grid > div { min-width: 0; }
.grid .span2 { grid-column: 1 / -1; }

.actions {
  display: flex;
  align-items: center;
  gap: var(--s-3);
  flex-wrap: wrap;
  margin-top: var(--s-5);
}
.actions > * { flex: 0 1 auto; min-width: 0; }

.split {
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(300px, .8fr);
  gap: var(--s-5);
  align-items: start;
}

.notice, .helper, .hint, .result, pre, td, th {
  overflow-wrap: anywhere;
  word-break: break-word;
}
pre {
  max-width: 100%;
  overflow: auto;
  white-space: pre-wrap;
}

.table-scroll {
  width: 100%;
  max-width: 100%;
  overflow-x: auto;
  overscroll-behavior-inline: contain;
  border: 3px solid var(--panel-2);
}
.table-scroll table { min-width: 760px; border: 0; }
table { width: 100%; border-collapse: collapse; }
th, td { padding: 12px 14px; vertical-align: top; text-align: left; }

.tabs, nav {
  width: min(var(--layout-max), calc(100% - (var(--layout-gutter) * 2)));
  margin-inline: auto;
}
.tabs button, nav button {
  min-width: min(150px, 100%);
  flex: 1 1 150px;
  min-height: var(--touch-min-h);
}

.frame > section, .workarea > section { min-width: 0; overflow: hidden; }
.frame > section:not(.active), .workarea > section:not(.active) { display: none; }
.frame > section.active, .workarea > section.active { display: block; }

/* === 认证视图显示规则：登录/注册互斥 === */
.auth-view { display: none; }
body.auth-login .login-view { display: grid; }
body.auth-register .register-view { display: grid; }
.auth-view { gap: var(--s-3); }
.auth-view .actions { margin-top: var(--s-2); }
.auth-switch { margin: 0; }
.link-button { display: inline-flex; width: auto; min-height: 36px; padding: 6px 10px; }

/* === Toast / 对话框溢出兜底 === */
.toast-host { max-width: calc(100vw - 32px); }
.toast { max-width: min(360px, calc(100vw - 32px)); }
.dialogue, .q-row, .d-body, .rich {
  max-width: 100%;
  overflow-wrap: anywhere;
  word-break: break-word;
}
.dialogue .d-actions, .q-row { min-width: 0; }
.dialogue .d-actions button { white-space: normal; }
img, svg, canvas, video, audio, iframe { max-width: 100%; }

/* === 焦点可见态（v8.2 可访问性）=== */
:where(button, .btn, input, select, textarea, [tabindex]):focus-visible {
  outline: 3px solid var(--blue);
  outline-offset: 3px;
}

/* === 状态徽章 / Pills === */
.status-dot.dot-good     { color: var(--green); }
.status-dot.dot-warn     { color: var(--gold-2); }
.status-dot.dot-err      { color: var(--cinnabar); }
.status-dot.dot-info     { color: var(--blue); }

.tag, .pill {
  display: inline-block;
  font-family: var(--font-pixel);
  font-size: 10px;
  letter-spacing: 0.06em;
  padding: 4px 10px;
  background: var(--night-2);
  color: var(--white);
  border: 2px solid var(--white);
  margin-right: 6px;
  margin-bottom: 4px;
  line-height: 1.5;
  vertical-align: middle;
  overflow-wrap: anywhere;
}
.tag.tag-main, .pill.tag-main    { color: var(--gold); border-color: var(--gold); }
.tag.tag-side, .pill.tag-side    { color: var(--blue); border-color: var(--blue); }
.tag.tag-codex, .pill.tag-codex  { color: var(--green); border-color: var(--green); }
.tag.tag-legend, .pill.tag-legend{ color: var(--pink); border-color: var(--pink); }

/* === 顶部导航（横版像素按钮组） · v8.1 松绑 === */
header, .topbar {
  background: var(--night-2);
  border-bottom: 4px solid var(--white);
  padding: 14px 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--s-4);
  flex-wrap: wrap;
  position: relative;
  z-index: 3;
}
header h1 {
  font-family: var(--font-pixel);
  color: var(--gold);
  font-size: 17px;
  letter-spacing: 0.08em;
  line-height: 1.4;
  text-shadow: 2px 2px 0 var(--shadow);
  margin: 0;
  overflow-wrap: anywhere;
}
header .meta, header .status {
  font-family: var(--font-pixel);
  font-size: 11px;
  color: var(--blue);
  letter-spacing: 0.06em;
  line-height: 1.6;
  overflow-wrap: anywhere;
}
header .meta .ok { color: var(--green); }
header .meta .warn { color: var(--cinnabar); }
.tabs { display: flex; gap: 0; flex-wrap: wrap; border-bottom: 4px solid var(--white); }
.tabs button {
  font-family: var(--font-pixel);
  font-size: 11px;
  letter-spacing: 0.06em;
  background: var(--night);
  color: var(--white);
  border: 0;
  border-right: 2px solid var(--white);
  border-bottom: 4px solid transparent;
  padding: 11px 18px;
  cursor: pointer;
  margin-bottom: -4px;
  line-height: 1.5;
  overflow-wrap: anywhere;
}
.tabs button:hover { background: var(--night-2); color: var(--gold); }
.tabs button.active {
  background: var(--night-2);
  color: var(--gold);
  border-bottom-color: var(--gold);
}
.tabs button.active:nth-child(1) { border-bottom-color: var(--blue); color: var(--blue); }
.tabs button.active:nth-child(2) { border-bottom-color: var(--green); color: var(--green); }
.tabs button.active:nth-child(3) { border-bottom-color: var(--gold); color: var(--gold); }
.tabs button.active:nth-child(4) { border-bottom-color: var(--pink); color: var(--pink); }
.tabs button.active:nth-child(5) { border-bottom-color: var(--cinnabar); color: var(--cinnabar); }

/* ============================================================
   关键容器（v6/v7 class → v8 视觉）
   ============================================================ */
/* === 角色状态区（v6/v7 .service-brief + .hero + .ops-brief） · v8.1 松绑 === */
.service-brief, .hero, .ops-brief {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: var(--s-5);
  padding: var(--s-5) 0;
  max-width: 1180px;
  width: calc(100% - 32px);
  margin: 0 auto;
  position: relative;
  z-index: 2;
}

/* === 角色卡（v6/v7 .trust-strip） · v8.1 松绑 === */
.trust-strip {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--s-3);
  margin: var(--s-4) 0 var(--s-5);
}
.trust-card {
  background: var(--night-2);
  border: 3px solid var(--white);
  padding: var(--s-4) var(--s-4);
  position: relative;
  box-shadow: 4px 4px 0 var(--shadow);
  min-width: 0;
  overflow: hidden;
  transition: transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
}
.trust-card:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--gold-2); }
.trust-card::before {
  content: "";
  position: absolute;
  top: -3px; left: -3px; right: -3px;
  height: 4px;
  background: var(--gold);
}
.trust-card:nth-child(1)::before { background: var(--blue); }
.trust-card:nth-child(2)::before { background: var(--green); }
.trust-card:nth-child(3)::before { background: var(--cinnabar); }
.trust-card:nth-child(4)::before { background: var(--pink); }
.trust-card strong {
  display: block;
  font-family: var(--font-pixel);
  font-size: 14px;
  color: var(--gold);
  margin-bottom: 8px;
  letter-spacing: 0.06em;
  line-height: 1.5;
  word-break: break-word;
}
.trust-card:nth-child(1) strong { color: var(--blue); }
.trust-card:nth-child(2) strong { color: var(--green); }
.trust-card:nth-child(3) strong { color: var(--cinnabar); }
.trust-card:nth-child(4) strong { color: var(--pink); }
.trust-card span { color: var(--panel-2); font-size: 13px; line-height: 1.65; word-break: break-word; overflow-wrap: anywhere; }

/* === 5 步学习流（v6/v7 .steps .step） · v8.1 松绑 === */
.steps {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: var(--s-3);
  margin: var(--s-4) 0 var(--s-5);
}
.step {
  position: relative;
  padding: var(--s-4) var(--s-3) var(--s-3);
  border: 3px solid var(--white);
  background: var(--night-2);
  font-family: var(--font-cn);
  font-size: 14px;
  color: var(--white);
  box-shadow: 4px 4px 0 var(--shadow);
  min-width: 0;
  line-height: 1.55;
  word-break: break-word;
  overflow-wrap: anywhere;
  transition: all var(--dur-fast) var(--ease-out);
}
.step::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0; height: 4px;
  background: var(--gold);
}
.step:nth-child(1)::before { background: var(--blue); }
.step:nth-child(2)::before { background: var(--green); }
.step:nth-child(3)::before { background: var(--gold); }
.step:nth-child(4)::before { background: var(--pink); }
.step:nth-child(5)::before { background: var(--cinnabar); }
.step[data-active="1"], .step[data-active="2"], .step[data-active="3"],
.step[data-active="4"], .step[data-active="5"] {
  transform: translate(-2px, -2px);
  box-shadow: 6px 6px 0 var(--gold-2);
}
.step[data-active="1"]::before, .step[data-active="1"] { border-color: var(--blue); }
.step[data-active="2"]::before, .step[data-active="2"] { border-color: var(--green); }
.step[data-active="3"]::before, .step[data-active="3"] { border-color: var(--gold); }
.step[data-active="4"]::before, .step[data-active="4"] { border-color: var(--pink); }
.step[data-active="5"]::before, .step[data-active="5"] { border-color: var(--cinnabar); }
.step[data-active]::after {
  content: "▶";
  position: absolute; top: 50%; right: 6px;
  transform: translateY(-50%);
  color: var(--gold);
  font-size: 12px;
  animation: blink 1s steps(2) infinite;
}

/* === 3 段今日数据（v6/v7 .today-grid .today-cell） · v8.1 松绑 === */
.today-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--s-4);
  margin: var(--s-4) 0 var(--s-5);
}
.today-cell {
  background: var(--night-2);
  border: 3px solid var(--white);
  border-left: 6px solid var(--gold);
  padding: var(--s-4) var(--s-4);
  box-shadow: 4px 4px 0 var(--shadow);
  min-width: 0;
  overflow: hidden;
  transition: all var(--dur-fast) var(--ease-out);
}
.today-cell:nth-child(1) { border-left-color: var(--blue); }
.today-cell:nth-child(2) { border-left-color: var(--green); }
.today-cell:nth-child(3) { border-left-color: var(--cinnabar); }
.today-cell:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--gold-2); }
.today-cell strong {
  display: block;
  font-family: var(--font-mono);
  font-size: 26px;
  color: var(--gold);
  line-height: 1.2;
  margin-bottom: 6px;
  word-break: break-all;
  overflow-wrap: anywhere;
}
.today-cell:nth-child(1) strong { color: var(--blue); }
.today-cell:nth-child(2) strong { color: var(--green); }
.today-cell:nth-child(3) strong { color: var(--cinnabar); }
.today-cell .label {
  font-family: var(--font-pixel);
  font-size: 11px;
  color: var(--white);
  letter-spacing: 0.06em;
  line-height: 1.5;
  word-break: break-word;
}
.today-cell .sub { font-size: 13px; color: var(--panel-2); margin-top: 6px; line-height: 1.6; word-break: break-word; overflow-wrap: anywhere; }

/* === 后台 ops-grid（v6/v7 .ops-grid .ops-card） · v8.1 松绑 === */
.ops-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--s-3);
  margin: var(--s-4) 0 var(--s-5);
}
.ops-card {
  background: var(--night-2);
  border: 3px solid var(--white);
  border-left: 6px solid var(--gold);
  padding: var(--s-4);
  box-shadow: 4px 4px 0 var(--shadow);
  min-width: 0;
  overflow: hidden;
  transition: all var(--dur-fast) var(--ease-out);
  cursor: pointer;
}
.ops-card:nth-child(1) { border-left-color: var(--blue); }
.ops-card:nth-child(2) { border-left-color: var(--green); }
.ops-card:nth-child(3) { border-left-color: var(--gold); }
.ops-card:nth-child(4) { border-left-color: var(--pink); }
.ops-card:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--gold-2); }
.ops-card strong { display: block; font-family: var(--font-pixel); font-size: 13px; color: var(--gold); margin-bottom: 8px; letter-spacing: 0.06em; line-height: 1.5; word-break: break-word; }
.ops-card:nth-child(1) strong { color: var(--blue); }
.ops-card:nth-child(2) strong { color: var(--green); }
.ops-card:nth-child(3) strong { color: var(--gold); }
.ops-card:nth-child(4) strong { color: var(--pink); }
.ops-card p { color: var(--panel-2); font-size: 14px; line-height: 1.65; word-break: break-word; overflow-wrap: anywhere; }

/* === 学生 hero 三个特色（v6/v7 .student-trust） · v8.1 松绑 === */
.student-trust {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--s-3);
  margin: var(--s-4) 0 var(--s-5);
}
.student-trust > * {
  background: var(--night-2);
  border: 3px solid var(--white);
  border-left: 6px solid var(--gold);
  padding: var(--s-4);
  box-shadow: 4px 4px 0 var(--shadow);
  min-width: 0;
  overflow: hidden;
  transition: all var(--dur-fast) var(--ease-out);
}
.student-trust > *:nth-child(1) { border-left-color: var(--blue); }
.student-trust > *:nth-child(2) { border-left-color: var(--green); }
.student-trust > *:nth-child(3) { border-left-color: var(--cinnabar); }
.student-trust > *:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--gold-2); }
.student-trust > * strong { display: block; font-family: var(--font-pixel); font-size: 13px; margin-bottom: 6px; letter-spacing: 0.06em; line-height: 1.5; word-break: break-word; }
.student-trust > *:nth-child(1) strong { color: var(--blue); }
.student-trust > *:nth-child(2) strong { color: var(--green); }
.student-trust > *:nth-child(3) strong { color: var(--cinnabar); }
.student-trust > *:not(strong) { font-size: 14px; line-height: 1.7; color: var(--panel-2); word-break: break-word; overflow-wrap: anywhere; }

/* === 任务卡（v6/v7 .quick-track .quick-tile / .student-card / .card） · v8.1 松绑 === */
.row-carousel {
  display: flex;
  gap: var(--s-3);
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  padding: var(--s-3) 0;
  margin: var(--s-4) 0;
  scrollbar-width: thin;
  scrollbar-color: var(--gold-2) var(--night);
}
.row-carousel::-webkit-scrollbar { height: 10px; }
.row-carousel::-webkit-scrollbar-track { background: var(--night); }
.row-carousel::-webkit-scrollbar-thumb { background: var(--gold-2); border: 2px solid var(--night); }
.row-carousel > * { flex: 0 0 260px; scroll-snap-align: start; min-width: 0; }

.quick-tile, .card, .student-card, .ops-card, .knowledge-card, .voice-card, .guide-card {
  background: var(--night-2);
  border: 3px solid var(--white);
  padding: var(--s-4);
  box-shadow: 4px 4px 0 var(--shadow);
  min-width: 0;
  overflow: hidden;
  transition: all var(--dur-fast) var(--ease-out);
  position: relative;
}
.quick-tile:hover, .card:hover, .student-card:hover, .knowledge-card:hover, .voice-card:hover, .guide-card:hover {
  transform: translate(-2px, -2px);
  box-shadow: 6px 6px 0 var(--gold-2);
}
.quick-tile::before, .card::before, .student-card::before, .knowledge-card::before, .voice-card::before, .guide-card::before {
  content: "";
  position: absolute; top: -3px; left: -3px; right: -3px; height: 4px;
  background: var(--gold);
}
.quick-tile:nth-child(1)::before, .card:nth-child(1)::before, .student-card:nth-child(1)::before, .knowledge-card:nth-child(1)::before, .voice-card:nth-child(1)::before, .guide-card:nth-child(1)::before { background: var(--blue); }
.quick-tile:nth-child(2)::before, .card:nth-child(2)::before, .student-card:nth-child(2)::before, .knowledge-card:nth-child(2)::before, .voice-card:nth-child(2)::before, .guide-card:nth-child(2)::before { background: var(--green); }
.quick-tile:nth-child(3)::before, .card:nth-child(3)::before, .student-card:nth-child(3)::before, .knowledge-card:nth-child(3)::before, .voice-card:nth-child(3)::before, .guide-card:nth-child(3)::before { background: var(--cinnabar); }
.quick-tile:nth-child(4)::before, .card:nth-child(4)::before, .student-card:nth-child(4)::before, .knowledge-card:nth-child(4)::before, .voice-card:nth-child(4)::before, .guide-card:nth-child(4)::before { background: var(--pink); }
.quick-tile:nth-child(5)::before, .card:nth-child(5)::before, .student-card:nth-child(5)::before, .knowledge-card:nth-child(5)::before, .voice-card:nth-child(5)::before, .guide-card:nth-child(5)::before { background: var(--gold); }
.quick-tile strong, .card strong, .student-card strong, .knowledge-card strong, .voice-card strong, .guide-card strong {
  display: block;
  font-family: var(--font-pixel);
  font-size: 12px;
  color: var(--gold);
  margin-bottom: 4px;
  letter-spacing: 0.04em;
}
.quick-tile .quick-name, .card .title, .student-card .name { font-family: var(--font-pixel); font-size: 14px; color: var(--white); margin-bottom: 4px; }
.quick-tile .quick-desc, .card .desc, .student-card .desc { color: var(--panel-2); font-size: 12px; line-height: 1.5; }

/* === 标题区（v6/v7 .hero .hero-top） · v8.1 松绑 === */
.hero-top { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--s-4); flex-wrap: wrap; margin-bottom: var(--s-4); min-width: 0; }
.hero { min-width: 0; }
.hero h1 { font-family: var(--font-pixel); font-size: 24px; color: var(--gold); text-shadow: 2px 2px 0 var(--shadow); margin-bottom: 10px; line-height: 1.4; letter-spacing: 0.06em; overflow-wrap: anywhere; }
.hero p { color: var(--panel-2); font-size: 15px; line-height: 1.85; overflow-wrap: anywhere; }

/* === 认证面板（v6/v7 .auth-shell + .auth-panel） · v8.1 松绑 === */
.auth-shell {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(280px, 380px);
  gap: var(--s-5);
  margin: var(--s-4) 0;
  max-width: 1180px;
  width: calc(100% - 32px);
  margin-left: auto; margin-right: auto;
}
.auth-panel {
  background: var(--night-2);
  border: 4px solid var(--white);
  box-shadow: 0 0 0 4px var(--shadow);
  padding: var(--s-5);
  align-self: start;
  min-width: 0;
  overflow-wrap: anywhere;
}
.auth-panel h2 { font-family: var(--font-pixel); color: var(--gold); font-size: 15px; margin-bottom: var(--s-4); letter-spacing: 0.06em; line-height: 1.5; }
.auth-panel label { font-family: var(--font-pixel); color: var(--blue); font-size: 11px; letter-spacing: 0.06em; }

/* === 表单行 · v8.1 松绑 === */
.form-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s-4); }
.form-row .field { min-width: 0; }
.kv { display: grid; grid-template-columns: 130px minmax(0, 1fr); gap: var(--s-3); font-size: 15px; line-height: 1.75; }
.kv > div:nth-child(odd) { color: var(--blue); font-family: var(--font-pixel); font-size: 11px; letter-spacing: 0.06em; align-self: center; }
.kv > div:nth-child(even) { color: var(--white); min-width: 0; word-break: break-word; overflow-wrap: anywhere; }

/* === Toast / 提示 === */
.toast-host {
  position: fixed; right: 16px; top: 70px; z-index: 30;
  display: flex; flex-direction: column; gap: var(--s-2); pointer-events: none;
  max-width: calc(100vw - 32px);
  overflow: hidden;
}
.toast {
  background: var(--night-2);
  border: 3px solid var(--gold);
  color: var(--white);
  font-family: var(--font-pixel);
  font-size: 12px;
  line-height: 1.65;
  padding: 10px 16px;
  letter-spacing: 0.04em;
  box-sizing: border-box;
  max-width: min(360px, calc(100vw - 32px));
  box-shadow: 4px 4px 0 var(--shadow);
  animation: toast-in .3s var(--ease-out) both;
  overflow-wrap: anywhere;
}
.toast.info  { border-color: var(--blue); }
.toast.warn  { border-color: var(--gold); }
.toast.error { border-color: var(--cinnabar); }
.toast.good  { border-color: var(--green); }
.toast.out   { animation: toast-out .3s var(--ease-out) both; }
@keyframes toast-in { from { transform: translateX(20px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
@keyframes toast-out { to { transform: translateX(20px); opacity: 0; } }

/* === Preview 徽章 · v8.1 松绑 === */
.preview-badge {
  position: fixed;
  top: 72px; left: 16px;
  z-index: 25;
  font-family: var(--font-pixel);
  font-size: 11px;
  line-height: 1.5;
  color: var(--shadow);
  background: var(--gold);
  border: 2px solid var(--shadow);
  padding: 6px 12px;
  letter-spacing: 0.06em;
  box-shadow: 3px 3px 0 var(--shadow);
  overflow-wrap: anywhere;
}

/* === 滚动条（全局） === */
::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-track { background: var(--night); }
::-webkit-scrollbar-thumb { background: var(--panel-2); border: 2px solid var(--night); }
::-webkit-scrollbar-thumb:hover { background: var(--gold-2); }

/* === 字体溢出防御 === */
p, li, dd, dt, .body, .hint, .notice, .status, .result, .muted, .tag, .pill, .care-note,
.trust-card span, .guide-card span, .ops-card span, .student-card p, .kv div,
.auth-note, .route-note {
  overflow-wrap: anywhere;
  word-break: break-word;
  min-width: 0;
}
.flex-min, main *, section *, header *, .workarea *, .ops-brief *, .today-overview *, .hero *, .student-trust * { min-width: 0; }

/* === 标题字符渐显（v7 保留，v8 沿用） === */
.title-letters span {
  display: inline-block;
  opacity: 0;
  transform: translateY(8px);
  animation: letter-rise .8s var(--ease-out) forwards;
}
.title-letters span:nth-child(1) { animation-delay: 0ms; }
.title-letters span:nth-child(2) { animation-delay: 60ms; }
.title-letters span:nth-child(3) { animation-delay: 120ms; }
.title-letters span:nth-child(4) { animation-delay: 180ms; }
.title-letters span:nth-child(5) { animation-delay: 240ms; }
.title-letters span:nth-child(6) { animation-delay: 300ms; }
.title-letters span:nth-child(7) { animation-delay: 360ms; }
.title-letters span:nth-child(8) { animation-delay: 420ms; }
@keyframes letter-rise {
  to { opacity: 1; transform: translateY(0); }
}

/* === 降级 · reduced motion === */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
    scroll-behavior: auto !important;
  }
  .xueji-stars { display: none; }
  .title-letters span { opacity: 1; transform: none; }
  .title-screen .logo { animation: none; }
}

/* === 响应式 · v8.1 松绑 === */
@media (max-width: 1024px) {
  .card-grid { grid-template-columns: minmax(0, 1fr); }
  .auth-shell { grid-template-columns: minmax(0, 1fr); }
  .ops-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .student-trust { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .today-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .trust-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .frame { max-width: 100%; }
  .bar { grid-template-columns: 56px minmax(0, 1fr) 70px; gap: var(--s-3); }
}

@media (max-width: 720px) {
  body { font-size: 15px; }
  header h1 { font-size: 15px; }
  header h1 span { display: none; }
  .frame { margin: var(--s-3); width: calc(100% - 24px); }
  .frame-top { padding: 12px 16px; flex-wrap: wrap; gap: var(--s-2); }
  .frame-top .actions { flex-wrap: wrap; }
  .card-grid { grid-template-columns: minmax(0, 1fr); padding: var(--s-4); }
  .q-row { grid-template-columns: 32px minmax(0, 1fr); padding: 14px 14px; gap: var(--s-3); }
  .q-row .q-cat, .q-row .q-reward { display: none; }
  .q-row .q-status { grid-column: 2; justify-self: end; }
  .equips { grid-template-columns: minmax(0, 1fr); gap: var(--s-3); }
  .nums { grid-template-columns: minmax(0, 1fr); gap: var(--s-2); }
  .ops-grid, .student-trust, .today-grid, .steps, .trust-strip { grid-template-columns: minmax(0, 1fr); }
  .form-row { grid-template-columns: minmax(0, 1fr); }
  .dialogue { left: 8px; right: 8px; bottom: 8px; padding: var(--s-4); max-height: 60vh; }
  .dialogue .d-body { font-size: 15px; line-height: 1.8; }
  .row-carousel > * { flex: 0 0 220px; }
  .row-carousel { padding: 4px 4px; }
  .hero-top { flex-direction: column; gap: var(--s-3); }
  .hero h1 { font-size: 20px; }
  .hero p { font-size: 14px; }
  .tabs { flex-wrap: wrap; }
  .tabs button { font-size: 10px; padding: 9px 12px; }
  .menu { flex-wrap: wrap; }
  .menu-item { flex: 1 1 calc(50% - 6px); }
  button { font-size: 11px; padding: 9px 14px; }
  .preview-badge { top: 64px; font-size: 10px; padding: 5px 10px; }
  .toast { font-size: 11px; max-width: 280px; }
  input, textarea, select { font-size: 15px; padding: 11px 12px; }
  .auth-shell { width: calc(100% - 24px); }
  .auth-panel { padding: var(--s-4); }
  /* v8.2 共享布局：720px 下全部单列、按钮允许换行 */
  :root { --section-pad: 16px; }
  .grid, .grid.three, .ops-grid, .student-trust, .today-grid,
  .steps, .trust-strip, .auth-shell, .split { grid-template-columns: minmax(0, 1fr); }
  .grid .span2 { grid-column: auto; }
  .head, .section-head { flex-direction: column; }
  .actions { align-items: stretch; }
  .actions > button, .actions > .btn { flex: 1 1 180px; }
  .tabs button, nav button { flex-basis: calc(50% - 2px); min-width: 0; }
  button, .btn, input[type="submit"], input[type="button"] { min-height: var(--touch-min-h); }
  /* v8.2 任务行窄屏优化 */
  .q-row { grid-template-columns: 32px minmax(0, 1fr); }
  .q-row .q-cat, .q-row .q-exp, .q-row .q-status {
    grid-column: 2;
    justify-self: start;
    white-space: normal;
  }
  .dialogue .d-actions button { flex: 1 1 160px; }
}

@media (max-width: 420px) {
  body { font-size: 14px; }
  h1 { font-size: 19px; }
  h2 { font-size: 16px; }
  h3 { font-size: 14px; }
  .hero h1 { font-size: 18px; }
  .title-screen .logo { font-size: 28px; }
  .frame { margin: var(--s-2); width: calc(100% - 16px); }
  .frame-top { padding: 10px 12px; }
  .frame-foot { padding: 10px 12px; }
  .row-carousel > * { flex: 0 0 200px; }
  .dialogue { left: 6px; right: 6px; bottom: 6px; padding: var(--s-3); }
  .preview-badge { top: 60px; font-size: 9px; padding: 4px 8px; }
  /* v8.2 共享布局：420px 下极致紧凑 */
  :root { --layout-gutter: 8px; --section-pad: 14px; }
  .frame { width: calc(100% - 16px); margin: 8px auto; }
  .tabs, nav { width: calc(100% - 16px); }
  .tabs button, nav button { flex-basis: 100%; }
  .actions > button, .actions > .btn { flex-basis: 100%; width: 100%; }
  th, td { padding: 10px 12px; }
  /* 修复 knowledge base 等长表格内容在 420px 下 4px 突出 */
  .workarea, .body { padding-left: 12px; padding-right: 12px; }
  .section-head { padding: var(--s-3) 12px; }
}

/* === v8.3 宽屏平铺（>=1280px）· 学生端内容真正"展开填满" === */
@media (min-width: 1280px) {
  /* 0. 关键修复：header 内部嵌套的 <main> 需突破"display:flex 收缩"，
        拿到 100% 宽度后，.hero 才能继续按比例平铺。 */
  header > main { width: 100%; flex: 1 1 100%; min-width: 0; }

  /* 0.5 wrapAsFrame() 运行时把 .hero 包进 .frame（max-width:1180px），
        这里是真正的瓶颈，必须把 .frame 也解锁。 */
  .frame { max-width: min(96vw, 1600px); }

  /* 1. 登录屏 .hero 解锁 1180px 顶板，左上 hero-top 横跨整行，
        中段分 2 列（左：3 个信任卡；右：5 步学习流），底部登录面板横跨整行 */
  .hero {
    width: auto;
    max-width: 100%;
    margin: 0 auto;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    column-gap: var(--s-6);
    row-gap: var(--s-5);
  }
  .hero-top { grid-column: 1 / -1; }
  .student-trust { grid-column: 1; grid-template-columns: minmax(0, 1fr); gap: var(--s-3); }
  .steps { grid-column: 2; grid-template-columns: minmax(0, 1fr); gap: var(--s-3); }
  .login-panel { grid-column: 1 / -1; max-width: 720px; margin: 0 auto; }

  /* 2. 仪表盘：内容层加安全边距，section 块自身用更宽的内边距 */
  #studentContent {
    max-width: 1600px;
    margin: 0 auto;
    padding: var(--s-4) var(--layout-gutter) var(--s-6);
  }
  .today-overview { padding: var(--s-5) var(--s-5); }
  .student-section { padding: var(--s-5) var(--s-5); }

  /* 3. 今日概览 + 仪表盘 cards 列表平铺成多列 */
  .today-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-4); }
  .voice-list, .card-list, .history-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4);
  }
}

/* === v8.3 宽屏平铺（>=1600px）· 更激进的 3 列分布 === */
@media (min-width: 1600px) {
  .frame { max-width: min(96vw, 1840px); }
  .student-trust { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .steps { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  #studentContent { max-width: 1840px; }
  .voice-list, .card-list, .history-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}

</style>
</head>
<body class="logged-out auth-login">
  <header>
    <div class="top">
      <h1 data-title-letters>学记教育家长端</h1>
      <span class="tag" id="serviceState">连接中</span>
    </div>
  </header>

  <main>
    <div class="service-brief">
      <div class="brief-copy">
        <h2>先看得见，再坚持得下去</h2>
        <p>学记教育把建档、规划、知识卡、每日反馈和周调整串成一个闭环。家长先确认方向，学生每天只看当日任务，老师再根据反馈调节难度。</p>
      </div>
      <div class="brief-rail" aria-label="学记教育四步流程">
        <div><span>1</span>诊断起点，先不盲补</div>
        <div><span>2</span>家长确认，再生成方案</div>
        <div><span>3</span>每天小步，卡片可打印</div>
        <div><span>4</span>反馈回收，老师可复核</div>
      </div>
    </div>
    <div class="tabs">
      <button class="active" data-view="intake">1 建档</button>
      <button data-view="plan">2 初步规划</button>
      <button data-view="cards">3 知识卡片</button>
      <button data-view="voice">4 语音练习</button>
      <button data-view="feedback">5 每日反馈</button>
      <button data-view="account">我的帐号</button>
    </div>
    <div class="flow" id="flowGuide"></div>

    <section id="account" class="active portal-section">
      <div class="head">
        <h2>我的帐号</h2>
        <p class="hint">查看学生档案、学生端绑定和当前服务状态。</p>
      </div>
      <div class="account-box" id="accountStatus">未登录</div>
      <div class="content">
        <div class="auth-shell">
          <div class="auth-intro">
            <h2>先把孩子的学习闭环跑通</h2>
            <p>不承诺神奇提分，只把“今天做什么、做得怎么样、明天怎么调”变清楚。家长能看到过程，学生端只保留当日任务和复习卡。</p>
            <div class="trust-strip" aria-label="学记教育服务承诺">
              <div class="trust-card">
                <strong>7天</strong>
                <span>试运行先验证节奏，再决定是否长期跟进。</span>
              </div>
              <div class="trust-card">
                <strong>1人1档</strong>
                <span>按教材范围、薄弱点和家庭执行条件生成计划。</span>
              </div>
              <div class="trust-card">
                <strong>可复核</strong>
                <span>AI先整理，关键调整保留人工判断和家长确认。</span>
              </div>
            </div>
            <div class="auth-points">
              <div><span>1</span><strong>先建档，明确年级、范围、薄弱点和可用时间</strong></div>
              <div><span>2</span><strong>先给家长看初步规划，确认后再生成知识卡</strong></div>
              <div><span>3</span><strong>学生端只显示今日任务，减少选择和干扰</strong></div>
            </div>
            <div class="auth-note">资料只用于生成学习计划、知识卡和反馈分析；遇到研学、疲劳、抗拒等情况，可以通过每日反馈进入下一版调整。</div>
          </div>
          <div class="auth-panel">
            <form id="loginForm" class="auth-view login-view">
              <h3>登录学记</h3>
              <label for="login_phone">手机号</label>
              <input id="login_phone" name="phone" autocomplete="tel" inputmode="numeric" placeholder="中国大陆11位手机号" required>
              <label for="login_password">密码</label>
              <input id="login_password" name="password" type="password" autocomplete="current-password" required>
              <div class="actions">
                <button class="primary" type="submit">登录</button>
              </div>
              <p class="auth-switch">还没有账号？<button class="link-button" id="showRegisterBtn" type="button">注册账号</button></p>
            </form>
            <form id="registerForm" class="auth-view register-view">
              <h3>注册家长账号</h3>
              <label for="reg_nickname">家长称呼</label>
              <input id="reg_nickname" name="nickname" placeholder="如：陈妈妈">
              <label for="reg_phone">手机号</label>
              <input id="reg_phone" name="phone" autocomplete="tel" inputmode="numeric" placeholder="中国大陆11位手机号" required>
              <label for="reg_password">设置密码</label>
              <input id="reg_password" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="64" required>
              <p class="hint">密码至少8位，需同时包含字母和数字。</p>
              <div class="student-bind-fields">
                <strong>学生端登录</strong>
                <p class="hint">可选。填了之后，建档成功会自动给孩子开通学生端。</p>
                <label for="reg_student_phone">学生手机号</label>
                <input id="reg_student_phone" name="student_phone" autocomplete="tel" inputmode="numeric" placeholder="孩子以后用这个登录">
                <label for="reg_student_password">学生初始密码</label>
                <input id="reg_student_password" name="student_password" type="password" autocomplete="new-password" minlength="8" maxlength="64" placeholder="至少8位，含字母和数字">
              </div>
              <div class="actions">
                <button class="primary" type="submit">注册并登录</button>
              </div>
              <p class="auth-switch">已有账号？<button class="link-button" id="showLoginBtn" type="button">返回登录</button></p>
            </form>
          </div>
        </div>
        <div class="actions account-toolbar">
          <button class="secondary" type="button" id="logoutBtn">退出登录</button>
        </div>
        <div id="myStudents" class="student-list"></div>
        <div id="referralPanel" class="referral-panel"></div>
      </div>
      <div class="result" id="accountResult"></div>
    </section>

    <section id="intake" class="portal-section">
      <div class="head">
        <h2>第1步：3分钟速填建档</h2>
        <p class="hint">先填写学生情况。建档完成后，系统会给出一份初步规划，先给家长确认方向。</p>
      </div>
      <div class="section-guide" aria-label="建档说明">
        <div class="guide-card"><strong>为什么要填</strong><span>先判断年级、范围、时间和配合度，避免一开始就给过量任务。</span></div>
        <div class="guide-card"><strong>提交后会怎样</strong><span>生成学生档案和初步规划，家长先看方向，再决定是否进入卡片。</span></div>
        <div class="guide-card"><strong>资料怎么用</strong><span>上传资料只用于定位范围和薄弱点；没有资料也可以先跑假设版。</span></div>
      </div>
      <form id="intakeForm">
        <div class="grid">
          <div>
            <label for="parent_nickname">家长称呼</label>
            <input id="parent_nickname" name="parent_nickname" placeholder="如：陈妈妈">
          </div>
          <div>
            <label for="parent_phone">手机号</label>
            <input id="parent_phone" name="parent_phone" autocomplete="tel" inputmode="numeric" placeholder="用于注册/登录">
          </div>
          <div>
            <label for="student_name">学生称呼</label>
            <input id="student_name" name="student_name" placeholder="如：小陈" required>
          </div>
          <div>
            <label for="student_phone">学生手机号</label>
            <input id="student_phone" name="student_phone" autocomplete="tel" inputmode="numeric" placeholder="用于学生端登录，可先不填">
          </div>
          <div>
            <label for="student_password">学生初始密码</label>
            <input id="student_password" name="student_password" type="password" autocomplete="new-password" minlength="8" maxlength="64" placeholder="填手机号时一起设置，至少8位">
          </div>
          <div>
            <label for="grade_region">年级/地区</label>
            <input id="grade_region" name="grade_region" placeholder="如：初一/湖南" required>
          </div>
          <div>
            <label for="goal">目标</label>
            <input id="goal" name="goal" placeholder="如：期末基础抢分" required>
          </div>
          <div>
            <label for="exam_date_text">最近考试时间</label>
            <input id="exam_date_text" name="exam_date_text" placeholder="如：2周后">
          </div>
          <div class="span2">
            <label for="exam_scope">教材/考试范围</label>
            <input id="exam_scope" name="exam_scope" placeholder="如：七年级下册期末；语文、英语、历史、道法；有老师复习范围可上传">
          </div>
          <div>
            <label for="time_budget">每天可用时间</label>
            <select id="time_budget" name="time_budget">
              <option>5-10分钟</option>
              <option selected>15-25分钟</option>
              <option>30-40分钟</option>
            </select>
          </div>
          <div>
            <label for="cooperation">孩子配合度</label>
            <select id="cooperation" name="cooperation">
              <option>抗拒</option>
              <option selected>一般</option>
              <option>能接受</option>
              <option>比较配合</option>
            </select>
          </div>
          <div class="span2">
            <label for="priority_subjects">必须覆盖科目/考试</label>
            <input id="priority_subjects" name="priority_subjects" placeholder="如：语文、英语、历史、道法；或 GESP C++ 二级">
          </div>
          <div>
            <label for="card_layout">期望卡片版式</label>
            <select id="card_layout" name="card_layout">
              <option selected>英语手机听读 + 五科知识卡打印</option>
              <option>系统判断</option>
              <option>8格五科路径：语文1、历史2、生物1、地理2、道法2</option>
              <option>8格四科路径</option>
              <option>每天3张保温卡</option>
              <option>每天4-5张标准卡</option>
              <option>每天6张完整卡</option>
              <option>只要手机端，不打印</option>
            </select>
          </div>
          <div>
            <label for="material_status">资料证据</label>
            <select id="material_status" name="material_status">
              <option selected>暂时没有资料，先做版本假设版</option>
              <option>有老师复习范围</option>
              <option>有课本目录/单元范围</option>
              <option>有试卷/错题照片</option>
              <option>有已做卡片反馈</option>
            </select>
          </div>
          <div>
            <label for="difficulties">最大困难</label>
            <textarea id="difficulties" name="difficulties" placeholder="如：记不住、一问就慌、启动困难"></textarea>
          </div>
          <div>
            <label for="parent_support">家长能做什么</label>
            <textarea id="parent_support" name="parent_support" placeholder="如：每天微信问3张，拍照反馈"></textarea>
          </div>
          <div>
            <label for="extra_notes">补充情况</label>
            <textarea id="extra_notes" name="extra_notes" placeholder="如：明后天研学，时间很碎"></textarea>
          </div>
          <div>
            <label for="intakeFiles">上传资料</label>
            <input id="intakeFiles" type="file" multiple accept="image/*,.pdf,.doc,.docx,.xls,.xlsx">
          </div>
        </div>
        <div class="actions">
          <button class="primary" type="submit">提交建档</button>
          <button class="secondary" type="button" id="fillSample">查看建档样例</button>
        </div>
      </form>
      <div class="result" id="intakeResult"></div>
    </section>

    <section id="plan" class="portal-section">
      <div class="head">
        <h2>第2步：初步规划确认</h2>
        <p class="hint">先看学习方向、每天卡量和家长执行方式。系统会按“小步重复 + 线索记忆”安排，家长确认后再进入知识卡片。</p>
      </div>
      <div class="section-guide" aria-label="规划确认说明">
        <div class="guide-card"><strong>先看方向</strong><span>重点看科目优先级、每天卡量、是否适合孩子当前状态。</span></div>
        <div class="guide-card"><strong>再提修改</strong><span>研学、疲劳、抗拒、老师范围变化，都可以写进调整建议。</span></div>
        <div class="guide-card"><strong>确认再消耗</strong><span>重复生成会消耗 AI 额度；方向没问题再进入卡片生成。</span></div>
      </div>
      <div class="content">
        <div class="grid">
          <div>
            <label for="plan_student_id">选择学生</label>
            <select id="plan_student_id"></select>
          </div>
          <div>
            <label>当前动作</label>
            <div class="notice">先查看已有初步规划；重复生成会消耗1次AI额度。</div>
          </div>
          <div class="span2">
            <label for="plan_note">家长调整建议/档案补充</label>
            <textarea id="plan_note" placeholder="如：古诗优先；孩子英语抗拒，先不要拼写；明后两天只有微信时间。"></textarea>
          </div>
        </div>
        <div class="actions">
          <button class="primary" type="button" id="loadPlan">查看初步规划</button>
          <button class="secondary" type="button" id="regeneratePlan">按调整建议重新生成规划</button>
          <button class="secondary" type="button" id="planToCards">规划没问题，去生成卡片</button>
        </div>
      </div>
      <div class="result" id="planResult"></div>
    </section>

    <section id="cards" class="portal-section">
      <div class="head">
        <h2>第3步：生成阶段知识卡片</h2>
        <p class="hint">确认初步规划后，再生成可打印知识卡DOCX。当前母版按 A4 每日一页、8格、常考样题 + 采分词 + 答题方法排版。</p>
      </div>
      <div class="section-guide" aria-label="知识卡说明">
        <div class="guide-card"><strong>给孩子执行</strong><span>知识卡按天拆小步，适合打印、手机查看或家长微信抽问。</span></div>
        <div class="guide-card"><strong>给家长监督</strong><span>家长只需要看当天几张、会了几张、哪些卡需要回炉。</span></div>
        <div class="guide-card"><strong>给后续调整</strong><span>卡片完成情况会进入每日反馈，决定减量、加固或换版本。</span></div>
      </div>
      <div class="content">
        <div class="grid">
          <div>
            <label for="cards_student_id">选择学生</label>
            <select id="cards_student_id"></select>
          </div>
          <div>
            <label>生成说明</label>
            <div class="notice">卡片会按“题 + 答 + 法”生成常见考试题样例；若写明“语文2格、历史2格”等，会严格按格数分配。</div>
          </div>
          <div class="span2">
            <label for="cards_note">卡片调整要求</label>
            <textarea id="cards_note" placeholder="如：语文2格、历史2格、地理2格、生物1格、道法1格；语文加强阅读理解和文言翻译；不要重复已背过的考点。规划没问题可留空。"></textarea>
          </div>
        </div>
        <div class="actions">
          <button class="primary" type="button" id="loadCards">查看当前卡片文件</button>
          <button class="secondary" type="button" id="generateCards">生成知识卡DOCX</button>
        </div>
      </div>
      <div class="result" id="cardsResult"></div>
    </section>

    <section id="voice" class="portal-section">
      <div class="head">
        <h2>第4步：英语语音练习</h2>
        <p class="hint">先听标准音，再让孩子跟读。系统会记录识别结果和★语音卡，明天优先回炉。</p>
      </div>
      <div class="section-guide" aria-label="语音练习说明">
        <div class="guide-card"><strong>先开口</strong><span>不追求一次完美，先让孩子愿意读完整个词句。</span></div>
        <div class="guide-card"><strong>少量重复</strong><span>每天只练少量词句，错词第二天优先回炉，不额外压任务。</span></div>
        <div class="guide-card"><strong>家长可旁听</strong><span>家长端可先测试流程，学生端再做当天正式练习。</span></div>
      </div>
      <div class="content">
        <div class="grid">
          <div>
            <label for="voice_student_id">选择学生</label>
            <select id="voice_student_id"></select>
          </div>
          <div>
            <label>练习方式</label>
            <div class="notice">每天5个词句：听一遍、按住说一遍，系统会边识别边提示缺了哪些词。当前先做文本级纠正，后续可接音素级发音评测。</div>
          </div>
        </div>
        <div class="actions">
          <button class="primary" type="button" id="loadVoicePractice">开始今天语音练习</button>
        </div>
      </div>
      <div class="result" id="voiceResult"></div>
    </section>

    <section id="feedback" class="portal-section">
      <div class="head">
        <h2>第5步：每日反馈</h2>
        <p class="hint">有了卡片后再做反馈。每天只填完成、会了、★卡和情绪，用来决定是否减量、回炉或进入周调整。</p>
      </div>
      <div class="section-guide" aria-label="每日反馈说明">
        <div class="guide-card"><strong>一分钟填完</strong><span>只记录完成数、会了几张、情绪和★卡，尽量不增加家长负担。</span></div>
        <div class="guide-card"><strong>反馈决定节奏</strong><span>疲劳、抗拒、研学会触发减量或保温，不硬推新任务。</span></div>
        <div class="guide-card"><strong>老师看到重点</strong><span>持续异常会进入调整队列，方便后续人工复核和周调整。</span></div>
      </div>
      <form id="feedbackForm">
        <div class="grid">
          <div>
            <label for="fb_student_id">选择学生</label>
            <select id="fb_student_id" name="student_id" required></select>
          </div>
          <div>
            <label for="feedback_date">反馈日期</label>
            <input id="feedback_date" name="feedback_date" type="date">
          </div>
          <div>
            <label for="day_mode">今天模式</label>
            <select id="day_mode" name="day_mode">
              <option>正常</option>
              <option>研学</option>
              <option>疲劳</option>
              <option>抗拒</option>
            </select>
          </div>
          <div>
            <label for="mood">情绪</label>
            <select id="mood" name="mood">
              <option>轻松</option>
              <option selected>能接受</option>
              <option>有点烦</option>
              <option>明显抗拒</option>
            </select>
          </div>
          <div>
            <label for="planned_cards">计划张数</label>
            <input id="planned_cards" name="planned_cards" type="number" min="0" value="3">
          </div>
          <div>
            <label for="completed_cards">完成张数</label>
            <input id="completed_cards" name="completed_cards" type="number" min="0" value="0">
          </div>
          <div>
            <label for="known_cards">会了几张</label>
            <input id="known_cards" name="known_cards" type="number" min="0" value="0">
          </div>
          <div>
            <label for="evidence_type">证据</label>
            <select id="evidence_type" name="evidence_type">
              <option>无</option>
              <option>照片</option>
              <option>语音</option>
              <option>视频</option>
            </select>
          </div>
          <div class="span2">
            <label for="star_card_codes">★卡编号</label>
            <input id="star_card_codes" name="star_card_codes" placeholder="如：D1-03、D2-01">
          </div>
          <div>
            <label for="parent_note">家长备注</label>
            <textarea id="parent_note" name="parent_note" placeholder="如：路上语音答了两张，第三张不太想答"></textarea>
          </div>
          <div>
            <label for="feedbackFiles">上传反馈照片</label>
            <input id="feedbackFiles" type="file" multiple accept="image/*,.pdf,.doc,.docx,.xls,.xlsx">
          </div>
        </div>
        <div class="actions">
          <button class="primary" type="submit">提交反馈</button>
          <button class="secondary" type="button" id="generateFeedbackAi">生成反馈分析</button>
        </div>
      </form>
      <div class="result" id="feedbackResult"></div>
    </section>
  </main>

  <script>
    const $ = (id) => document.getElementById(id);
    const prefix = location.pathname.startsWith("/xueji") ? "/xueji" : "";
    const initialReferralCode = new URLSearchParams(location.search).get("ref") || "";
    const aiTaskLabels = {
      initial_plan: "初步规划",
      card_generation: "阶段知识卡片",
      daily_feedback: "反馈分析",
      weekly_adjustment: "周调整方案",
      followup: "跟进建议"
    };
    let parentToken = localStorage.getItem("xueji_parent_token") || "";
    let currentParent = null;
    let myStudents = [];
    let pendingIntakeAfterAuth = false;
    let currentDetail = null;
    let voicePractice = null;
    let voiceAttempts = {};
    const AI_COOLDOWN_SECONDS = 60;
    const AI_TRIGGER_IDS = ["regeneratePlan", "generateCards", "generateFeedbackAi"];
    const aiTriggerState = {
      status: "idle",
      timer: null,
      activeButtonId: "",
      cooldownResultId: "",
      cooldownMessage: "",
      cooldownUntil: 0
    };

    const api = async (path, options = {}) => {
      const headers = { "Content-Type": "application/json", ...(options.headers || {}) };
      if (parentToken) headers.Authorization = `Bearer ${parentToken}`;
      const response = await fetch(prefix + path, { ...options, headers });
      const data = await response.json();
      if (!response.ok) {
        const error = new Error(data.error || data.detail || "提交失败");
        error.status = response.status;
        error.payload = data;
        throw error;
      }
      return data;
    };

    const publicApi = async (path, options = {}) => {
      const response = await fetch(prefix + path, {
        ...options,
        headers: { "Content-Type": "application/json", ...(options.headers || {}) }
      });
      const data = await response.json();
      if (!response.ok) {
        const error = new Error(data.error || data.detail || "提交失败");
        error.status = response.status;
        error.payload = data;
        throw error;
      }
      return data;
    };

    const formJson = (form) => Object.fromEntries(new FormData(form).entries());
    const mainlandMobilePattern = /^1[3-9]\d{9}$/;
    const weakPasswords = new Set(["12345678", "123456789", "1234567890", "password1", "password123", "abc12345", "abcdefg1", "qwerty123"]);

    function normalizePhoneInput(value) {
      let phone = String(value || "").trim().replace(/[\s\-()（）]/g, "");
      if (phone.startsWith("+86")) phone = phone.slice(3);
      if (phone.startsWith("0086")) phone = phone.slice(4);
      if (phone.startsWith("86") && phone.length === 13 && phone[2] === "1") phone = phone.slice(2);
      return phone;
    }

    function validateMainlandPhone(value, label = "手机号") {
      const phone = normalizePhoneInput(value);
      if (!phone) throw new Error(`请输入${label}`);
      if (!mainlandMobilePattern.test(phone)) throw new Error(`请输入有效的中国大陆11位${label}`);
      return phone;
    }

    function validatePassword(value, phone = "", label = "密码") {
      const password = String(value || "").trim();
      if (!password) throw new Error(`请输入${label}`);
      if (password.length < 8) throw new Error(`${label}至少8位`);
      if (password.length > 64) throw new Error(`${label}不能超过64位`);
      if (/\s/.test(password)) throw new Error(`${label}不能包含空格`);
      if (!/[A-Za-z]/.test(password) || !/\d/.test(password)) throw new Error(`${label}需同时包含字母和数字`);
      if (new Set(password.toLowerCase()).size <= 2 || weakPasswords.has(password.toLowerCase())) throw new Error(`${label}过于简单，请换一个`);
      if (phone && password === phone) throw new Error(`${label}不能和手机号相同`);
      return password;
    }

    function validateOptionalStudentLogin(payload) {
      const rawPhone = payload.student_phone || payload.student_login_phone || "";
      const rawPassword = payload.student_password || payload.student_login_password || "";
      if (!rawPhone && !rawPassword) return;
      const phone = validateMainlandPhone(rawPhone, "学生手机号");
      const password = validatePassword(rawPassword, phone, "学生初始密码");
      payload.student_phone = phone;
      payload.student_password = password;
    }

    function goStudentPortal(token) {
      if (token) localStorage.setItem("xueji_student_token", token);
      location.href = token ? `${prefix}/student?token=${encodeURIComponent(token)}` : `${prefix}/student`;
    }

    function escapeHtml(value) {
      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function formatInline(text) {
      return escapeHtml(text)
        .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
        .replace(/`([^`]+)`/g, "<code>$1</code>")
        .replace(/(https?:\/\/[^\s<]+)/g, `<a href="$1" target="_blank" rel="noopener">$1</a>`);
    }

    function formatRichText(text) {
      const lines = String(text || "").replace(/\r\n/g, "\n").split("\n");
      let html = "";
      let list = "";
      const closeList = () => {
        if (list) {
          html += `</${list}>`;
          list = "";
        }
      };
      for (const rawLine of lines) {
        const line = rawLine.trim();
        if (!line) {
          closeList();
          continue;
        }
        const heading = line.match(/^#{1,4}\s+(.+)$/);
        if (heading) {
          closeList();
          html += `<h4>${formatInline(heading[1])}</h4>`;
          continue;
        }
        const numbered = line.match(/^\d+[\.、]\s+(.+)$/);
        if (numbered) {
          if (list !== "ol") {
            closeList();
            html += "<ol>";
            list = "ol";
          }
          html += `<li>${formatInline(numbered[1])}</li>`;
          continue;
        }
        const bullet = line.match(/^[-*]\s+(.+)$/);
        if (bullet) {
          if (list !== "ul") {
            closeList();
            html += "<ul>";
            list = "ul";
          }
          html += `<li>${formatInline(bullet[1])}</li>`;
          continue;
        }
        closeList();
        const keyValue = line.match(/^([^：:]{2,14})[：:]\s*(.+)$/);
        if (keyValue) {
          html += `<p><strong>${formatInline(keyValue[1])}：</strong>${formatInline(keyValue[2])}</p>`;
        } else {
          html += `<p>${formatInline(line)}</p>`;
        }
      }
      closeList();
      return html || "<p>暂无内容。</p>";
    }

    function setAppMode(loggedIn) {
      document.body.classList.toggle("logged-out", !loggedIn);
      document.body.classList.toggle("logged-in", !!loggedIn);
    }

    function setAuthView(view) {
      const isRegister = view === "register";
      document.body.classList.toggle("auth-register", isRegister);
      document.body.classList.toggle("auth-login", !isRegister);
      setTimeout(() => {
        const target = isRegister ? $("reg_phone") : $("login_phone");
        if (target && !target.value) target.focus();
      }, 50);
    }

    function activate(view) {
      if (!currentParent && view !== "account") view = "account";
      document.querySelectorAll(".tabs button").forEach(btn => btn.classList.toggle("active", btn.dataset.view === view));
      document.querySelectorAll("section").forEach(section => section.classList.toggle("active", section.id === view));
      renderFlowGuide(view);
    }

    function showResult(id, html) {
      const box = $(id);
      box.innerHTML = html;
      box.classList.add("show");
    }

    function aiButtons() {
      return AI_TRIGGER_IDS.map(id => $(id)).filter(Boolean);
    }

    function rememberAiButtonText(button) {
      if (button && !button.dataset.defaultText) {
        button.dataset.defaultText = button.textContent;
      }
    }

    function restoreAiButtons() {
      aiButtons().forEach(button => {
        rememberAiButtonText(button);
        button.disabled = false;
        button.textContent = button.dataset.defaultText;
      });
      aiTriggerState.status = "idle";
      aiTriggerState.activeButtonId = "";
      aiTriggerState.cooldownResultId = "";
      aiTriggerState.cooldownMessage = "";
      aiTriggerState.cooldownUntil = 0;
    }

    function setAiRequestState(button, label) {
      aiTriggerState.status = "requesting";
      aiTriggerState.activeButtonId = button ? button.id : "";
      aiButtons().forEach(item => {
        rememberAiButtonText(item);
        item.disabled = true;
        item.textContent = item === button ? label : "有AI任务进行中";
      });
    }

    function updateAiRequestLabel(button, label) {
      if (aiTriggerState.status === "requesting" && button) {
        button.textContent = label;
      }
    }

    function aiCooldownSeconds(error) {
      const payloadSeconds = Number(error && error.payload && (error.payload.retry_after || error.payload.retry_after_seconds));
      if (Number.isFinite(payloadSeconds) && payloadSeconds > 0) return payloadSeconds;
      const message = String((error && error.message) || "");
      const match = message.match(/(\d+)\s*(?:秒|s|S)/);
      if (match) return Number(match[1]);
      if (/频繁|rate|limit|too many/i.test(message)) return AI_COOLDOWN_SECONDS;
      return 0;
    }

    function renderAiCooldown() {
      const left = Math.max(0, Math.ceil((aiTriggerState.cooldownUntil - Date.now()) / 1000));
      if (left <= 0) {
        if (aiTriggerState.timer) clearInterval(aiTriggerState.timer);
        aiTriggerState.timer = null;
        restoreAiButtons();
        return;
      }
      aiButtons().forEach(button => {
        rememberAiButtonText(button);
        button.disabled = true;
        button.textContent = `冷却中 ${left}s`;
      });
      if (aiTriggerState.cooldownResultId) {
        showResult(aiTriggerState.cooldownResultId, `
          <p class="err">${escapeHtml(aiTriggerState.cooldownMessage)}</p>
          <p class="warn">AI按钮冷却中，${left}秒后自动恢复。</p>
        `);
      }
    }

    function startAiCooldown(seconds, message, resultId) {
      if (aiTriggerState.timer) clearInterval(aiTriggerState.timer);
      aiTriggerState.status = "cooldown";
      aiTriggerState.cooldownResultId = resultId || "";
      aiTriggerState.cooldownMessage = message || "请稍后再试";
      aiTriggerState.cooldownUntil = Date.now() + Math.max(1, Math.ceil(seconds)) * 1000;
      renderAiCooldown();
      aiTriggerState.timer = setInterval(renderAiCooldown, 1000);
    }

    function showAiError(resultId, error) {
      if (error && error.aiCooldownHandled) return;
      showResult(resultId, `<p class="err">${escapeHtml((error && error.message) || error)}</p>`);
    }

    function kv(items) {
      return `<div class="kv">${items.map(([k, v]) => `<div>${escapeHtml(k)}</div><div>${escapeHtml(v || "")}</div>`).join("")}</div>`;
    }

    function ensureLogin() {
      if (!parentToken || !currentParent) {
        activate("account");
        throw new Error("请先登录家长帐号");
      }
    }

    function getIntakeDraft() {
      try {
        return JSON.parse(localStorage.getItem("xueji_pending_intake") || "{}");
      } catch {
        return {};
      }
    }

    function saveIntakeDraft() {
      const draft = formJson($("intakeForm"));
      localStorage.setItem("xueji_pending_intake", JSON.stringify(draft));
      return draft;
    }

    function restoreIntakeDraft() {
      const draft = getIntakeDraft();
      Object.entries(draft).forEach(([key, value]) => {
        const field = document.querySelector(`[name="${key}"]`);
        if (field && value !== undefined && value !== null) field.value = value;
      });
      return draft;
    }

    function fillAuthFromDraft(draft = getIntakeDraft()) {
      if (draft.parent_phone) {
        $("login_phone").value = draft.parent_phone;
        $("reg_phone").value = draft.parent_phone;
      }
      if (draft.parent_nickname) {
        $("reg_nickname").value = draft.parent_nickname;
      }
      if (draft.student_phone) {
        $("reg_student_phone").value = draft.student_phone;
      }
      if (draft.student_password) {
        $("reg_student_password").value = draft.student_password;
      }
    }

    function syncStudentLoginToIntake() {
      const phone = $("reg_student_phone").value.trim();
      const password = $("reg_student_password").value;
      if (phone && !$("student_phone").value.trim()) $("student_phone").value = phone;
      if (password && !$("student_password").value) $("student_password").value = password;
    }

    function promptAuthForIntake() {
      const draft = saveIntakeDraft();
      fillAuthFromDraft(draft);
      pendingIntakeAfterAuth = true;
      showResult("intakeResult", `<p class="warn">资料已保留。请先登录或注册家长帐号，完成后会自动保存学生档案。</p>`);
      showResult("accountResult", `<p class="warn">请登录或注册。手机号和称呼已带入，刚才填写的学生资料会自动保存。</p>`);
      activate("account");
      setAuthView("login");
      setTimeout(() => {
        const target = $("login_phone").value ? $("login_password") : $("login_phone");
        target.focus();
      }, 60);
    }

    function rememberStudent(id) {
      localStorage.setItem("xueji_student_id", id);
      ["fb_student_id", "plan_student_id", "cards_student_id", "voice_student_id"].forEach(selectId => {
        if ($(selectId)) $(selectId).value = id;
      });
    }

    function setToken(token) {
      parentToken = token || "";
      if (parentToken) localStorage.setItem("xueji_parent_token", parentToken);
      else localStorage.removeItem("xueji_parent_token");
    }

    function renderStudents() {
      const box = $("myStudents");
      if (!myStudents.length) {
        box.innerHTML = `<div class="student-card"><strong>暂无学生档案</strong><p class="hint">登录后可以在“建档”里创建第一个学生。</p></div>`;
      } else {
        box.innerHTML = myStudents.map(item => `
          <div class="student-card">
            <strong>${escapeHtml(item.display_name || "学生")}｜${escapeHtml(item.student_code)}</strong>
            <p>${escapeHtml(item.grade_region || "")}｜${escapeHtml(item.goal || "")}</p>
            <p>${escapeHtml(item.current_level || "")}｜${escapeHtml(item.execution_mode || "")}</p>
            <p>${item.student_account_phone ? `学生端：${escapeHtml(item.student_account_phone)}` : "学生端：未绑定手机号"}</p>
            <div class="actions">
              <button class="secondary" type="button" onclick="chooseStudent(${item.id}, 'plan')">规划</button>
              <button class="secondary" type="button" onclick="chooseStudent(${item.id}, 'cards')">卡片</button>
              <button class="secondary" type="button" onclick="chooseStudent(${item.id}, 'voice')">语音</button>
              <button class="secondary" type="button" onclick="shareStudentPortal(${item.id})">分享学生端</button>
              <button class="secondary" type="button" onclick="chooseStudent(${item.id}, 'feedback')">反馈</button>
            </div>
          </div>
        `).join("");
      }

      const options = myStudents.length
        ? myStudents.map(item => `<option value="${item.id}">${escapeHtml(item.display_name || "学生")}｜${escapeHtml(item.student_code)}</option>`).join("")
        : `<option value="">暂无学生，请先建档</option>`;
      $("fb_student_id").innerHTML = options;
      $("plan_student_id").innerHTML = options;
      $("cards_student_id").innerHTML = options;
      $("voice_student_id").innerHTML = options;

      const savedId = localStorage.getItem("xueji_student_id") || (myStudents[0] && String(myStudents[0].id));
      if (savedId && myStudents.some(item => String(item.id) === String(savedId))) {
        rememberStudent(savedId);
      }
      renderFlowGuide(document.querySelector("section.active")?.id || "intake");
    }

    window.chooseStudent = (id, view) => {
      rememberStudent(id);
      activate(view);
      if (view === "plan") loadPlanForStudent(id);
      if (view === "cards") loadCardsForStudent(id);
      if (view === "voice") loadVoicePracticeForStudent(id);
    };

    window.goCards = (id) => {
      rememberStudent(id);
      activate("cards");
      loadCardsForStudent(id);
    };

    function isWeChatBrowser() {
      return /MicroMessenger/i.test(navigator.userAgent || "");
    }

    async function copyText(value) {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(value);
        return true;
      }
      const input = document.createElement("textarea");
      input.value = value;
      input.setAttribute("readonly", "readonly");
      input.style.position = "fixed";
      input.style.left = "-9999px";
      document.body.appendChild(input);
      input.select();
      const ok = document.execCommand("copy");
      document.body.removeChild(input);
      return ok;
    }

    function referralStatusLabel(status) {
      return {
        pending: "待建档",
        qualified: "已合格，待发放",
        granted: "已发放",
        rejected: "已作废"
      }[status] || status || "未知";
    }

    function renderReferralPanel(data) {
      const box = $("referralPanel");
      if (!box || !currentParent) return;
      const inviteUrl = `${location.origin}${data.invite_path || currentParent.referral_invite_path || ""}`;
      const stats = data.stats || {};
      const reward = data.reward || {};
      const items = data.items || [];
      box.innerHTML = `
        <h3>邀请家长得AI额度</h3>
        <div class="notice good">
          邀请的新家长完成第一个学生建档后，你获得 ${Number(reward.inviter || 0)} 次AI额度，对方获得 ${Number(reward.invitee || 0)} 次AI额度。
          为了防刷，每天最多自动奖励 ${Number(reward.daily_limit || 0)} 位有效邀请。
        </div>
        ${kv([
          ["邀请码", data.referral_code || currentParent.referral_code || ""],
          ["已发放", `${Number(stats.granted || 0)} 位 / +${Number(stats.earned || 0)} 次AI`],
          ["待建档", `${Number(stats.pending || 0)} 位`],
          ["待处理", `${Number(stats.qualified || 0)} 位`]
        ])}
        <div class="invite-link-row">
          <input id="referralInviteLink" value="${escapeHtml(inviteUrl)}" readonly aria-label="邀请链接">
          <button class="secondary" type="button" onclick="copyReferralLink()">复制链接</button>
        </div>
        <div class="referral-list">
          ${items.length ? items.map(item => `
            <div class="referral-item">
              <strong>${escapeHtml(item.invitee_nickname || item.invitee_phone || "新家长")}</strong>
              <span class="pill">${escapeHtml(referralStatusLabel(item.status))}</span>
              <div class="hint">注册：${escapeHtml(item.created_at || "")}${item.reward_granted_at ? `；奖励：${escapeHtml(item.reward_granted_at)}` : ""}</div>
            </div>
          `).join("") : `<div class="referral-item">还没有邀请记录。复制链接发给其他家长，等对方建档后自动发放额度。</div>`}
        </div>
      `;
    }

    async function refreshReferrals() {
      const box = $("referralPanel");
      if (!box) return;
      if (!parentToken || !currentParent) {
        box.innerHTML = "";
        return;
      }
      try {
        const data = await api("/api/parents/me/referrals");
        renderReferralPanel(data);
      } catch (error) {
        box.innerHTML = `<div class="notice warnbox">邀请信息暂时读取失败：${escapeHtml(error.message || error)}</div>`;
      }
    }

    window.copyReferralLink = async () => {
      const input = $("referralInviteLink");
      if (!input) return;
      try {
        await copyText(input.value);
        showResult("accountResult", `<p class="ok">邀请链接已复制，可以发给其他家长。</p>`);
      } catch {
        showResult("accountResult", `<p class="warn">复制失败，请手动长按/选择链接复制。</p>`);
      }
    };

    function studentShareHtml(url, shared, copied) {
      const wechatTip = isWeChatBrowser()
        ? "当前在微信里：点右上角“...”选择“发送给朋友”，孩子打开后就是学生端。"
        : "如果系统分享没有弹出，可以复制链接后发到孩子微信。";
      return `
        <h3>学生端链接</h3>
        <div class="notice good">${shared ? "已调起分享面板。" : copied ? "链接已复制。" : "链接已生成。"}</div>
        <div class="rich">
          <p>${escapeHtml(wechatTip)}</p>
          <p><a href="${escapeHtml(url)}" target="_blank" rel="noopener">${escapeHtml(url)}</a></p>
        </div>
        <div class="actions">
          <button class="primary" type="button" onclick="window.open('${escapeHtml(url)}', '_blank', 'noopener')">打开学生端</button>
          <button class="secondary" type="button" onclick="copyText('${escapeHtml(url)}')">复制链接</button>
        </div>
      `;
    }

    window.shareStudentPortal = async (id) => {
      try {
        ensureLogin();
        const result = await api(`/api/students/${id}/student-link`, { method: "POST", body: "{}" });
        const url = `${location.origin}${result.path}`;
        const title = "学记教育学生端";
        const text = "今天的英语跟读、知识卡和记忆故事在这里。";
        if (navigator.share) {
          try {
            await navigator.share({ title, text, url });
            showResult("accountResult", studentShareHtml(url, true, false));
            activate("account");
            return;
          } catch {}
        }
        let copied = false;
        try {
          copied = await copyText(url);
        } catch {}
        showResult("accountResult", studentShareHtml(url, false, copied));
        activate("account");
      } catch (error) {
        showResult("accountResult", `<p class="err">${escapeHtml(error.message || error)}</p>`);
        activate("account");
      }
    };

    function renderFlowGuide(activeView = "intake") {
      if (!currentParent) {
        $("flowGuide").innerHTML = "";
        return;
      }
      const savedId = localStorage.getItem("xueji_student_id");
      const hasStudent = myStudents.length > 0;
      const detailMatches = currentDetail && (!savedId || String(currentDetail.student?.id) === String(savedId));
      const hasPlan = hasStudent && (detailMatches ? !!currentDetail.current_plan : true);
      const hasCards = detailMatches && currentDetail.current_plan && !!currentDetail.current_plan.file_url;
      const steps = [
        ["1", "建档", hasStudent ? "已保存学生资料" : "先填学生基础情况", "intake", hasStudent ? "done" : "current"],
        ["2", "初步规划", hasStudent ? "确认卡量、重复节奏和记忆线索" : "建档后自动生成", "plan", !hasStudent ? "locked" : activeView === "plan" ? "current" : hasPlan ? "done" : ""],
        ["3", "知识卡片", hasCards ? "DOCX已生成" : "确认规划后生成可打印卡", "cards", !hasStudent ? "locked" : activeView === "cards" ? "current" : hasCards ? "done" : ""],
        ["4", "语音练习", hasStudent ? "听标准音并跟读" : "建档后开始", "voice", !hasStudent ? "locked" : activeView === "voice" ? "current" : ""],
        ["5", "每日反馈", hasCards ? "每天记录完成和★卡" : "有卡片后再开始", "feedback", !hasStudent ? "locked" : activeView === "feedback" ? "current" : ""]
      ];
      $("flowGuide").innerHTML = steps.map(([num, title, desc, view, state]) => `
        <div class="flow-step ${state}" onclick="activate('${view}')">
          <strong>${num}. ${title}</strong>
          <span>${desc}</span>
        </div>
      `).join("");
    }

    async function refreshMe() {
      if (!parentToken) {
        currentParent = null;
        myStudents = [];
        setAppMode(false);
        $("accountStatus").innerHTML = `<span class="warn">未登录</span>`;
        $("serviceState").textContent = "未登录";
        $("referralPanel").innerHTML = "";
        activate("account");
        renderStudents();
        return;
      }
      try {
        const result = await api("/api/parents/me");
        currentParent = result.parent;
        myStudents = result.students || [];
        $("accountStatus").innerHTML = `
          <div class="ok">已登录</div>
          ${kv([
            ["家长", currentParent.nickname || "家长"],
            ["手机号", currentParent.phone || ""],
            ["套餐", currentParent.plan_name || "trial"],
            ["有效期", currentParent.service_expires_at || "未设置"],
            ["AI额度", currentParent.usage_limit == null ? "不限" : `${currentParent.usage_used || 0}/${currentParent.usage_limit}`],
            ["学生数", myStudents.length],
            ["试用权益", currentParent.is_trial ? "1个学生 + V1试运行 + 1次V2调整报告" : "正式会员权益"]
          ])}
          ${currentParent.is_trial ? `<div class="notice">${currentParent.trial_note}</div>` : ""}
        `;
        $("serviceState").textContent = "已登录";
        setAppMode(true);
        renderStudents();
        await refreshReferrals();
        const activeView = document.querySelector("section.active")?.id || "";
        if (activeView === "account" || !activeView) {
          activate(myStudents.length ? "account" : "intake");
        }
      } catch (error) {
        setToken("");
        currentParent = null;
        myStudents = [];
        setAppMode(false);
        $("accountStatus").innerHTML = `<span class="err">${error.message || error}</span>`;
        $("serviceState").textContent = "未登录";
        $("referralPanel").innerHTML = "";
        activate("account");
        renderStudents();
      }
    }

    async function loadStudentDetail(studentId) {
      const detail = await api(`/api/students/${studentId}`);
      currentDetail = detail;
      renderFlowGuide(document.querySelector("section.active")?.id || "plan");
      return detail;
    }

    function quotaText() {
      if (!currentParent) return "当前AI额度：登录后可查看。";
      return currentParent.usage_limit == null
        ? "当前AI额度：不限。"
        : `当前AI额度：已用 ${currentParent.usage_used || 0} / ${currentParent.usage_limit}。`;
    }

    function confirmAiGeneration(taskType, detail) {
      const label = aiTaskLabels[taskType] || "AI内容";
      const plan = detail?.current_plan || {};
      let reason = `将生成“${label}”，会消耗1次AI额度。`;
      if (taskType === "initial_plan" && plan.plan_summary) {
        reason = "已经有一份初步规划。如果学生档案没有变化，重新生成的内容可能接近。建议先在调整建议里写清楚要改什么；继续会消耗1次AI额度。";
      }
      if (taskType === "card_generation" && plan.file_url) {
        reason = "已经有一份知识卡片DOCX。重新生成会覆盖当前卡片文件，并消耗1次AI额度。";
      }
      if (taskType === "daily_feedback") {
        reason = "生成反馈分析会消耗1次AI额度。若今天反馈内容没有变化，结果可能接近；建议先补充完成张数、会了几张和★卡。";
      }
      return window.confirm(`${reason}\n\n${quotaText()}\n\n确认继续吗？`);
    }

    function readinessHtml(detail) {
      const readiness = detail.delivery_readiness || {};
      const missing = readiness.missing || [];
      const warnings = readiness.warnings || [];
      if (missing.length) {
        return `
          <div class="notice warnbox">
            生成知识卡片前还需要补充：${missing.map(escapeHtml).join("、")}。
            可以回到第1步修改档案，或在本页调整建议里补清楚后再生成。
          </div>
        `;
      }
      if (warnings.length) {
        return `<div class="notice warnbox">${warnings.map(escapeHtml).join("<br>")}</div>`;
      }
      return `<div class="notice good">生成信息已满足交付要求，可以进入知识卡片生成。</div>`;
    }

    function planHtml(detail) {
      const student = detail.student || {};
      const plan = detail.current_plan || {};
      return `
        <h3>${escapeHtml(student.display_name || "学生")}的初步规划</h3>
        <div>
          <span class="pill">${escapeHtml(plan.version_code || "V1_试运行")}</span>
          <span class="pill">${escapeHtml(plan.status === "published" ? "已生成卡片" : "待家长确认")}</span>
          <span class="pill">${escapeHtml(student.current_level || plan.level_name || "微型档")}</span>
        </div>
        ${kv([
          ["学生编号", student.student_code || ""],
          ["年级/地区", student.grade_region || ""],
          ["目标", student.goal || ""],
          ["建议卡量", plan.card_load || student.current_card_load || ""],
          ["执行方式", plan.execution_mode || student.execution_mode || ""]
        ])}
        <div class="notice">执行方法：先低门槛启动；同一考点用不同问法重复；看到“线索”先想画面或动作，再说关键词。</div>
        <div class="notice good">请先把这份初步规划发给家长确认。家长确认后，再进入第3步生成一周知识卡片DOCX。</div>
        ${readinessHtml(detail)}
        <h3>学习规划</h3>
        <div class="rich">${formatRichText(plan.plan_summary || "暂无规划内容，请先完成建档。")}</div>
        <h3>家长执行说明</h3>
        <div class="rich">${formatRichText(plan.parent_instruction || "每天只问关键词，不追问长答案；不会的卡标★，第二天回炉。")}</div>
        ${plan.upgrade_required ? `<div class="notice warnbox">${escapeHtml(plan.upgrade_message || "")}</div>` : ""}
        <div class="actions">
          <button class="primary" type="button" onclick="goCards(${Number(student.id || 0)})">规划没问题，去生成知识卡片</button>
        </div>
      `;
    }

    function cardsHtml(detail) {
      const student = detail.student || {};
      const plan = detail.current_plan || {};
      const hasFile = !!plan.file_url;
      return `
        <h3>${escapeHtml(student.display_name || "学生")}的阶段知识卡片</h3>
        ${kv([
          ["学生编号", student.student_code || ""],
          ["方案版本", plan.version_code || "V1_试运行"],
          ["文件状态", hasFile ? "已生成DOCX" : "未生成"],
          ["执行方式", plan.execution_mode || student.execution_mode || ""]
        ])}
        ${hasFile ? `
          <div class="notice good">这份DOCX可以直接发给家长打印或手机查看。</div>
          <a class="download" href="${escapeHtml(plan.file_url)}" target="_blank" rel="noopener">下载知识卡片DOCX</a>
        ` : `
          <div class="notice warnbox">还没有知识卡片文件。请先确认第2步初步规划，再生成DOCX。</div>
        `}
        <div class="notice">使用顺序：当天先做新卡，再问昨天★卡；不会时看10秒答案，5分钟后再答一次。</div>
        ${readinessHtml(detail)}
        <h3>当前说明</h3>
        <div class="rich">${formatRichText(plan.parent_instruction || "生成后每天一页，卡住标★，第二天优先回炉。")}</div>
      `;
    }

    function voicePracticeHtml(data) {
      const items = data.items || [];
      const history = data.history || [];
      const weak = data.weak_items || [];
      const quota = data.assessment?.quota || {};
      const quotaText = quota.limit
        ? `今日剩余 ${Number(quota.remaining || 0)}/${Number(quota.limit || 0)} 次；点专业评测才消耗`
        : "普通提交只记录练习；需要时再点专业评测";
      const support = "webkitSpeechRecognition" in window || "SpeechRecognition" in window;
      return `
        <h3>今天的英语开口练习</h3>
        ${kv([
          ["练习日期", data.practice_date || ""],
          ["模式", data.mode || "生活化英语跟读"],
          ["识别方式", support ? "浏览器语音识别 + 文本相似度" : "当前浏览器不支持自动识别，可手动输入孩子读出的内容"],
          ["专业评测", quotaText],
          ["TTS", data.tts?.server_available ? "服务器标准音优先" : "浏览器朗读兜底"]
        ])}
        <div class="notice">学生端已经支持像微信语音一样“按住说话”，并会边识别边提示缺词。家长端这里也可以先做测试：听标准音，再录一遍。</div>
        ${weak.length ? `<div class="notice warnbox">语音★卡：${weak.map(item => escapeHtml(item.target_text)).join("、")}。明天先读这些。</div>` : ""}
        <div class="voice-board">
          ${items.map((item, idx) => voiceItemHtml(item, idx)).join("")}
        </div>
        ${history.length ? `
          <h3>今天已提交</h3>
          <div class="rich">${history.map(item => `
            <p><strong>${escapeHtml(item.target_text)}</strong>：${escapeHtml(item.score)}分，${escapeHtml(item.feedback_text || item.status || "")}</p>
          `).join("")}</div>
        ` : ""}
      `;
    }

    function voiceItemHtml(item, idx) {
      const attempt = voiceAttempts[idx] || {};
      return `
        <div class="voice-item" id="voiceItem_${idx}">
          <div class="voice-target">
            <strong>${escapeHtml(item.target_text)}</strong>
            <span>${escapeHtml(item.target_meaning || "")}</span>
            <span>${escapeHtml(item.scenario || "")}</span>
          </div>
          <div class="actions">
            <button class="secondary" type="button" onclick="playVoiceTarget(${idx})">听标准音</button>
            <button class="primary" type="button" onclick="recordVoiceTarget(${idx})">跟读录音</button>
            <button class="secondary" type="button" onclick="submitVoiceTarget(${idx})">提交这句</button>
            <button class="secondary" type="button" onclick="submitVoiceTarget(${idx}, 'professional')">专业评测</button>
          </div>
          <label for="voiceTranscript_${idx}">识别到的内容</label>
          <input id="voiceTranscript_${idx}" value="${escapeHtml(attempt.transcript || "")}" placeholder="录音后自动填入；不支持识别时可手动输入">
          <div class="voice-result" id="voiceStatus_${idx}">${escapeHtml(attempt.message || "等待跟读。")}</div>
          <div class="meter"><span id="voiceMeter_${idx}" style="width:${Number(attempt.score || 0)}%"></span></div>
        </div>
      `;
    }

    async function loadVoicePracticeForStudent(studentId) {
      const data = await api(`/api/students/${studentId}/voice-practice/today`);
      voicePractice = data;
      voiceAttempts = {};
      showResult("voiceResult", voicePracticeHtml(data));
      return data;
    }

    let cachedBrowserVoice = null;

    function pickBrowserVoice() {
      if (!("speechSynthesis" in window)) return null;
      const voices = window.speechSynthesis.getVoices ? window.speechSynthesis.getVoices() : [];
      if (!voices.length) return null;
      if (cachedBrowserVoice && voices.includes(cachedBrowserVoice)) return cachedBrowserVoice;
      const preferredNames = ["Google US English", "Microsoft David", "Microsoft Mark", "Alex", "Samantha"];
      cachedBrowserVoice = voices.find(voice => preferredNames.some(name => voice.name === name))
        || voices.find(voice => (voice.lang || "").toLowerCase().startsWith("en"))
        || voices[0]
        || null;
      return cachedBrowserVoice;
    }

    function browserSpeak(text) {
      if (!("speechSynthesis" in window)) return;
      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = "en-US";
      utterance.rate = 0.82;
      utterance.pitch = 1;
      const voice = pickBrowserVoice();
      if (voice) utterance.voice = voice;
      window.speechSynthesis.speak(utterance);
    }

    window.playVoiceTarget = async (idx) => {
      const item = voicePractice?.items?.[idx];
      if (!item) return;
      const status = $(`voiceStatus_${idx}`);
      status.textContent = "正在播放标准音...";
      try {
        const result = await api(`/api/students/${voicePractice.student_id}/voice-practice/tts`, {
          method: "POST",
          body: JSON.stringify({ text: item.target_text })
        });
        if (result.audio_url) {
          new Audio(result.audio_url).play();
          status.textContent = "已播放服务器标准音。";
        } else {
          browserSpeak(item.target_text);
          status.textContent = result.message || "已使用浏览器朗读。";
        }
      } catch (error) {
        browserSpeak(item.target_text);
        status.textContent = "服务器标准音暂不可用，已使用浏览器朗读。";
      }
    };

    function blobToDataUrl(blob) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.onerror = reject;
        reader.readAsDataURL(blob);
      });
    }

    function localVoiceScore(target, transcript) {
      const clean = (value) => String(value || "").toLowerCase().replace(/[^a-z0-9'\s]/g, " ").replace(/\s+/g, " ").trim();
      const a = clean(target);
      const b = clean(transcript);
      if (!a || !b) return 0;
      const aw = a.split(" ");
      const bw = new Set(b.split(" "));
      const hit = aw.filter(word => bw.has(word)).length / Math.max(aw.length, 1);
      return Math.round(hit * 92);
    }

    window.recordVoiceTarget = async (idx) => {
      const item = voicePractice?.items?.[idx];
      if (!item) return;
      const status = $(`voiceStatus_${idx}`);
      const input = $(`voiceTranscript_${idx}`);
      status.textContent = "开始录音，请读这一句...";
      let transcript = "";
      let audioDataUrl = "";
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      let recognizer = null;
      if (SpeechRecognition) {
        recognizer = new SpeechRecognition();
        recognizer.lang = "en-US";
        recognizer.interimResults = false;
        recognizer.maxAlternatives = 1;
        recognizer.onresult = (event) => {
          transcript = event.results?.[0]?.[0]?.transcript || "";
          input.value = transcript;
        };
      }
      try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        const chunks = [];
        const recorder = new MediaRecorder(stream);
        recorder.ondataavailable = event => { if (event.data && event.data.size) chunks.push(event.data); };
        const stopped = new Promise(resolve => { recorder.onstop = resolve; });
        recorder.start();
        if (recognizer) {
          try { recognizer.start(); } catch {}
        }
        const recordWindow = Math.min(12000, Math.max(5000, 1800 + String(item.target_text || "").trim().split(/\s+/).filter(Boolean).length * 1200));
        await new Promise(resolve => setTimeout(resolve, recordWindow));
        recorder.stop();
        stream.getTracks().forEach(track => track.stop());
        if (recognizer) {
          try { recognizer.stop(); } catch {}
        }
        await stopped;
        if (chunks.length) {
          audioDataUrl = await blobToDataUrl(new Blob(chunks, { type: "audio/webm" }));
        }
        transcript = input.value || transcript;
        const score = localVoiceScore(item.target_text, transcript);
        voiceAttempts[idx] = { transcript, audioDataUrl, score, message: transcript ? `识别：${transcript}，初步${score}分。` : "没有识别到内容，可以手动输入后提交。" };
        input.value = transcript;
        $(`voiceMeter_${idx}`).style.width = `${score}%`;
        status.textContent = voiceAttempts[idx].message;
      } catch (error) {
        status.textContent = "无法打开麦克风。请检查浏览器权限，或手动输入孩子读出的内容后提交。";
      }
    };

    window.submitVoiceTarget = async (idx, mode = "local") => {
      const item = voicePractice?.items?.[idx];
      if (!item) return;
      const input = $(`voiceTranscript_${idx}`);
      const attempt = voiceAttempts[idx] || {};
      const status = $(`voiceStatus_${idx}`);
      const professional = mode === "professional";
      status.textContent = professional ? "正在提交专业评测..." : "正在记录本次练习...";
      try {
        const result = await api(`/api/students/${voicePractice.student_id}/voice-practice/submissions`, {
          method: "POST",
          body: JSON.stringify({
            ...item,
            practice_date: voicePractice.practice_date,
            transcript: input.value,
            score: attempt.score || localVoiceScore(item.target_text, input.value),
            assessment_mode: professional ? "professional" : "local",
            audio_data_url: professional ? attempt.audioDataUrl || "" : ""
          })
        });
        voiceAttempts[idx] = { ...attempt, transcript: result.transcript, score: result.score, message: result.feedback };
        input.value = result.transcript || input.value;
        $(`voiceMeter_${idx}`).style.width = `${Number(result.score || 0)}%`;
        status.textContent = `${result.score}分：${result.feedback}`;
      } catch (error) {
        status.textContent = error.message || "提交失败";
      }
    };

    async function loadPlanForStudent(studentId) {
      const detail = await loadStudentDetail(studentId);
      showResult("planResult", planHtml(detail));
      return detail;
    }

    async function loadCardsForStudent(studentId) {
      const detail = await loadStudentDetail(studentId);
      showResult("cardsResult", cardsHtml(detail));
      return detail;
    }

    async function runAiGeneration({ studentId, taskType, note, resultId, button, onSuccess }) {
      if (aiTriggerState.status !== "idle") return null;
      setAiRequestState(button, "提交中");
      try {
        const job = await api(`/api/students/${studentId}/ai-generate`, {
          method: "POST",
          body: JSON.stringify({
            task_type: taskType,
            note,
            confirm_regenerate: true
          })
        });
        showResult(resultId, `
          <h3>${escapeHtml(job.task_label || aiTaskLabels[taskType] || "AI生成")}</h3>
          <div class="notice">已提交生成任务，正在排队处理。</div>
        `);
        updateAiRequestLabel(button, "生成中");
        for (let i = 0; i < 45; i += 1) {
          await new Promise(resolve => setTimeout(resolve, 2000));
          const result = await api(`/api/ai-jobs/${job.job_id}`);
          if (result.status === "success") {
            currentParent = result.parent || currentParent;
            await refreshMe();
            const detail = await loadStudentDetail(studentId);
            if (onSuccess) {
              await onSuccess(result, detail);
            } else {
              showResult(resultId, `
                <h3>${escapeHtml(result.task_label || aiTaskLabels[taskType] || "AI生成")}</h3>
                ${kv([
                  ["任务状态", "已完成"],
                  ["AI额度", result.parent && result.parent.usage_limit == null ? "不限" : `${result.parent?.usage_used || currentParent?.usage_used || 0}/${result.parent?.usage_limit || currentParent?.usage_limit || ""}`]
                ])}
                <div class="rich">${formatRichText(result.content || "")}</div>
              `);
            }
            return result;
          }
          if (result.status === "error") {
            throw new Error(result.error || "AI生成失败");
          }
          showResult(resultId, `
            <h3>${escapeHtml(result.task_label || aiTaskLabels[taskType] || "AI生成")}</h3>
            <div class="notice">任务${result.status === "running" ? "生成中" : "排队中"}，请稍候。</div>
          `);
        }
        throw new Error("生成时间较长，请稍后重新查看");
      } catch (error) {
        const cooldownSeconds = aiCooldownSeconds(error);
        if (cooldownSeconds > 0) {
          error.aiCooldownHandled = true;
          startAiCooldown(cooldownSeconds, error.message, resultId);
        }
        throw error;
      } finally {
        if (aiTriggerState.status === "requesting") {
          restoreAiButtons();
        }
      }
    }

    function readFileAsDataUrl(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
    }

    async function uploadFiles(studentId, inputId, fileType, description) {
      const files = Array.from($(inputId).files || []);
      const saved = [];
      for (const file of files) {
        const dataUrl = await readFileAsDataUrl(file);
        const result = await api(`/api/students/${studentId}/evidence`, {
          method: "POST",
          body: JSON.stringify({
            file_name: file.name,
            file_type: fileType,
            description,
            data_url: dataUrl
          })
        });
        saved.push(result);
      }
      return saved;
    }

    document.querySelectorAll(".tabs button").forEach(btn => {
      btn.addEventListener("click", () => activate(btn.dataset.view));
    });

    $("showRegisterBtn").addEventListener("click", () => setAuthView("register"));
    $("showLoginBtn").addEventListener("click", () => setAuthView("login"));

    $("loadVoicePractice").addEventListener("click", async () => {
      try {
        ensureLogin();
        const studentId = Number($("voice_student_id").value || localStorage.getItem("xueji_student_id") || 0);
        if (!studentId) throw new Error("请先选择学生");
        rememberStudent(studentId);
        await loadVoicePracticeForStudent(studentId);
      } catch (error) {
        showResult("voiceResult", `<p class="err">${escapeHtml(error.message || error)}</p>`);
      }
    });

    $("loginForm").addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = event.submitter;
      button.disabled = true;
      button.textContent = "登录中";
      const credentials = formJson(event.currentTarget);
      try {
        const result = await publicApi("/api/parents/login", {
          method: "POST",
          body: JSON.stringify(credentials)
        });
        setToken(result.token);
        await refreshMe();
        if (pendingIntakeAfterAuth) {
          pendingIntakeAfterAuth = false;
          showResult("accountResult", `<p class="ok">登录成功，正在保存学生档案。</p>`);
          restoreIntakeDraft();
          activate("intake");
          $("intakeForm").requestSubmit();
        } else {
          showResult("accountResult", `<p class="ok">登录成功。</p>`);
          activate(myStudents.length ? "account" : "intake");
        }
      } catch (parentError) {
        try {
          const studentResult = await publicApi("/api/students/login", {
            method: "POST",
            body: JSON.stringify(credentials)
          });
          showResult("accountResult", `<p class="ok">已识别为学生账号，正在进入学生端。</p>`);
          goStudentPortal(studentResult.token);
        } catch {
          showResult("accountResult", `<p class="err">${parentError.message || parentError}</p>`);
        }
      } finally {
        button.disabled = false;
        button.textContent = "登录";
      }
    });

    $("registerForm").addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = event.submitter;
      button.disabled = true;
      button.textContent = "注册中";
      try {
        fillAuthFromDraft();
        const payload = formJson(event.currentTarget);
        payload.phone = validateMainlandPhone(payload.phone, "手机号");
        payload.password = validatePassword(payload.password, payload.phone, "密码");
        validateOptionalStudentLogin(payload);
        if (initialReferralCode) payload.ref = initialReferralCode;
        const result = await api("/api/parents/register", {
          method: "POST",
          body: JSON.stringify(payload)
        });
        setToken(result.token);
        await refreshMe();
        if (pendingIntakeAfterAuth) {
          pendingIntakeAfterAuth = false;
          showResult("accountResult", `<p class="ok">注册成功，正在保存学生档案。</p>`);
          restoreIntakeDraft();
          syncStudentLoginToIntake();
          activate("intake");
          $("intakeForm").requestSubmit();
        } else {
          syncStudentLoginToIntake();
          showResult("accountResult", `<p class="ok">注册成功，可以开始给学生建档。</p>`);
          activate("intake");
        }
      } catch (error) {
        showResult("accountResult", `<p class="err">${error.message || error}</p>`);
      } finally {
        button.disabled = false;
        button.textContent = "注册并登录";
      }
    });

    $("logoutBtn").addEventListener("click", async () => {
      try {
        if (parentToken) await api("/api/parents/logout", { method: "POST", body: "{}" });
      } catch {}
      setToken("");
      await refreshMe();
      setAuthView("login");
      activate("account");
    });

    $("fillSample").addEventListener("click", () => {
      const sample = {
        student_name: "小陈",
        grade_region: "初一/湖南",
        goal: "期末基础抢分",
        exam_date_text: "2周后",
        exam_scope: "七年级下册期末；英语手机听读；知识卡覆盖语文、历史、生物、地理、道法",
        time_budget: "15-25分钟",
        cooperation: "抗拒",
        priority_subjects: "语文、历史、生物、地理、道法；英语手机听读",
        card_layout: "英语手机听读 + 五科知识卡打印",
        material_status: "暂时没有资料，先做版本假设版",
        difficulties: "记不住，一问就慌，背了3天有一点印象但不稳",
        parent_support: "研学期间可以微信问3张，平时每天10分钟抽查",
        extra_notes: "明后天研学，时间碎片化"
      };
      Object.entries(sample).forEach(([key, value]) => { if ($(key)) $(key).value = value; });
    });

    $("intakeForm").addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = event.submitter || $("intakeForm").querySelector("button[type='submit']");
      button.disabled = true;
      button.textContent = "提交中";
      try {
        if (!parentToken || !currentParent) {
          promptAuthForIntake();
          return;
        }
        const payload = { source: "h5_parent", ...formJson(event.currentTarget) };
        validateOptionalStudentLogin(payload);
        const result = await api("/api/students/intake", {
          method: "POST",
          body: JSON.stringify(payload)
        });
        rememberStudent(result.student_id);
        const uploaded = await uploadFiles(result.student_id, "intakeFiles", "intake_evidence", "初始建档资料");
        await refreshMe();
        rememberStudent(result.student_id);
        localStorage.removeItem("xueji_pending_intake");
        showResult("intakeResult", `
          <h3>建档已提交</h3>
          ${kv([
            ["学生ID", result.student_id],
            ["学生编号", result.student_code],
            ["学生端账号", result.student_account?.phone ? `已绑定 ${result.student_account.phone}` : "未绑定，可稍后在后台补设"],
            ["初始档位", result.initial_level],
            ["建议卡量", result.card_load],
            ["执行方式", result.execution_mode],
            ["试运行", `${result.trial_days}天`],
            ["已上传", `${uploaded.length}个文件`],
            ["下一步", result.next_step]
          ])}
          <div class="notice">${escapeHtml(result.current_plan.parent_instruction)}</div>
        `);
        activate("plan");
        await loadPlanForStudent(result.student_id);
      } catch (error) {
        showResult("intakeResult", `<p class="err">${escapeHtml(error.message || error)}</p>`);
      } finally {
        button.disabled = false;
        button.textContent = "提交建档";
      }
    });

    $("feedbackForm").addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = event.submitter;
      button.disabled = true;
      button.textContent = "提交中";
      try {
        ensureLogin();
        const payload = formJson(event.currentTarget);
        const studentId = payload.student_id;
        if (!studentId) throw new Error("请先选择学生");
        delete payload.student_id;
        ["planned_cards", "completed_cards", "known_cards"].forEach(key => payload[key] = Number(payload[key] || 0));
        const result = await api(`/api/students/${studentId}/daily-feedback`, {
          method: "POST",
          body: JSON.stringify(payload)
        });
        rememberStudent(studentId);
        const uploaded = await uploadFiles(studentId, "feedbackFiles", "feedback_evidence", "每日反馈资料");
        showResult("feedbackResult", `
          <h3>反馈已提交</h3>
          ${kv([
            ["完成率", `${Math.round(result.completion_rate * 100)}%`],
            ["答对率", `${Math.round(result.known_rate * 100)}%`],
            ["已上传", `${uploaded.length}个文件`],
            ["下一步", result.next_plan_hint]
          ])}
          <div class="notice">${result.actions.map(item => `<p><span class="warn">${escapeHtml(item.trigger_reason)}</span>：${escapeHtml(item.action_text)}</p>`).join("")}</div>
        `);
      } catch (error) {
        showResult("feedbackResult", `<p class="err">${escapeHtml(error.message || error)}</p>`);
      } finally {
        button.disabled = false;
        button.textContent = "提交反馈";
      }
    });

    $("loadPlan").addEventListener("click", async () => {
      try {
        ensureLogin();
        const studentId = $("plan_student_id").value;
        if (!studentId) throw new Error("请先选择学生");
        rememberStudent(studentId);
        await loadPlanForStudent(studentId);
      } catch (error) {
        showResult("planResult", `<p class="err">${escapeHtml(error.message || error)}</p>`);
      }
    });

    $("regeneratePlan").addEventListener("click", async () => {
      const button = $("regeneratePlan");
      try {
        ensureLogin();
        const studentId = $("plan_student_id").value;
        if (!studentId) throw new Error("请先选择学生");
        rememberStudent(studentId);
        const detail = await loadStudentDetail(studentId);
        if (!confirmAiGeneration("initial_plan", detail)) return;
        await runAiGeneration({
          studentId,
          taskType: "initial_plan",
          note: $("plan_note").value,
          resultId: "planResult",
          button,
          onSuccess: async (_result, updatedDetail) => {
            showResult("planResult", planHtml(updatedDetail));
          }
        });
      } catch (error) {
        showAiError("planResult", error);
      }
    });

    $("planToCards").addEventListener("click", async () => {
      try {
        ensureLogin();
        const studentId = $("plan_student_id").value;
        if (!studentId) throw new Error("请先选择学生");
        rememberStudent(studentId);
        activate("cards");
        await loadCardsForStudent(studentId);
      } catch (error) {
        showResult("planResult", `<p class="err">${escapeHtml(error.message || error)}</p>`);
      }
    });

    $("loadCards").addEventListener("click", async () => {
      try {
        ensureLogin();
        const studentId = $("cards_student_id").value;
        if (!studentId) throw new Error("请先选择学生");
        rememberStudent(studentId);
        await loadCardsForStudent(studentId);
      } catch (error) {
        showResult("cardsResult", `<p class="err">${escapeHtml(error.message || error)}</p>`);
      }
    });

    $("generateCards").addEventListener("click", async () => {
      const button = $("generateCards");
      try {
        ensureLogin();
        const studentId = $("cards_student_id").value;
        if (!studentId) throw new Error("请先选择学生");
        rememberStudent(studentId);
        const detail = await loadStudentDetail(studentId);
        const missing = detail.delivery_readiness?.missing || [];
        if (missing.length && !$("cards_note").value.trim()) {
          throw new Error(`生成前请先补充：${missing.join("、")}。也可以在“卡片调整要求”里写清楚后再生成。`);
        }
        if (!confirmAiGeneration("card_generation", detail)) return;
        await runAiGeneration({
          studentId,
          taskType: "card_generation",
          note: $("cards_note").value,
          resultId: "cardsResult",
          button,
          onSuccess: async (_result, updatedDetail) => {
            showResult("cardsResult", cardsHtml(updatedDetail));
          }
        });
      } catch (error) {
        showAiError("cardsResult", error);
      }
    });

    $("generateFeedbackAi").addEventListener("click", async () => {
      const button = $("generateFeedbackAi");
      try {
        ensureLogin();
        const studentId = $("fb_student_id").value;
        if (!studentId) throw new Error("请先选择学生");
        rememberStudent(studentId);
        const detail = await loadStudentDetail(studentId);
        if (!confirmAiGeneration("daily_feedback", detail)) return;
        const note = [
          "请根据最新每日反馈生成家长能看懂、能照做的反馈分析。",
          $("parent_note").value ? `家长补充：${$("parent_note").value}` : "",
          $("star_card_codes").value ? `★卡：${$("star_card_codes").value}` : ""
        ].filter(Boolean).join("\n");
        await runAiGeneration({
          studentId,
          taskType: "daily_feedback",
          note,
          resultId: "feedbackResult",
          button,
          onSuccess: async (result) => {
            showResult("feedbackResult", `
              <h3>反馈分析已生成</h3>
              ${kv([
                ["任务状态", "已完成"],
                ["AI额度", result.parent?.usage_limit == null ? "不限" : `${result.parent?.usage_used}/${result.parent?.usage_limit}`]
              ])}
              <div class="rich">${formatRichText(result.content || "")}</div>
            `);
          }
        });
      } catch (error) {
        showAiError("feedbackResult", error);
      }
    });

    $("feedback_date").valueAsDate = new Date();
    restoreIntakeDraft();
    $("intakeForm").addEventListener("input", () => saveIntakeDraft());
    if (initialReferralCode && !parentToken) {
      setAuthView("register");
      showResult("accountResult", `<p class="ok">已带入邀请链接。注册并完成学生建档后，双方都会获得AI额度奖励。</p>`);
    }
    refreshMe();
    api("/health")
      .then(() => { if (!parentToken) $("serviceState").textContent = "可注册"; })
      .catch(() => $("serviceState").textContent = "连接异常");
  </script>
</body>
</html>
</html>
